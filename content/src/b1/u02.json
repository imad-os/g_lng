  "sentences": [
    {"id":"s01","text":{"en":"This is my mother.","fr":"C'est ma mère.","es":"Esta es mi madre.","ar":"هذه أمي.","de":"Das ist meine Mutter."},"tr":{"ar":"hādhihi ummī."},"uses":["mother"]},
    {"id":"s02","text":{"en":"My father and my brother.","fr":"Mon père et mon frère.","es":"Mi padre y mi hermano.","ar":"أبي وأخي.","de":"Mein Vater und mein Bruder."},"tr":{"ar":"abī wa-akhī."},"uses":["father","brother","and"]},
    {"id":"s03","text":{"en":"I have a sister.","fr":"J'ai une sœur.","es":"Tengo una hermana.","ar":"عندي أخت.","de":"Ich habe eine Schwester."},"tr":{"ar":"ʿindī ukht."},"uses":["brother","sister"]},
    {"id":"s04","text":{"en":"The house is big.","fr":"La maison est grande.","es":"La casa es grande.","ar":"البيت كبير.","de":"Das Haus ist groß."},"tr":{"ar":"al-bayt kabīr."},"uses":["house","big"]},
    {"id":"s05","text":{"en":"The house is small.","fr":"La maison est petite.","es":"La casa es pequeña.","ar":"البيت صغير.","de":"Das Haus ist klein."},"tr":{"ar":"al-bayt ṣaghīr."},"uses":["house","small"]},
    {"id":"s06","text":{"en":"Water, please.","fr":"De l'eau, s'il vous plaît.","es":"Agua, por favor.","ar":"ماء من فضلك.","de":"Wasser, bitte."},"tr":{"ar":"māʾ min faḍlik."},"uses":["water"]},
    {"id":"s07","text":{"en":"Bread and water.","fr":"Du pain et de l'eau.","es":"Pan y agua.","ar":"خبز وماء.","de":"Brot und Wasser.","zgh":"ⴰⵖⵔⵓⵎ ⴷ ⵡⴰⵎⴰⵏ."},"tr":{"ar":"khubz wa-māʾ.","zgh":"aghrum d waman."},"uses":["water","bread","and"]},
    {"id":"s08","text":{"en":"My family is big.","fr":"Ma famille est grande.","es":"Mi familia es grande.","ar":"عائلتي كبيرة.","de":"Meine Familie ist groß."},"tr":{"ar":"ʿāʾilatī kabīra."},"uses":["family","big"]},
    {"id":"s09","text":{"en":"Thank you, mom!","fr":"Merci, maman !","es":"¡Gracias, mamá!","ar":"شكرا يا أمي!","de":"Danke, Mama!","zgh":"ⵜⴰⵏⵎⵎⵉⵔⵜ ⴰ ⵢⵉⵎⵎⴰ!"},"tr":{"ar":"shukran yā ummī!","zgh":"tanmmirt a yimma!"},"uses":[]},
    {"id":"s10","text":{"en":"Hello, dad!","fr":"Bonjour, papa !","es":"¡Hola, papá!","ar":"مرحبا يا أبي!","de":"Hallo, Papa!","zgh":"ⴰⵣⵓⵍ ⴰ ⴱⴰⴱⴰ!"},"tr":{"ar":"marḥaban yā abī!","zgh":"azul a baba!"},"uses":[]},
