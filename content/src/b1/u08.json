  "sentences": [
    {"id":"s01","text":{"en":"Where is the school?","fr":"Où est l'école ?","es":"¿Dónde está la escuela?","ar":"أين المدرسة؟","de":"Wo ist die Schule?"},"tr":{"ar":"ayna al-madrasa?"},"uses":["school","where"]},
    {"id":"s02","text":{"en":"The school is here.","fr":"L'école est ici.","es":"La escuela está aquí.","ar":"المدرسة هنا.","de":"Die Schule ist hier."},"tr":{"ar":"al-madrasa hunā."},"uses":["school","here"]},
    {"id":"s03","text":{"en":"The shop is there.","fr":"Le magasin est là.","es":"La tienda está allí.","ar":"المحل هناك.","de":"Das Geschäft ist dort."},"tr":{"ar":"al-maḥall hunāk."},"uses":["shop","here","there"]},
    {"id":"s04","text":{"en":"The market is big.","fr":"Le marché est grand.","es":"El mercado es grande.","ar":"السوق كبير.","de":"Der Markt ist groß.","zgh":"ⴰⵙⵓⵇ ⵉⵎⵇⵇⵓⵔ"},"tr":{"ar":"as-sūq kabīr.","zgh":"asuq imqqur"},"uses":["market"]},
    {"id":"s05","text":{"en":"The city is big.","fr":"La ville est grande.","es":"La ciudad es grande.","ar":"المدينة كبيرة.","de":"Die Stadt ist groß.","zgh":"ⵜⴰⵎⴷⵉⵏⵜ ⵜⵎⵇⵇⵓⵔ"},"tr":{"ar":"al-madīna kabīra.","zgh":"tamdint tmqqur"},"uses":["city"]},
    {"id":"s06","text":{"en":"The street is small.","fr":"La rue est petite.","es":"La calle es pequeña.","ar":"الشارع صغير.","de":"Die Straße ist klein."},"tr":{"ar":"ash-shāriʿ ṣaghīr."},"uses":["street"]},
    {"id":"s07","text":{"en":"Where is the bank?","fr":"Où est la banque ?","es":"¿Dónde está el banco?","ar":"أين البنك؟","de":"Wo ist die Bank?"},"tr":{"ar":"ayna al-bank?"},"uses":["bank","where"]},
    {"id":"s08","text":{"en":"The bank is there.","fr":"La banque est là.","es":"El banco está allí.","ar":"البنك هناك.","de":"Die Bank ist dort."},"tr":{"ar":"al-bank hunāk."},"uses":["bank","here","there"]},
    {"id":"s09","text":{"en":"The hospital is here.","fr":"L'hôpital est ici.","es":"El hospital está aquí.","ar":"المستشفى هنا.","de":"Das Krankenhaus ist hier."},"tr":{"ar":"al-mustashfā hunā."},"uses":["hospital","here"]},
    {"id":"s10","text":{"en":"The station is there.","fr":"La gare est là.","es":"La estación está allí.","ar":"المحطة هناك.","de":"Der Bahnhof ist dort."},"tr":{"ar":"al-maḥaṭṭa hunāk."},"uses":["station","here","there"]},
    {"id":"s11","text":{"en":"The park is here.","fr":"Le parc est ici.","es":"El parque está aquí.","ar":"الحديقة هنا.","de":"Der Park ist hier."},"tr":{"ar":"al-ḥadīqa hunā."},"uses":["park","here"]},
    {"id":"s12","text":{"en":"Thank you, goodbye!","fr":"Merci, au revoir !","es":"Gracias, adiós.","ar":"شكرا، مع السلامة.","de":"Danke, tschüss!"},"tr":{"ar":"shukran, maʿa as-salāma."},"uses":[]}
  ],
  "dialogue": ["s01","s02","s12"]
