{
  "id": "u06", "level": "b1", "order": 6,
  "title": { "en": "Days and time of day", "fr": "Les jours et les moments de la journée", "es": "Días y momentos del día", "ar": "أيام الأسبوع وأوقات اليوم" },
  "tip": {
    "en": "Say 'Today is Monday' and 'Tomorrow is Tuesday'. The days come in the same order in every language.",
    "fr": "Dites « Aujourd'hui, c'est lundi » et « Demain, c'est mardi ». Les jours se suivent dans le même ordre dans toutes les langues.",
    "es": "Di «Hoy es lunes» y «Mañana es martes». Los días van en el mismo orden en todos los idiomas.",
    "ar": "قل «اليوم الاثنين» و«غدا الثلاثاء». تأتي الأيام بالترتيب نفسه في كل اللغات."
  },
  "words": [
    { "id": "today", "text": { "en": "today", "fr": "aujourd'hui", "es": "hoy", "ar": "اليوم", "de": "heute" }, "tr": { "ar": "al-yawm" } },
