  "sentences": [
    {"id":"s01","text":{"en":"Today is Monday.","fr":"Aujourd'hui, c'est lundi.","es":"Hoy es lunes.","ar":"اليوم الاثنين.","de":"Heute ist Montag.","zgh":"ⴰⵙⵙⴰ ⴷ ⴰⵢⵏⴰⵙ"},"tr":{"ar":"al-yawm al-ithnayn.","zgh":"assa d aynas"},"uses":["today","monday"]},
    {"id":"s02","text":{"en":"Tomorrow is Tuesday.","fr":"Demain, c'est mardi.","es":"Mañana es martes.","ar":"غدا الثلاثاء.","de":"Morgen ist Dienstag.","zgh":"ⴰⵙⴽⴽⴰ ⴷ ⴰⵙⵉⵏⴰⵙ"},"tr":{"ar":"ghadan ath-thulāthāʾ.","zgh":"askka d asinas"},"uses":["tomorrow","tuesday"]},
    {"id":"s03","text":{"en":"Saturday and Sunday.","fr":"Samedi et dimanche.","es":"Sábado y domingo.","ar":"السبت والأحد.","de":"Samstag und Sonntag.","zgh":"ⴰⵙⵉⴹⵢⴰⵙ ⴷ ⴰⵙⴰⵎⴰⵙ"},"tr":{"ar":"as-sabt wa-l-aḥad.","zgh":"asiḍyas d asamas"},"uses":["saturday","sunday"]},
    {"id":"s04","text":{"en":"Is today Thursday?","fr":"Est-ce que c'est jeudi aujourd'hui ?","es":"¿Hoy es jueves?","ar":"هل اليوم الخميس؟","de":"Ist heute Donnerstag?","zgh":"ⵉⵙ ⴷ ⴰⴽⵡⴰⵙ ⴰⵙⵙⴰ"},"tr":{"ar":"hal al-yawm al-khamīs?","zgh":"is d akwas assa"},"uses":["today","thursday"]},
    {"id":"s05","text":{"en":"No, today is Wednesday.","fr":"Non, aujourd'hui, c'est mercredi.","es":"No, hoy es miércoles.","ar":"لا، اليوم الأربعاء.","de":"Nein, heute ist Mittwoch.","zgh":"ⵓⵀⵓ ⴰⵙⵙⴰ ⴷ ⴰⴽⵕⴰⵙ"},"tr":{"ar":"lā, al-yawm al-arbiʿāʾ.","zgh":"uhu assa d akṛas"},"uses":["today","wednesday"]},
    {"id":"s06","text":{"en":"Monday morning.","fr":"Lundi matin.","es":"Lunes por la mañana.","ar":"صباح الاثنين.","de":"Montag früh."},"tr":{"ar":"ṣabāḥ al-ithnayn."},"uses":["morning","monday"]},
    {"id":"s07","text":{"en":"Night and day.","fr":"La nuit et le jour.","es":"La noche y el día.","ar":"الليل والنهار.","de":"Nacht und Tag."},"tr":{"ar":"al-layl wa-n-nahār."},"uses":["night"]},
    {"id":"s08","text":{"en":"See you tomorrow!","fr":"À demain !","es":"¡Hasta mañana!","ar":"إلى اللقاء غدا!","de":"Bis morgen!"},"tr":{"ar":"ilā al-liqāʾ ghadan!"},"uses":["tomorrow"]},
    {"id":"s09","text":{"en":"Is tomorrow Friday?","fr":"Est-ce que demain, c'est vendredi ?","es":"¿Mañana es viernes?","ar":"هل غدا الجمعة؟","de":"Ist morgen Freitag?","zgh":"ⵉⵙ ⴷ ⴰⵙⵉⵎⵡⴰⵙ ⴰⵙⴽⴽⴰ"},"tr":{"ar":"hal ghadan al-jumuʿa?","zgh":"is d asimwas askka"},"uses":["tomorrow","friday"]},
    {"id":"s10","text":{"en":"Yes, tomorrow is Friday.","fr":"Oui, demain, c'est vendredi.","es":"Sí, mañana es viernes.","ar":"نعم، غدا الجمعة.","de":"Ja, morgen ist Freitag.","zgh":"ⵉⵀ ⴰⵙⴽⴽⴰ ⴷ ⴰⵙⵉⵎⵡⴰⵙ"},"tr":{"ar":"naʿam, ghadan al-jumuʿa.","zgh":"ih askka d asimwas"},"uses":["tomorrow","friday"]},
    {"id":"s11","text":{"en":"Thank you, see you tomorrow.","fr":"Merci, à demain.","es":"Gracias, hasta mañana.","ar":"شكرا، إلى اللقاء غدا.","de":"Danke, bis morgen."},"tr":{"ar":"shukran, ilā al-liqāʾ ghadan."},"uses":["tomorrow"]},
    {"id":"n01","text":{"en":"Tomorrow evening we eat together.","fr":"Demain soir, nous mangeons ensemble.","es":"Mañana por la tarde comemos juntos.","ar":"غدا مساء نأكل معا.","de":"Morgen Abend essen wir zusammen."},"tr":{"ar":"ghadan masāʾ naʾkul maʿan."},"uses":["tomorrow","evening"]}
  ],
  "dialogue": ["s09","s10","s11"]
