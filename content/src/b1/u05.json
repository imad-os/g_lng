  "sentences": [
    { "id": "s01", "text": { "en": "What is this?", "fr": "Qu'est-ce que c'est ?", "es": "¿Qué es esto?", "ar": "ما هذا؟", "de": "Was ist das?" }, "tr": { "ar": "mā hādhā?" } },
    { "id": "s02", "text": { "en": "This is a book.", "fr": "C'est un livre.", "es": "Esto es un libro.", "ar": "هذا كتاب.", "de": "Das ist ein Buch." }, "tr": { "ar": "hādhā kitāb." } },
    { "id": "s03", "text": { "en": "The book is red.", "fr": "Le livre est rouge.", "es": "El libro es rojo.", "ar": "الكتاب أحمر.", "de": "Das Buch ist rot." }, "tr": { "ar": "al-kitāb aḥmar." } },
    { "id": "s04", "text": { "en": "The car is white.", "fr": "La voiture est blanche.", "es": "El coche es blanco.", "ar": "السيارة بيضاء.", "de": "Das Auto ist weiß." }, "tr": { "ar": "as-sayyāra bayḍāʾ." } },
    { "id": "s05", "text": { "en": "The table is black.", "fr": "La table est noire.", "es": "La mesa es negra.", "ar": "الطاولة سوداء.", "de": "Der Tisch ist schwarz." }, "tr": { "ar": "aṭ-ṭāwila sawdāʾ." } },
    { "id": "s06", "text": { "en": "The door is blue.", "fr": "La porte est bleue.", "es": "La puerta es azul.", "ar": "الباب أزرق.", "de": "Die Tür ist blau." }, "tr": { "ar": "al-bāb azraq." } },
    { "id": "s07", "text": { "en": "The apple is green.", "fr": "La pomme est verte.", "es": "La manzana es verde.", "ar": "التفاحة خضراء.", "de": "Der Apfel ist grün." }, "tr": { "ar": "at-tuffāḥa khaḍrāʾ." } },
    { "id": "s08", "text": { "en": "The house is yellow.", "fr": "La maison est jaune.", "es": "La casa es amarilla.", "ar": "البيت أصفر.", "de": "Das Haus ist gelb." }, "tr": { "ar": "al-bayt aṣfar." } },
    { "id": "s09", "text": { "en": "A big black car.", "fr": "Une grande voiture noire.", "es": "Un coche negro y grande.", "ar": "سيارة سوداء كبيرة.", "de": "Ein großes schwarzes Auto." }, "tr": { "ar": "sayyāra sawdāʾ kabīra." } },
    { "id": "s10", "text": { "en": "Is this a book? Yes.", "fr": "Est-ce un livre ? Oui.", "es": "¿Es esto un libro? Sí.", "ar": "هل هذا كتاب؟ نعم.", "de": "Ist das ein Buch? Ja." }, "tr": { "ar": "hal hādhā kitāb? naʿam." } },
    { "id": "s11", "text": { "en": "No, this is a table.", "fr": "Non, c'est une table.", "es": "No, esto es una mesa.", "ar": "لا، هذه طاولة.", "de": "Nein, das ist ein Tisch." }, "tr": { "ar": "lā, hādhihi ṭāwila." } },
    { "id": "s12", "text": { "en": "What colour is the car?", "fr": "De quelle couleur est la voiture ?", "es": "¿De qué color es el coche?", "ar": "ما لون السيارة؟", "de": "Welche Farbe hat das Auto?" }, "tr": { "ar": "mā lawn as-sayyāra?" } }
  ],
  "dialogue": ["s01", "s02", "s03"]
}
