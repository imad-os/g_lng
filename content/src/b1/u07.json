  "sentences": [
    { "id": "s01", "text": { "en": "I have a cat.", "fr": "J'ai un chat.", "es": "Tengo un gato.", "ar": "عندي قطة.", "de": "Ich habe eine Katze." }, "tr": { "ar": "ʿindī qiṭṭa." } },
    { "id": "s02", "text": { "en": "I have a dog.", "fr": "J'ai un chien.", "es": "Tengo un perro.", "ar": "عندي كلب.", "de": "Ich habe einen Hund." }, "tr": { "ar": "ʿindī kalb." } },
    { "id": "s03", "text": { "en": "The dog is big.", "fr": "Le chien est grand.", "es": "El perro es grande.", "ar": "الكلب كبير.", "de": "Der Hund ist groß." }, "tr": { "ar": "al-kalb kabīr." } },
    { "id": "s04", "text": { "en": "The cat is small.", "fr": "Le chat est petit.", "es": "El gato es pequeño.", "ar": "القطة صغيرة.", "de": "Die Katze ist klein." }, "tr": { "ar": "al-qiṭṭa ṣaghīra." } },
    { "id": "s05", "text": { "en": "The horse is white.", "fr": "Le cheval est blanc.", "es": "El caballo es blanco.", "ar": "الحصان أبيض.", "de": "Das Pferd ist weiß." }, "tr": { "ar": "al-ḥiṣān abyaḍ." } },
    { "id": "s06", "text": { "en": "The cow is black.", "fr": "La vache est noire.", "es": "La vaca es negra.", "ar": "البقرة سوداء.", "de": "Die Kuh ist schwarz." }, "tr": { "ar": "al-baqara sawdāʾ." } },
    { "id": "s07", "text": { "en": "Two birds.", "fr": "Deux oiseaux.", "es": "Dos pájaros.", "ar": "طائران.", "de": "Zwei Vögel." }, "tr": { "ar": "ṭāʾirān." } },
    { "id": "s08", "text": { "en": "Three sheep.", "fr": "Trois moutons.", "es": "Tres ovejas.", "ar": "ثلاثة خراف.", "de": "Drei Schafe." }, "tr": { "ar": "thalāthat kharāf." } },
    { "id": "s09", "text": { "en": "The donkey and the camel.", "fr": "L'âne et le chameau.", "es": "El burro y el camello.", "ar": "الحمار والجمل.", "de": "Der Esel und das Kamel." }, "tr": { "ar": "al-ḥimār wa-l-jamal." } },
    { "id": "s10", "text": { "en": "The lion is big.", "fr": "Le lion est grand.", "es": "El león es grande.", "ar": "الأسد كبير.", "de": "Der Löwe ist groß." }, "tr": { "ar": "al-asad kabīr." } },
    { "id": "s11", "text": { "en": "Do you have a dog?", "fr": "Tu as un chien ?", "es": "¿Tienes un perro?", "ar": "هل عندك كلب؟", "de": "Hast du einen Hund?" }, "tr": { "ar": "hal ʿindaka kalb?" } },
    { "id": "s12", "text": { "en": "Yes, I have a dog and a cat.", "fr": "Oui, j'ai un chien et un chat.", "es": "Sí, tengo un perro y un gato.", "ar": "نعم، عندي كلب وقطة.", "de": "Ja, ich habe einen Hund und eine Katze." }, "tr": { "ar": "naʿam, ʿindī kalb wa-qiṭṭa." } }
  ],
  "dialogue": ["s11", "s02", "s03"]
}
