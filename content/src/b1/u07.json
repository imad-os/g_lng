  "sentences": [
    {"id":"s01","text":{"en":"I have a cat.","fr":"J'ai un chat.","es":"Tengo un gato.","ar":"عندي قطة.","de":"Ich habe eine Katze.","zgh":"ⵖⵔⵉ ⴰⵎⵓⵛ"},"tr":{"ar":"ʿindī qiṭṭa.","zgh":"ɣri amuc"},"uses":["cat","i_have"]},
    {"id":"s02","text":{"en":"I have a dog.","fr":"J'ai un chien.","es":"Tengo un perro.","ar":"عندي كلب.","de":"Ich habe einen Hund.","zgh":"ⵖⵔⵉ ⴰⵢⴷⵉ"},"tr":{"ar":"ʿindī kalb.","zgh":"ɣri aydi"},"uses":["dog","i_have"]},
    {"id":"s03","text":{"en":"The dog is big.","fr":"Le chien est grand.","es":"El perro es grande.","ar":"الكلب كبير.","de":"Der Hund ist groß.","zgh":"ⴰⵢⴷⵉ ⵉⵎⵇⵇⵓⵔ"},"tr":{"ar":"al-kalb kabīr.","zgh":"aydi imqqur"},"uses":["dog"]},
    {"id":"s04","text":{"en":"The cat is small.","fr":"Le chat est petit.","es":"El gato es pequeño.","ar":"القطة صغيرة.","de":"Die Katze ist klein."},"tr":{"ar":"al-qiṭṭa ṣaghīra."},"uses":["cat"]},
    {"id":"s05","text":{"en":"The horse is white.","fr":"Le cheval est blanc.","es":"El caballo es blanco.","ar":"الحصان أبيض.","de":"Das Pferd ist weiß."},"tr":{"ar":"al-ḥiṣān abyaḍ."},"uses":["horse"]},
    {"id":"s06","text":{"en":"The cow is black.","fr":"La vache est noire.","es":"La vaca es negra.","ar":"البقرة سوداء.","de":"Die Kuh ist schwarz."},"tr":{"ar":"al-baqara sawdāʾ."},"uses":["cow"]},
    {"id":"s07","text":{"en":"Two birds.","fr":"Deux oiseaux.","es":"Dos pájaros.","ar":"طائران.","de":"Zwei Vögel."},"tr":{"ar":"ṭāʾirān."},"uses":["bird"]},
    {"id":"s08","text":{"en":"Three sheep.","fr":"Trois moutons.","es":"Tres ovejas.","ar":"ثلاثة خراف.","de":"Drei Schafe."},"tr":{"ar":"thalāthat kharāf."},"uses":["sheep"]},
    {"id":"s09","text":{"en":"The donkey and the camel.","fr":"L'âne et le chameau.","es":"El burro y el camello.","ar":"الحمار والجمل.","de":"Der Esel und das Kamel."},"tr":{"ar":"al-ḥimār wa-l-jamal."},"uses":["donkey","camel","and"]},
    {"id":"s10","text":{"en":"The lion is big.","fr":"Le lion est grand.","es":"El león es grande.","ar":"الأسد كبير.","de":"Der Löwe ist groß."},"tr":{"ar":"al-asad kabīr."},"uses":["lion"]},
    {"id":"s11","text":{"en":"Do you have a dog?","fr":"Tu as un chien ?","es":"¿Tienes un perro?","ar":"هل عندك كلب؟","de":"Hast du einen Hund?","zgh":"ⵉⵙ ⵖⵔⴽ ⴰⵢⴷⵉ"},"tr":{"ar":"hal ʿindaka kalb?","zgh":"is ɣrk aydi"},"uses":["dog","do_you_have"]},
    {"id":"s12","text":{"en":"Yes, I have a dog and a cat.","fr":"Oui, j'ai un chien et un chat.","es":"Sí, tengo un perro y un gato.","ar":"نعم، عندي كلب وقطة.","de":"Ja, ich habe einen Hund und eine Katze."},"tr":{"ar":"naʿam, ʿindī kalb wa-qiṭṭa."},"uses":["cat","dog","i_have","and"]}
  ],
