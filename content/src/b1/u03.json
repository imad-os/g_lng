  "sentences": [
    {"id":"s01","text":{"en":"I have three brothers.","fr":"J'ai trois frères.","es":"Tengo tres hermanos.","ar":"عندي ثلاثة إخوة.","de":"Ich habe drei Brüder."},"tr":{"ar":"ʿindī thalāthat ikhwa."},"uses":["three"]},
    {"id":"s02","text":{"en":"I have one sister.","fr":"J'ai une sœur.","es":"Tengo una hermana.","ar":"عندي أخت واحدة.","de":"Ich habe eine Schwester."},"tr":{"ar":"ʿindī ukht wāḥida."},"uses":["one"]},
    {"id":"s03","text":{"en":"How many brothers do you have?","fr":"Combien de frères as-tu ?","es":"¿Cuántos hermanos tienes?","ar":"كم أخا عندك؟","de":"Wie viele Brüder hast du?"},"tr":{"ar":"kam akhan ʿindak?"},"uses":["how_many"]},
    {"id":"s04","text":{"en":"Two and three are five.","fr":"Deux et trois font cinq.","es":"Dos y tres son cinco.","ar":"اثنان وثلاثة خمسة.","de":"Zwei und drei sind fünf."},"tr":{"ar":"ithnān wa-thalātha khamsa."},"uses":["two","three","five"]},
    {"id":"s05","text":{"en":"Four brothers and one sister.","fr":"Quatre frères et une sœur.","es":"Cuatro hermanos y una hermana.","ar":"أربعة إخوة وأخت واحدة.","de":"Vier Brüder und eine Schwester."},"tr":{"ar":"arbaʿat ikhwa wa-ukht wāḥida."},"uses":["one","four"]},
    {"id":"s06","text":{"en":"Two, please.","fr":"Deux, s'il vous plaît.","es":"Dos, por favor.","ar":"اثنان من فضلك.","de":"Zwei, bitte."},"tr":{"ar":"ithnān min faḍlik."},"uses":["two"]},
    {"id":"s07","text":{"en":"Five and five are ten.","fr":"Cinq et cinq font dix.","es":"Cinco y cinco son diez.","ar":"خمسة وخمسة عشرة.","de":"Fünf und fünf sind zehn."},"tr":{"ar":"khamsa wa-khamsa ʿashara."},"uses":["five","ten"]},
    {"id":"s08","text":{"en":"Zero is not one.","fr":"Zéro n'est pas un.","es":"Cero no es uno.","ar":"الصفر ليس واحدا.","de":"Null ist nicht eins."},"tr":{"ar":"aṣ-ṣifr laysa wāḥidan."},"uses":["one","zero"]},
    {"id":"s09","text":{"en":"Nine and one are ten.","fr":"Neuf et un font dix.","es":"Nueve y uno son diez.","ar":"تسعة وواحد عشرة.","de":"Neun und eins sind zehn."},"tr":{"ar":"tisʿa wa-wāḥid ʿashara."},"uses":["one","nine","ten"]},
    {"id":"s10","text":{"en":"How many sisters? Two.","fr":"Combien de sœurs ? Deux.","es":"¿Cuántas hermanas? Dos.","ar":"كم أختا؟ اثنتان.","de":"Wie viele Schwestern? Zwei."},"tr":{"ar":"kam ukhtan? ithnatān."},"uses":["two","how_many"]},
    {"id":"s11","text":{"en":"Six, seven, eight.","fr":"Six, sept, huit.","es":"Seis, siete, ocho.","ar":"ستة، سبعة، ثمانية.","de":"Sechs, sieben, acht.","zgh":"ⵙⴹⵉⵙ, ⵙⴰ, ⵜⴰⵎ."},"tr":{"ar":"sitta, sabʿa, thamāniya.","zgh":"sdis, sa, tam."},"uses":["six","seven","eight"]},
    {"id":"s12","text":{"en":"And you?","fr":"Et toi ?","es":"¿Y tú?","ar":"وأنت؟","de":"Und du?"},"tr":{"ar":"wa-anta?"},"uses":[]},
    {"id":"s13","text":{"en":"One, two, three!","fr":"Un, deux, trois !","es":"¡Uno, dos, tres!","ar":"واحد، اثنان، ثلاثة!","de":"Eins, zwei, drei!","zgh":"ⵢⴰⵏ, ⵙⵉⵏ, ⴽⵔⴰⴹ!"},"tr":{"ar":"wāḥid, ithnān, thalātha!","zgh":"yan, sin, krad!"},"uses":["one","two","three"]}
  ],
  "dialogue": ["s03","s01","s12","s02"]
