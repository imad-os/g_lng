    { "id": "man", "text": { "en": "man", "fr": "homme", "es": "hombre", "ar": "رجل", "de": "Mann", "zgh": "ⴰⵔⴳⴰⵣ" }, "tr": { "ar": "rajul", "zgh": "argaz" } },
