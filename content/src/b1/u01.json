  "title": { "en": "Hello!", "fr": "Bonjour !", "es": "¡Hola!", "ar": "مرحبا!" },
  "tip": {
    "en": "Start every conversation with a greeting, then say your name. Short phrases are enough at first.",
    "fr": "Commencez chaque conversation par une salutation, puis dites votre nom. Des phrases courtes suffisent au début.",
    "es": "Empieza cada conversación con un saludo y luego di tu nombre. Al principio bastan frases cortas.",
    "ar": "ابدأ كل محادثة بالتحية ثم قل اسمك. الجمل القصيرة تكفي في البداية."
  },
  "words": [
    { "id": "hello", "text": { "en": "hello", "fr": "bonjour", "es": "hola", "ar": "مرحبا", "de": "hallo", "zgh": "ⴰⵣⵓⵍ" }, "tr": { "ar": "marḥaban", "zgh": "azul" } },
