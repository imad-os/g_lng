    { "id": "boy", "text": { "en": "boy", "fr": "garçon", "es": "niño", "ar": "ولد", "de": "Junge", "zgh": "ⴰⴼⵔⵓⵅ" }, "tr": { "ar": "walad", "zgh": "afrukh" } },
