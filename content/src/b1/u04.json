    { "id": "i_eat", "text": { "en": "I eat", "fr": "je mange", "es": "como", "ar": "آكل", "de": "ich esse" }, "tr": { "ar": "ākul" } }
  ],
  "sentences": [
    { "id": "s01", "text": { "en": "Tea, please.", "fr": "Du thé, s'il vous plaît.", "es": "Té, por favor.", "ar": "شاي من فضلك.", "de": "Tee, bitte." }, "tr": { "ar": "shāy min faḍlik." } },
    { "id": "s02", "text": { "en": "I want coffee.", "fr": "Je veux du café.", "es": "Quiero café.", "ar": "أريد قهوة.", "de": "Ich möchte Kaffee." }, "tr": { "ar": "urīdu qahwa." } },
    { "id": "s03", "text": { "en": "I want milk and bread.", "fr": "Je veux du lait et du pain.", "es": "Quiero leche y pan.", "ar": "أريد حليبا وخبزا.", "de": "Ich möchte Milch und Brot." }, "tr": { "ar": "urīdu ḥalīban wa-khubzan." } },
    { "id": "s04", "text": { "en": "I eat rice.", "fr": "Je mange du riz.", "es": "Como arroz.", "ar": "آكل أرزا.", "de": "Ich esse Reis." }, "tr": { "ar": "ākulu aruzzan." } },
    { "id": "s05", "text": { "en": "I eat fish and rice.", "fr": "Je mange du poisson et du riz.", "es": "Como pescado y arroz.", "ar": "آكل سمكا وأرزا.", "de": "Ich esse Fisch und Reis." }, "tr": { "ar": "ākulu samakan wa-aruzzan." } },
    { "id": "s06", "text": { "en": "Couscous with meat.", "fr": "Du couscous avec de la viande.", "es": "Cuscús con carne.", "ar": "كسكس باللحم.", "de": "Couscous mit Fleisch." }, "tr": { "ar": "kuskus bil-laḥm." } },
    { "id": "s07", "text": { "en": "The apple is big.", "fr": "La pomme est grosse.", "es": "La manzana es grande.", "ar": "التفاحة كبيرة.", "de": "Der Apfel ist groß." }, "tr": { "ar": "at-tuffāḥa kabīra." } },
    { "id": "s08", "text": { "en": "An egg and salt.", "fr": "Un œuf et du sel.", "es": "Un huevo y sal.", "ar": "بيضة وملح.", "de": "Ein Ei und Salz." }, "tr": { "ar": "bayḍa wa-milḥ." } },
    { "id": "s09", "text": { "en": "Yes, I want tea.", "fr": "Oui, je veux du thé.", "es": "Sí, quiero té.", "ar": "نعم، أريد شايا.", "de": "Ja, ich möchte Tee." }, "tr": { "ar": "naʿam, urīdu shāyan." } },
    { "id": "s10", "text": { "en": "No, thank you. Water, please.", "fr": "Non, merci. De l'eau, s'il vous plaît.", "es": "No, gracias. Agua, por favor.", "ar": "لا، شكرا. ماء من فضلك.", "de": "Nein, danke. Wasser, bitte." }, "tr": { "ar": "lā, shukran. māʾ min faḍlik." } },
    { "id": "s11", "text": { "en": "Do you want tea?", "fr": "Tu veux du thé ?", "es": "¿Quieres té?", "ar": "هل تريد شايا؟", "de": "Möchtest du Tee?" }, "tr": { "ar": "hal turīdu shāyan?" } },
    { "id": "s12", "text": { "en": "Milk with coffee.", "fr": "Du lait avec du café.", "es": "Leche con café.", "ar": "حليب مع قهوة.", "de": "Milch mit Kaffee." }, "tr": { "ar": "ḥalīb maʿa qahwa." } },
    { "id": "s13", "text": { "en": "With milk, please.", "fr": "Avec du lait, s'il vous plaît.", "es": "Con leche, por favor.", "ar": "بالحليب من فضلك.", "de": "Mit Milch, bitte." }, "tr": { "ar": "bil-ḥalīb min faḍlik." } }
  ],
  "dialogue": ["s11", "s09", "s13"]
}
