 "sentences": [
  {
   "id": "s01",
   "text": {
    "en": "I wake up at seven.",
    "fr": "Je me réveille à sept heures.",
    "es": "Me despierto a las siete.",
    "ar": "أستيقظ في الساعة السابعة.",
    "de": "Ich wache um sieben Uhr auf."
   },
   "tr": {
    "ar": "astayqiẓ fī as-sāʿa as-sābiʿa."
   }
  },
  {
   "id": "s02",
   "text": {
    "en": "My alarm clock rings every day.",
    "fr": "Mon réveil sonne tous les jours.",
    "es": "Mi despertador suena todos los días.",
    "ar": "يرن منبهي كل يوم.",
    "de": "Mein Wecker klingelt jeden Tag."
   },
   "tr": {
    "ar": "yarinn munabbihī kull yawm."
   }
  },
  {
   "id": "s03",
   "text": {
    "en": "I get up early.",
    "fr": "Je me lève tôt.",
    "es": "Me levanto temprano.",
    "ar": "أنهض مبكرا.",
    "de": "Ich stehe früh auf."
   },
   "tr": {
    "ar": "anhaḍ mubakkiran."
   }
  },
  {
   "id": "s04",
   "text": {
    "en": "Then I wash and brush my teeth.",
    "fr": "Ensuite, je me lave et je me brosse les dents.",
    "es": "Luego me lavo y me cepillo los dientes.",
    "ar": "ثم أغتسل وأفرش أسناني.",
    "de": "Dann wasche ich mich und putze mir die Zähne."
   },
   "tr": {
    "ar": "thumma aghtasil wa-afrush asnānī."
   }
  },
  {
   "id": "s05",
   "text": {
    "en": "I always take a shower before breakfast.",
    "fr": "Je prends toujours une douche avant le petit-déjeuner.",
    "es": "Siempre me ducho antes del desayuno.",
    "ar": "أستحم دائما قبل الفطور.",
    "de": "Ich dusche immer vor dem Frühstück."
   },
   "tr": {
    "ar": "astaḥimm dāʾiman qabl al-futūr."
   }
  },
  {
   "id": "s06",
   "text": {
    "en": "My brother gets dressed quickly.",
    "fr": "Mon frère s'habille vite.",
    "es": "Mi hermano se viste rápido.",
    "ar": "يرتدي أخي ملابسه بسرعة.",
    "de": "Mein Bruder zieht sich schnell an."
   },
   "tr": {
    "ar": "yartadī akhī malābisahu bisurʿa."
   }
  },
  {
   "id": "s07",
   "text": {
    "en": "She combs her hair in front of the mirror.",
    "fr": "Elle se coiffe devant le miroir.",
    "es": "Ella se peina delante del espejo.",
    "ar": "تمشط شعرها أمام المرآة.",
    "de": "Sie kämmt sich vor dem Spiegel."
   },
   "tr": {
    "ar": "tumashshiṭ shaʿrahā amāma al-mirʾāh."
   }
  },
  {
   "id": "s08",
   "text": {
    "en": "We usually have breakfast together.",
    "fr": "D'habitude, nous prenons le petit-déjeuner ensemble.",
    "es": "Normalmente desayunamos juntos.",
    "ar": "عادة نتناول الفطور معا.",
    "de": "Normalerweise frühstücken wir zusammen."
   },
   "tr": {
    "ar": "ʿādatan natanāwal al-futūr maʿan."
   }
  },
  {
   "id": "s09",
   "text": {
    "en": "I leave the house at eight o'clock.",
    "fr": "Je sors de la maison à huit heures.",
    "es": "Salgo de casa a las ocho.",
    "ar": "أخرج من البيت في الساعة الثامنة.",
    "de": "Ich verlasse das Haus um acht Uhr."
   },
   "tr": {
    "ar": "akhruj min al-bayt fī as-sāʿa ath-thāmina."
   }
  },
  {
   "id": "s10",
   "text": {
    "en": "My father goes to work by bus.",
    "fr": "Mon père va au travail en bus.",
    "es": "Mi padre va al trabajo en autobús.",
    "ar": "يذهب أبي إلى العمل بالحافلة.",
    "de": "Mein Vater fährt mit dem Bus zur Arbeit."
   },
   "tr": {
    "ar": "yadhhab abī ilā al-ʿamal bil-ḥāfila."
   }
  },
  {
   "id": "s11",
   "text": {
    "en": "She works in a school and I study at the university.",
    "fr": "Elle travaille dans une école et moi, j'étudie à l'université.",
    "es": "Ella trabaja en una escuela y yo estudio en la universidad.",
    "ar": "هي تعمل في مدرسة وأنا أدرس في الجامعة.",
    "de": "Sie arbeitet in einer Schule und ich lerne an der Universität."
   },
   "tr": {
    "ar": "hiya taʿmal fī madrasa wa-anā adrus fī al-jāmiʿa."
   }
  },
  {
   "id": "s12",
   "text": {
    "en": "I have lunch at one o'clock with my colleagues.",
    "fr": "Je déjeune à une heure avec mes collègues.",
    "es": "Almuerzo a la una con mis compañeros.",
    "ar": "أتناول الغداء في الساعة الواحدة مع زملائي.",
    "de": "Ich esse um ein Uhr mit meinen Kollegen zu Mittag."
   },
   "tr": {
    "ar": "atanāwal al-ghadāʾ fī as-sāʿa al-wāḥida maʿa zumalāʾī."
   }
  },
  {
   "id": "s13",
   "text": {
    "en": "After lunch, I rest for a few minutes.",
    "fr": "Après le déjeuner, je me repose quelques minutes.",
    "es": "Después del almuerzo, descanso unos minutos.",
    "ar": "بعد الغداء أرتاح بضع دقائق.",
    "de": "Nach dem Mittagessen ruhe ich mich ein paar Minuten aus."
   },
   "tr": {
    "ar": "baʿda al-ghadāʾ artāḥ biḍʿa daqāʾiq."
   }
  },
  {
   "id": "s14",
   "text": {
    "en": "Sometimes I work late.",
    "fr": "Parfois, je travaille tard.",
    "es": "A veces trabajo hasta tarde.",
    "ar": "أحيانا أعمل حتى وقت متأخر.",
    "de": "Manchmal arbeite ich bis spät."
   },
   "tr": {
    "ar": "aḥyānan aʿmal ḥattā waqt mutaʾakhkhir."
   }
  },
  {
   "id": "s15",
   "text": {
    "en": "I come home at six.",
    "fr": "Je rentre à la maison à six heures.",
    "es": "Vuelvo a casa a las seis.",
    "ar": "أعود إلى البيت في الساعة السادسة.",
    "de": "Ich komme um sechs Uhr nach Hause."
   },
   "tr": {
    "ar": "aʿūd ilā al-bayt fī as-sāʿa as-sādisa."
   }
  },
  {
   "id": "s16",
   "text": {
    "en": "My mother often cooks in the evening.",
    "fr": "Ma mère cuisine souvent le soir.",
    "es": "Mi madre cocina a menudo por la noche.",
    "ar": "تطبخ أمي غالبا في المساء.",
    "de": "Meine Mutter kocht oft am Abend."
   },
   "tr": {
    "ar": "taṭbukh ummī ghāliban fī al-masāʾ."
   }
  },
  {
   "id": "s17",
   "text": {
    "en": "We have dinner at eight.",
    "fr": "Nous dînons à huit heures.",
    "es": "Cenamos a las ocho.",
    "ar": "نتناول العشاء في الساعة الثامنة.",
    "de": "Wir essen um acht Uhr zu Abend."
   },
   "tr": {
    "ar": "natanāwal al-ʿashāʾ fī as-sāʿa ath-thāmina."
   }
  },
  {
   "id": "s18",
   "text": {
    "en": "After dinner, we watch TV.",
    "fr": "Après le dîner, nous regardons la télé.",
    "es": "Después de la cena, vemos la tele.",
    "ar": "بعد العشاء نشاهد التلفاز.",
    "de": "Nach dem Abendessen sehen wir fern."
   },
   "tr": {
    "ar": "baʿda al-ʿashāʾ nushāhid at-tilfāz."
   }
  },
  {
   "id": "s19",
   "text": {
    "en": "I never watch TV before work.",
    "fr": "Je ne regarde jamais la télé avant le travail.",
    "es": "Nunca veo la tele antes del trabajo.",
    "ar": "لا أشاهد التلفاز أبدا قبل العمل.",
    "de": "Ich sehe nie vor der Arbeit fern."
   },
   "tr": {
    "ar": "lā ushāhid at-tilfāz abadan qabl al-ʿamal."
   }
  },
  {
   "id": "s20",
   "text": {
    "en": "I go to bed at eleven.",
    "fr": "Je me couche à onze heures.",
    "es": "Me acuesto a las once.",
    "ar": "أذهب إلى السرير في الساعة الحادية عشرة.",
    "de": "Ich gehe um elf Uhr ins Bett."
   },
   "tr": {
    "ar": "adhhab ilā as-sarīr fī as-sāʿa al-ḥādiya ʿashara."
   }
  },
  {
   "id": "s21",
   "text": {
    "en": "My little sister sleeps early.",
    "fr": "Ma petite sœur dort tôt.",
    "es": "Mi hermana pequeña duerme temprano.",
    "ar": "تنام أختي الصغيرة مبكرا.",
    "de": "Meine kleine Schwester schläft früh."
   },
   "tr": {
    "ar": "tanām ukhtī aṣ-ṣaghīra mubakkiran."
   }
  },
  {
   "id": "s22",
   "text": {
    "en": "On Sundays, I get up late.",
    "fr": "Le dimanche, je me lève tard.",
    "es": "Los domingos me levanto tarde.",
    "ar": "أنهض متأخرا أيام الأحد.",
    "de": "Sonntags stehe ich spät auf."
   },
   "tr": {
    "ar": "anhaḍ mutaʾakhkhiran ayyām al-aḥad."
   }
  },
  {
   "id": "s23",
   "text": {
    "en": "What time do you wake up?",
    "fr": "À quelle heure te réveilles-tu ?",
    "es": "¿A qué hora te despiertas?",
    "ar": "في أي ساعة تستيقظ؟",
    "de": "Um wie viel Uhr wachst du auf?"
   },
   "tr": {
    "ar": "fī ayyi sāʿa tastayqiẓ?"
   }
  },
  {
   "id": "s24",
   "text": {
    "en": "Do you cook every day?",
    "fr": "Est-ce que tu cuisines tous les jours ?",
    "es": "¿Cocinas todos los días?",
    "ar": "هل تطبخ كل يوم؟",
    "de": "Kochst du jeden Tag?"
   },
   "tr": {
    "ar": "hal taṭbukh kull yawm?"
   }
  },
  {
   "id": "s25",
   "text": {
    "en": "I usually leave early, but today I am late.",
    "fr": "D'habitude, je pars tôt, mais aujourd'hui je suis en retard.",
    "es": "Normalmente salgo temprano, pero hoy llego tarde.",
    "ar": "عادة أخرج مبكرا لكنني اليوم متأخر.",
    "de": "Normalerweise gehe ich früh los, aber heute bin ich spät dran."
   },
   "tr": {
    "ar": "ʿādatan akhruj mubakkiran lākinnanī al-yawm mutaʾakhkhir."
   }
  },
  {
   "id": "s26",
   "text": {
    "en": "My routine is simple, but I like it.",
    "fr": "Ma routine est simple, mais je l'aime bien.",
    "es": "Mi rutina es sencilla, pero me gusta.",
    "ar": "روتيني بسيط لكنني أحبه.",
    "de": "Meine Routine ist einfach, aber ich mag sie."
   },
   "tr": {
    "ar": "rūtīnī basīṭ lākinnanī uḥibbuh."
   }
  },
  {
   "id": "s27",
   "text": {
    "en": "He studies in the morning and works in the afternoon.",
    "fr": "Il étudie le matin et travaille l'après-midi.",
    "es": "Estudia por la mañana y trabaja por la tarde.",
