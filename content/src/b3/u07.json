 "sentences": [
  {
   "id": "s01",
   "text": {
    "en": "My head hurts.",
    "fr": "J'ai mal à la tête.",
    "es": "Me duele la cabeza.",
    "ar": "يؤلمني رأسي.",
    "de": "Mein Kopf tut weh."
   },
   "tr": {
    "ar": "yuʾlimunī raʾsī."
   }
  },
  {
   "id": "s02",
   "text": {
    "en": "I have a headache and a fever.",
    "fr": "J'ai mal à la tête et de la fièvre.",
    "es": "Tengo dolor de cabeza y fiebre.",
    "ar": "أعاني من صداع وحمى.",
    "de": "Ich habe Kopfschmerzen und Fieber."
   },
   "tr": {
    "ar": "uʿānī min ṣudāʿ wa-ḥumma."
   }
  },
  {
   "id": "s03",
   "text": {
    "en": "My throat hurts and I cough.",
    "fr": "J'ai mal à la gorge et je tousse.",
    "es": "Me duele la garganta y toso.",
    "ar": "يؤلمني حلقي وأسعل.",
    "de": "Mein Hals tut weh und ich huste."
   },
   "tr": {
    "ar": "yuʾlimunī ḥalqī wa-asʿul."
   }
  },
  {
   "id": "s04",
   "text": {
    "en": "My stomach hurts.",
    "fr": "J'ai mal au ventre.",
    "es": "Me duele el estómago.",
    "ar": "تؤلمني معدتي.",
    "de": "Mein Magen tut weh."
   },
   "tr": {
    "ar": "tuʾlimunī miʿdatī."
   }
  },
  {
   "id": "s05",
   "text": {
    "en": "My back hurts a lot.",
    "fr": "J'ai très mal au dos.",
    "es": "Me duele mucho la espalda.",
    "ar": "يؤلمني ظهري كثيرا.",
    "de": "Mein Rücken tut sehr weh."
   },
   "tr": {
    "ar": "yuʾlimunī ẓahrī kathīran."
   }
  },
  {
   "id": "s06",
   "text": {
    "en": "My knees hurt when I walk.",
    "fr": "J'ai mal aux genoux quand je marche.",
    "es": "Me duelen las rodillas cuando camino.",
    "ar": "تؤلمني ركبتاي عندما أمشي.",
    "de": "Meine Knie tun weh, wenn ich gehe."
   },
   "tr": {
    "ar": "tuʾlimunī rukbatāya ʿindamā amshī."
   }
  },
  {
   "id": "s07",
   "text": {
    "en": "He has pain in his foot.",
    "fr": "Il a mal au pied.",
    "es": "Le duele el pie.",
    "ar": "يشعر بألم في قدمه.",
    "de": "Sein Fuß tut ihm weh."
   },
   "tr": {
    "ar": "yashʿur bi-alam fī qadamih."
   }
  },
  {
   "id": "s08",
   "text": {
    "en": "I am sick. I think I have a cold.",
    "fr": "Je suis malade. Je crois que j'ai un rhume.",
    "es": "Estoy enfermo. Creo que tengo un resfriado.",
    "ar": "أنا مريض. أظن أنني مصاب بزكام.",
    "de": "Ich bin krank. Ich glaube, ich habe eine Erkältung."
   },
   "tr": {
    "ar": "anā marīḍ. aẓunnu annanī muṣāb bi-zukām."
   }
  },
  {
   "id": "s09",
   "text": {
    "en": "You should see a doctor.",
    "fr": "Tu devrais voir un médecin.",
    "es": "Deberías ver a un médico.",
    "ar": "يجب أن ترى طبيبا.",
    "de": "Du solltest zum Arzt gehen."
   },
   "tr": {
    "ar": "yajib an tarā ṭabīban."
   }
  },
  {
   "id": "s10",
   "text": {
    "en": "You should rest at home.",
    "fr": "Tu devrais te reposer à la maison.",
    "es": "Deberías descansar en casa.",
    "ar": "يجب أن ترتاح في البيت.",
    "de": "Du solltest dich zu Hause ausruhen."
   },
   "tr": {
    "ar": "yajib an tartāḥ fī al-bayt."
   }
  },
  {
   "id": "s11",
   "text": {
    "en": "Drink a lot of water.",
    "fr": "Bois beaucoup d'eau.",
    "es": "Bebe mucha agua.",
    "ar": "اشرب كثيرا من الماء.",
    "de": "Trink viel Wasser."
   },
   "tr": {
    "ar": "ishrab kathīran min al-māʾ."
   }
  },
  {
   "id": "s12",
   "text": {
    "en": "Take this medicine twice a day.",
    "fr": "Prends ce médicament deux fois par jour.",
    "es": "Toma esta medicina dos veces al día.",
    "ar": "تناول هذا الدواء مرتين في اليوم.",
    "de": "Nimm dieses Medikament zweimal am Tag."
   },
   "tr": {
    "ar": "tanāwal hādhā ad-dawāʾ marratayn fī al-yawm."
   }
  },
  {
   "id": "s13",
   "text": {
    "en": "Take one pill before breakfast.",
    "fr": "Prends un comprimé avant le petit-déjeuner.",
    "es": "Toma una pastilla antes del desayuno.",
    "ar": "تناول حبة دواء قبل الفطور.",
    "de": "Nimm eine Tablette vor dem Frühstück."
   },
   "tr": {
    "ar": "tanāwal ḥabbat dawāʾ qabl al-futūr."
   }
  },
  {
   "id": "s14",
   "text": {
    "en": "Where is the pharmacy?",
    "fr": "Où est la pharmacie ?",
    "es": "¿Dónde está la farmacia?",
    "ar": "أين الصيدلية؟",
    "de": "Wo ist die Apotheke?"
   },
   "tr": {
    "ar": "ayna aṣ-ṣaydaliyya?"
   }
  },
  {
   "id": "s15",
   "text": {
    "en": "I need a doctor, please.",
    "fr": "J'ai besoin d'un médecin, s'il vous plaît.",
    "es": "Necesito un médico, por favor.",
    "ar": "أحتاج إلى طبيب من فضلك.",
    "de": "Ich brauche bitte einen Arzt."
   },
   "tr": {
    "ar": "aḥtāj ilā ṭabīb min faḍlik."
   }
  },
  {
   "id": "s16",
   "text": {
    "en": "Where does it hurt?",
    "fr": "Où as-tu mal ?",
    "es": "¿Dónde te duele?",
    "ar": "أين يؤلمك؟",
    "de": "Wo tut es weh?"
   },
   "tr": {
    "ar": "ayna yuʾlimuk?"
   }
  },
  {
   "id": "s17",
   "text": {
    "en": "My eyes hurt when I read.",
    "fr": "J'ai mal aux yeux quand je lis.",
    "es": "Me duelen los ojos cuando leo.",
    "ar": "تؤلمني عيناي عندما أقرأ.",
    "de": "Meine Augen tun weh, wenn ich lese."
   },
   "tr": {
    "ar": "tuʾlimunī ʿaynāya ʿindamā aqraʾ."
   }
  },
  {
   "id": "s18",
   "text": {
    "en": "My tooth hurts. I cannot eat.",
    "fr": "J'ai mal à une dent. Je ne peux pas manger.",
    "es": "Me duele un diente. No puedo comer.",
    "ar": "يؤلمني سني. لا أستطيع أن آكل.",
    "de": "Mein Zahn tut weh. Ich kann nicht essen."
   },
   "tr": {
    "ar": "yuʾlimunī sinnī. lā astaṭīʿ an ākul."
   }
  },
  {
   "id": "s19",
   "text": {
    "en": "She has a fever and she is very tired.",
    "fr": "Elle a de la fièvre et elle est très fatiguée.",
    "es": "Tiene fiebre y está muy cansada.",
    "ar": "عندها حمى وهي متعبة جدا.",
    "de": "Sie hat Fieber und ist sehr müde."
   },
   "tr": {
    "ar": "ʿindahā ḥumma wa-hiya mutʿaba jiddan."
   }
  },
  {
   "id": "s20",
   "text": {
    "en": "Wash your hands before eating.",
    "fr": "Lave-toi les mains avant de manger.",
    "es": "Lávate las manos antes de comer.",
    "ar": "اغسل يديك قبل الأكل.",
    "de": "Wasch dir die Hände, bevor du isst."
   },
   "tr": {
    "ar": "ighsil yadayka qabl al-akl."
   }
  },
  {
   "id": "s21",
   "text": {
    "en": "Open your mouth, please.",
    "fr": "Ouvrez la bouche, s'il vous plaît.",
    "es": "Abra la boca, por favor.",
    "ar": "افتح فمك من فضلك.",
    "de": "Öffnen Sie bitte den Mund."
   },
   "tr": {
    "ar": "iftaḥ famak min faḍlik."
   }
  },
  {
   "id": "s22",
   "text": {
    "en": "My arm and my shoulder hurt.",
    "fr": "J'ai mal au bras et à l'épaule.",
    "es": "Me duelen el brazo y el hombro.",
    "ar": "يؤلمني ذراعي وكتفي.",
    "de": "Mein Arm und meine Schulter tun weh."
   },
   "tr": {
    "ar": "yuʾlimunī dhirāʿī wa-katifī."
   }
  },
  {
   "id": "s23",
   "text": {
    "en": "Do you feel better today?",
    "fr": "Tu te sens mieux aujourd'hui ?",
    "es": "¿Te sientes mejor hoy?",
    "ar": "هل تشعر أنك أفضل اليوم؟",
    "de": "Fühlst du dich heute besser?"
   },
   "tr": {
    "ar": "hal tashʿur annaka afḍal al-yawm?"
   }
  },
  {
   "id": "s24",
   "text": {
    "en": "Yes, I feel much better.",
    "fr": "Oui, je me sens beaucoup mieux.",
    "es": "Sí, me siento mucho mejor.",
    "ar": "نعم، أشعر أنني أفضل بكثير.",
    "de": "Ja, ich fühle mich viel besser."
   },
   "tr": {
    "ar": "naʿam, ashʿur annanī afḍal bi-kathīr."
   }
  },
  {
   "id": "s25",
   "text": {
    "en": "He should go to the hospital.",
    "fr": "Il devrait aller à l'hôpital.",
    "es": "Debería ir al hospital.",
    "ar": "يجب أن يذهب إلى المستشفى.",
    "de": "Er sollte ins Krankenhaus gehen."
   },
   "tr": {
    "ar": "yajib an yadhhab ilā al-mustashfā."
   }
  },
  {
   "id": "s26",
   "text": {
    "en": "My legs are tired after the trip.",
    "fr": "Mes jambes sont fatiguées après le voyage.",
    "es": "Tengo las piernas cansadas después del viaje.",
    "ar": "رجلاي متعبتان بعد الرحلة.",
    "de": "Meine Beine sind nach der Reise müde."
   },
   "tr": {
    "ar": "rijlāya mutʿabatān baʿda ar-riḥla."
   }
  },
  {
   "id": "s27",
   "text": {
    "en": "To stay healthy, eat well and sleep well.",
    "fr": "Pour rester en bonne santé, mange bien et dors bien.",
    "es": "Para estar sano, come bien y duerme bien.",
    "ar": "لتكون بصحة جيدة، كل جيدا ونم جيدا.",
    "de": "Um gesund zu bleiben, iss gut und schlaf gut."
   },
   "tr": {
    "ar": "li-takūn biṣiḥḥa jayyida, kul jayyidan wa-nam jayyidan."
   }
