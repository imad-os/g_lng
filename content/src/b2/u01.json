  "sentences": [
    {"id":"s01","text":{"en":"What is your name?","fr":"Comment tu t'appelles ?","es":"¿Cómo te llamas?","ar":"ما اسمك؟","de":"Wie heißt du?"},"tr":{"ar":"mā ismuk?"},"uses":[]},
    {"id":"s02","text":{"en":"My name is Sara.","fr":"Je m'appelle Sara.","es":"Me llamo Sara.","ar":"اسمي سارة.","de":"Ich heiße Sara.","zgh":"ⵉⵙⵎ ⵉⵏⵓ ⵙⴰⵔⴰ"},"tr":{"ar":"ismī Sāra.","zgh":"ism inu Sara"},"uses":[]},
    {"id":"s03","text":{"en":"How old are you?","fr":"Quel âge as-tu ?","es":"¿Cuántos años tienes?","ar":"كم عمرك؟","de":"Wie alt bist du?"},"tr":{"ar":"kam ʿumruk?"},"uses":["age"]},
    {"id":"s04","text":{"en":"I am twenty-five years old.","fr":"J'ai vingt-cinq ans.","es":"Tengo veinticinco años.","ar":"عمري خمسة وعشرون عاما.","de":"Ich bin fünfundzwanzig Jahre alt."},"tr":{"ar":"ʿumrī khamsa wa-ʿishrūn ʿāman."},"uses":[]},
    {"id":"s05","text":{"en":"Where are you from?","fr":"D'où viens-tu ?","es":"¿De dónde eres?","ar":"من أين أنت؟","de":"Woher kommst du?"},"tr":{"ar":"min ayna anta?"},"uses":["from"]},
    {"id":"s06","text":{"en":"I am from Morocco.","fr":"Je viens du Maroc.","es":"Soy de Marruecos.","ar":"أنا من المغرب.","de":"Ich komme aus Marokko."},"tr":{"ar":"anā min al-maghrib."},"uses":["from","morocco"]},
    {"id":"s07","text":{"en":"She is from Spain.","fr":"Elle vient d'Espagne.","es":"Ella es de España.","ar":"هي من إسبانيا.","de":"Sie kommt aus Spanien."},"tr":{"ar":"hiya min isbāniyā."},"uses":["from","spain"]},
    {"id":"s08","text":{"en":"I live in a big city.","fr":"J'habite dans une grande ville.","es":"Vivo en una ciudad grande.","ar":"أسكن في مدينة كبيرة.","de":"Ich wohne in einer großen Stadt."},"tr":{"ar":"askun fī madīna kabīra."},"uses":["city","live"]},
    {"id":"s09","text":{"en":"What is your job?","fr":"Quel est ton métier ?","es":"¿A qué te dedicas?","ar":"ماذا تعمل؟","de":"Was machst du beruflich?"},"tr":{"ar":"mādhā taʿmal?"},"uses":["job"]},
    {"id":"s10","text":{"en":"I am a teacher.","fr":"Je suis professeur.","es":"Soy profesor.","ar":"أنا مدرس.","de":"Ich bin Lehrer.","zgh":"ⵏⴽⴽⵉ ⴷ ⴰⵙⵍⵎⴰⴷ"},"tr":{"ar":"anā mudarris.","zgh":"nkki d aslmad"},"uses":["teacher"]},
    {"id":"s11","text":{"en":"My brother is a doctor.","fr":"Mon frère est médecin.","es":"Mi hermano es médico.","ar":"أخي طبيب.","de":"Mein Bruder ist Arzt.","zgh":"ⵓⴳⵎⴰ ⵉⵏⵓ ⴷ ⴰⵟⴱⵉⴱ"},"tr":{"ar":"akhī ṭabīb.","zgh":"ugma inu d aṭbib"},"uses":["doctor"]},
    {"id":"s12","text":{"en":"My father works as a driver.","fr":"Mon père travaille comme chauffeur.","es":"Mi padre trabaja de conductor.","ar":"أبي يعمل سائقا.","de":"Mein Vater arbeitet als Fahrer."},"tr":{"ar":"abī yaʿmal sāʾiqan."},"uses":["job","driver","work"]},
    {"id":"s13","text":{"en":"I study English at the university.","fr":"J'étudie l'anglais à l'université.","es":"Estudio inglés en la universidad.","ar":"أدرس الإنجليزية في الجامعة.","de":"Ich studiere Englisch an der Universität."},"tr":{"ar":"adrus al-injlīziyya fī al-jāmiʿa."},"uses":["study","english"]},
    {"id":"s14","text":{"en":"Do you speak French?","fr":"Parles-tu français ?","es":"¿Hablas francés?","ar":"هل تتكلم الفرنسية؟","de":"Sprichst du Französisch?"},"tr":{"ar":"hal tatakallam al-faransiyya?"},"uses":["speak","french","france"]},
    {"id":"s15","text":{"en":"Yes, I speak Arabic and a little French.","fr":"Oui, je parle arabe et un peu de français.","es":"Sí, hablo árabe y un poco de francés.","ar":"نعم، أتكلم العربية وقليلا من الفرنسية.","de":"Ja, ich spreche Arabisch und ein bisschen Französisch."},"tr":{"ar":"naʿam, atakallam al-ʿarabiyya wa-qalīlan min al-faransiyya."},"uses":["from","speak","arabic","french","france"]},
    {"id":"s16","text":{"en":"Are you married or single?","fr":"Es-tu marié ou célibataire ?","es":"¿Estás casado o soltero?","ar":"هل أنت متزوج أم أعزب؟","de":"Bist du verheiratet oder ledig?"},"tr":{"ar":"hal anta mutazawwij am aʿzab?"},"uses":["married","single"]},
    {"id":"s17","text":{"en":"I am single, but my sister is married.","fr":"Je suis célibataire, mais ma sœur est mariée.","es":"Estoy soltero, pero mi hermana está casada.","ar":"أنا أعزب لكن أختي متزوجة.","de":"Ich bin ledig, aber meine Schwester ist verheiratet."},"tr":{"ar":"anā aʿzab lākin ukhtī mutazawwija."},"uses":["married","single"]},
    {"id":"s18","text":{"en":"What is your phone number?","fr":"Quel est ton numéro de téléphone ?","es":"¿Cuál es tu número de teléfono?","ar":"ما رقم هاتفك؟","de":"Wie ist deine Telefonnummer?"},"tr":{"ar":"mā raqm hātifuk?"},"uses":["from","phone_number"]},
    {"id":"s19","text":{"en":"My address is in the city centre.","fr":"Mon adresse est dans le centre-ville.","es":"Mi dirección está en el centro de la ciudad.","ar":"عنواني في وسط المدينة.","de":"Meine Adresse ist in der Innenstadt."},"tr":{"ar":"ʿunwānī fī wasaṭ al-madīna."},"uses":["city","address"]},
    {"id":"s20","text":{"en":"My birthday is in May.","fr":"Mon anniversaire est en mai.","es":"Mi cumpleaños es en mayo.","ar":"عيد ميلادي في شهر مايو.","de":"Mein Geburtstag ist im Mai."},"tr":{"ar":"ʿīd mīlādī fī shahr māyū."},"uses":["birthday"]},
    {"id":"s21","text":{"en":"My best friend is a nurse.","fr":"Ma meilleure amie est infirmière.","es":"Mi mejor amiga es enfermera.","ar":"صديقتي المقربة ممرضة.","de":"Meine beste Freundin ist Krankenschwester."},"tr":{"ar":"ṣadīqatī al-muqarraba mumarriḍa."},"uses":["nurse","friend"]},
    {"id":"s22","text":{"en":"Nice to meet you, my name is Karim.","fr":"Enchanté, je m'appelle Karim.","es":"Encantado, me llamo Karim.","ar":"تشرفت بمعرفتك، اسمي كريم.","de":"Freut mich, ich heiße Karim."},"tr":{"ar":"tasharraftu bi-maʿrifatik, ismī Karīm."},"uses":["nice_to_meet_you"]},
    {"id":"s23","text":{"en":"What is your surname?","fr":"Quel est ton nom de famille ?","es":"¿Cuál es tu apellido?","ar":"ما اسم عائلتك؟","de":"Wie ist dein Nachname?"},"tr":{"ar":"mā ism ʿāʾilatik?"},"uses":["surname"]},
    {"id":"s24","text":{"en":"My first name is Youssef and my surname is Alaoui.","fr":"Mon prénom est Youssef et mon nom de famille est Alaoui.","es":"Mi nombre es Youssef y mi apellido es Alaoui.","ar":"اسمي الأول يوسف واسم عائلتي العلوي.","de":"Mein Vorname ist Youssef und mein Nachname ist Alaoui."},"tr":{"ar":"ismī al-awwal Yūsuf wa-ism ʿāʾilatī al-ʿAlawī."},"uses":["surname","first_name"]},
    {"id":"s25","text":{"en":"My mother is a cook in a small restaurant.","fr":"Ma mère est cuisinière dans un petit restaurant.","es":"Mi madre es cocinera en un restaurante pequeño.","ar":"أمي طباخة في مطعم صغير.","de":"Meine Mutter ist Köchin in einem kleinen Restaurant."},"tr":{"ar":"ummī ṭabbākha fī maṭʿam ṣaghīr."},"uses":["cook"]},
    {"id":"s26","text":{"en":"My uncle is a shopkeeper and he lives in France.","fr":"Mon oncle est commerçant et il habite en France.","es":"Mi tío es comerciante y vive en Francia.","ar":"عمي تاجر ويسكن في فرنسا.","de":"Mein Onkel ist Händler und wohnt in Frankreich."},"tr":{"ar":"ʿammī tājir wa-yaskun fī faransā."},"uses":["shopkeeper","live","france"]},
    {"id":"s27","text":{"en":"She is a student and she speaks three languages.","fr":"Elle est étudiante et elle parle trois langues.","es":"Ella es estudiante y habla tres idiomas.","ar":"هي طالبة وتتكلم ثلاث لغات.","de":"Sie ist Studentin und spricht drei Sprachen."},"tr":{"ar":"hiya ṭāliba wa-tatakallam thalāth lughāt."},"uses":["student","study","speak","language"]},
    {"id":"s28","text":{"en":"I am an engineer, I work in Casablanca and I live with my family.","fr":"Je suis ingénieur, je travaille à Casablanca et j'habite avec ma famille.","es":"Soy ingeniero, trabajo en Casablanca y vivo con mi familia.","ar":"أنا مهندس، أعمل في الدار البيضاء وأسكن مع عائلتي.","de":"Ich bin Ingenieur, ich arbeite in Casablanca und wohne bei meiner Familie."},"tr":{"ar":"anā muhandis, aʿmal fī ad-dār al-bayḍāʾ wa-askun maʿa ʿāʾilatī."},"uses":["job","engineer","live","work"]},
    {"id":"n01","text":{"en":"My country is Morocco.","fr":"Mon pays est le Maroc.","es":"Mi país es Marruecos.","ar":"بلدي المغرب.","de":"Mein Land ist Marokko."},"tr":{"ar":"baladī al-maghrib."},"uses":["country","morocco"]},
    {"id":"n02","text":{"en":"What is your nationality?","fr":"Quelle est ta nationalité ?","es":"¿Cuál es tu nacionalidad?","ar":"ما جنسيتك؟","de":"Was ist deine Staatsangehörigkeit?"},"tr":{"ar":"mā jinsiyyatuk?"},"uses":["nationality"]},
    {"id":"n03","text":{"en":"He is a worker in France.","fr":"Il est ouvrier en France.","es":"Es obrero en Francia.","ar":"هو عامل في فرنسا.","de":"Er ist Arbeiter in Frankreich."},"tr":{"ar":"huwa ʿāmil fī faransā."},"uses":["worker","france"]},
    {"id":"n04","text":{"en":"I speak Spanish.","fr":"Je parle espagnol.","es":"Hablo español.","ar":"أتكلم الإسبانية.","de":"Ich spreche Spanisch."},"tr":{"ar":"atakallam al-isbāniyya."},"uses":["speak","spanish"]},
    {"id":"n05","text":{"en":"I live in Spain for one year.","fr":"J'habite en Espagne depuis un an.","es":"Vivo en España desde hace un año.","ar":"أسكن في إسبانيا منذ سنة.","de":"Ich wohne seit einem Jahr in Spanien."},"tr":{"ar":"askun fī isbāniyā mundhu sana."},"uses":["live","spain","year"]}
  ],
  "dialogue": ["s01","s02","s05","s06","s09","s10"]
