ony is so subtle that half the audience took him literally.","fr":"Son ironie est si subtile que la moitié du public l'a pris au pied de la lettre.","es":"Su ironía es tan sutil que la mitad del público lo tomó al pie de la letra.","ar":"سخريته الخفية دقيقة إلى حد أن نصف الجمهور أخذه على ظاهره."},"a":"es/7f42a54b0036"},"w.sense_of_humour":{"k":"w","t":"sentido del humor","g":{"en":"sense of humour","fr":"sens de l'humour","es":"sentido del humor","ar":"روح الدعابة"},"a":"es/dc13768f7d1e"}},"ex":[{"id":"a3-u07-l12-e01","type":"pick_target","item":"w.innuendo","opts":["w.parody","w.black_humour","w.burst_out_laughing","w.innuendo"]},{"id":"a3-u07-l12-e02","type":"pick_target","item":"w.laughter","opts":["w.laughter","w.punchline","w.sarcasm","w.irony"]},{"id":"a3-u07-l12-e03","type":"pick_target","item":"w.parody","opts":["w.wit","w.take_literally","w.parody","w.exaggeration"]},{"id":"a3-u07-l12-e04","type":"listen_pick","item":"w.ridiculous","opts":["w.ridiculous","w.prank","w.funny","w.awkward"]},{"id":"a3-u07-l12-e05","type":"listen_pick","item":"w.clown","opts":["w.witty","w.mock","w.clown","w.lighten_the_mood"]},{"id":"a3-u07-l12-e06","type":"match_pairs","items":["w.witty","w.sarcasm","w.irony","w.caricature","w.backfire"]},{"id":"a3-u07-l12-e07","type":"word_bank","item":"s.s27","extra":["burla","su"]},{"id":"a3-u07-l12-e08","type":"word_bank","item":"s.s11","extra":["reírse","por"]},{"id":"a3-u07-l12-e09","type":"fill_gap","item":"s.s05","gap":9,"opts":["seria","cara","público","con"]},{"id":"a3-u07-l12-e10","type":"type_answer","item":"w.sense_of_humour"}]}
