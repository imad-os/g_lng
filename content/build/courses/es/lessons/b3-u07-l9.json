{"id":"b3-u07-l9","unit":"b3-u07","level":"b3","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s16":{"k":"s","t":"¿Dónde te duele?","g":{"en":"Where does it hurt?","fr":"Où as-tu mal ?","es":"¿Dónde te duele?","ar":"أين يؤلمك؟"},"a":"es/b3-u07/s-s16"},"s.s03":{"k":"s","t":"Me duele la garganta y toso.","g":{"en":"My throat hurts and I cough.","fr":"J'ai mal à la gorge et je tousse.","es":"Me duele la garganta y toso.","ar":"يؤلمني حلقي وأسعل."},"a":"es/b3-u07/s-s03"},"s.s12":{"k":"s","t":"Toma esta medicina dos veces al día.","g":{"en":"Take this medicine twice a day.","fr":"Prends ce médicament deux fois par jour.","es":"Toma esta medicina dos veces al día.","ar":"تناول هذا الدواء مرتين في اليوم."},"a":"es/b3-u07/s-s12"},"s.s11":{"k":"s","t":"Bebe mucha agua.","g":{"en":"Drink a lot of water.","fr":"Bois beaucoup d'eau.","es":"Bebe mucha agua.","ar":"اشرب كثيرا من الماء."},"a":"es/b3-u07/s-s11"},"s.s28":{"k":"s","t":"¡Que te mejores pronto!","g":{"en":"Get well soon!","fr":"Bon rétablissement !","es":"¡Que te mejores pronto!","ar":"أتمنى لك الشفاء العاجل!"},"a":"es/b3-u07/s-s28"},"s.s04":{"k":"s","t":"Me duele el estómago.","g":{"en":"My stomach hurts.","fr":"J'ai mal au ventre.","es":"Me duele el estómago.","ar":"تؤلمني معدتي."},"a":"es/b3-u07/s-s04"},"s.s15":{"k":"s","t":"Necesito un médico, por favor.","g":{"en":"I need a doctor, please.","fr":"J'ai besoin d'un médecin, s'il vous plaît.","es":"Necesito un médico, por favor.","ar":"أحتاج إلى طبيب من فضلك."},"a":"es/b3-u07/s-s15"},"s.s18":{"k":"s","t":"Me duele un diente. No puedo comer.","g":{"en":"My tooth hurts. I cannot eat.","fr":"J'ai mal à une dent. Je ne peux pas manger.","es":"Me duele un diente. No puedo comer.","ar":"يؤلمني سني. لا أستطيع أن آكل."},"a":"es/b3-u07/s-s18"},"s.s17":{"k":"s","t":"Me duelen los ojos cuando leo.","g":{"en":"My eyes hurt when I read.","fr":"J'ai mal aux yeux quand je lis.","es":"Me duelen los ojos cuando leo.","ar":"تؤلمني عيناي عندما أقرأ."},"a":"es/b3-u07/s-s17"},"s.s21":{"k":"s","t":"Abra la boca, por favor.","g":{"en":"Open your mouth, please.","fr":"Ouvrez la bouche, s'il vous plaît.","es":"Abra la boca, por favor.","ar":"افتح فمك من فضلك."},"a":"es/b3-u07/s-s21"},"s.s06":{"k":"s","t":"Me duelen las rodillas cuando camino.","g":{"en":"My knees hurt when I walk.","fr":"J'ai mal aux genoux quand je marche.","es":"Me duelen las rodillas cuando camino.","ar":"تؤلمني ركبتاي عندما أمشي."},"a":"es/b3-u07/s-s06"},"s.s01":{"k":"s","t":"Me duele la cabeza.","g":{"en":"My head hurts.","fr":"J'ai mal à la tête.","es":"Me duele la cabeza.","ar":"يؤلمني رأسي."},"a":"es/b3-u07/s-s01"},"s.s02":{"k":"s","t":"Tengo dolor de cabeza y fiebre.","g":{"en":"I have a headache and a fever.","fr":"J'ai mal à la tête et de la fièvre.","es":"Tengo dolor de cabeza y fiebre.","ar":"أعاني من صداع وحمى."},"a":"es/b3-u07/s-s02"},"s.s25":{"k":"s","t":"Debería ir al hospital.","g":{"en":"He should go to the hospital.","fr":"Il devrait aller à l'hôpital.","es":"Debería ir al hospital.","ar":"يجب أن يذهب إلى المستشفى."},"a":"es/b3-u07/s-s25"},"s.s24":{"k":"s","t":"Sí, me siento mucho mejor.","g":{"en":"Yes, I feel much better.","fr":"Oui, je me sens beaucoup mieux.","es":"Sí, me siento mucho mejor.","ar":"نعم، أشعر أنني أفضل بكثير."},"a":"es/b3-u07/s-s24"}},"ex":[{"id":"b3-u07-l9-e01","type":"order_dialogue","items":["s.s16","s.s03","s.s12","s.s11","s.s28"]},{"id":"b3-u07-l9-e02","type":"true_false","item":"s.s04","shown":"s.s04","answer":true},{"id":"b3-u07-l9-e03","type":"true_false","item":"s.s15","shown":"s.s03","answer":false},{"id":"b3-u07-l9-e04","type":"listen_pick","item":"s.s18","opts":["s.s17","s.s18","s.s21","s.s28"]},{"id":"b3-u07-l9-e05","type":"word_bank","item":"s.s06","extra":["Sí","siento"]},{"id":"b3-u07-l9-e06","type":"word_bank","item":"s.s01","extra":["hospital","pie"]},{"id":"b3-u07-l9-e07","type":"word_bank","item":"s.s16","extra":["doler","Abra","la"]},{"id":