{"id":"b3-u07-l9","unit":"b3-u07","level":"b3","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s16":{"k":"s","t":"¿Dónde te duele?","g":{"en":"Where does it hurt?","fr":"Où as-tu mal ?","es":"¿Dónde te duele?","ar":"أين يؤلمك؟"},"a":"es/85abaf3436cb"},"s.s03":{"k":"s","t":"Me duele la garganta y toso.","g":{"en":"My throat hurts and I cough.","fr":"J'ai mal à la gorge et je tousse.","es":"Me duele la garganta y toso.","ar":"يؤلمني حلقي وأسعل."},"a":"es/a21282ce9492"},"s.s12":{"k":"s","t":"Toma esta medicina dos veces al día.","g":{"en":"Take this medicine twice a day.","fr":"Prends ce médicament deux fois par jour.","es":"Toma esta medicina dos veces al día.","ar":"تناول هذا الدواء مرتين في اليوم."},"a":"es/4f3b216a1f5a"},"s.s11":{"k":"s","t":"Bebe mucha agua.","g":{"en":"Drink a lot of water.","fr":"Bois beaucoup d'eau.","es":"Bebe mucha agua.","ar":"اشرب كثيرا من الماء."},"a":"es/d16b50b4ea84"},"s.s28":{"k":"s","t":"¡Que te mejores pronto!","g":{"en":"Get well soon!","fr":"Bon rétablissement !","es":"¡Que te mejores pronto!","ar":"أتمنى لك الشفاء العاجل!"},"a":"es/3bb9ec8ae7bb"},"s.s05":{"k":"s","t":"Me duele mucho la espalda.","g":{"en":"My back hurts a lot.","fr":"J'ai très mal au dos.","es":"Me duele mucho la espalda.","ar":"يؤلمني ظهري كثيرا."},"a":"es/cb4c83426fb5"},"s.s17":{"k":"s","t":"Me duelen los ojos cuando leo.","g":{"en":"My eyes hurt when I read.","fr":"J'ai mal aux yeux quand je lis.","es":"Me duelen los ojos cuando leo.","ar":"تؤلمني عيناي عندما أقرأ."},"a":"es/447fb5fc649c"},"s.s26":{"k":"s","t":"Tengo las piernas cansadas después del viaje.","g":{"en":"My legs are tired after the trip.","fr":"Mes jambes sont fatiguées après le voyage.","es":"Tengo las piernas cansadas después del viaje.","ar":"رجلاي متعبتان بعد الرحلة."},"a":"es/e49928bed0db"},"s.n04":{"k":"s","t":"Tiene la cara cansada.","g":{"en":"He has a tired face.","fr":"Il a le visage fatigué.","es":"Tiene la cara cansada.","ar":"وجهه متعب."},"a":"es/e502014499de"},"s.s15":{"k":"s","t":"Necesito un médico, por favor.","g":{"en":"I need a doctor, please.","fr":"J'ai besoin d'un médecin, s'il vous plaît.","es":"Necesito un médico, por favor.","ar":"أحتاج إلى طبيب من فضلك."},"a":"es/ab62fb297f90"},"s.s14":{"k":"s","t":"¿Dónde está la farmacia?","g":{"en":"Where is the pharmacy?","fr":"Où est la pharmacie ?","es":"¿Dónde está la farmacia?","ar":"أين الصيدلية؟"},"a":"es/776308f18c5b"},"s.s07":{"k":"s","t":"Le duele el pie.","g":{"en":"He has pain in his foot.","fr":"Il a mal au pied.","es":"Le duele el pie.","ar":"يشعر بألم في قدمه."},"a":"es/e220a0728d7e"},"s.s27":{"k":"s","t":"Para estar sano, come bien y duerme bien.","g":{"en":"To stay healthy, eat well and sleep well.","fr":"Pour rester en bonne santé, mange bien et dors bien.","es":"Para estar sano, come bien y duerme bien.","ar":"لتكون بصحة جيدة، كل جيدا ونم جيدا."},"a":"es/9f4b249f345f"},"s.s22":{"k":"s","t":"Me duelen el brazo y el hombro.","g":{"en":"My arm and my shoulder hurt.","fr":"J'ai mal au bras et à l'épaule.","es":"Me duelen el brazo y el hombro.","ar":"يؤلمني ذراعي وكتفي."},"a":"es/ef358583d223"},"s.s23":{"k":"s","t":"¿Te sientes mejor hoy?","g":{"en":"Do you feel better today?","fr":"Tu te sens mieux aujourd'hui ?","es":"¿Te sientes mejor hoy?","ar":"هل تشعر أنك أفضل اليوم؟"},"a":"es/445035dee06b"},"s.n02":{"k":"s","t":"Me duelen la nariz y las orejas.","g":{"en":"My nose and my ears hurt.","fr":"J'ai mal au nez et aux oreilles.","es":"Me duelen la nariz y las orejas.","ar":"يؤلمني أنفي وأذناي."},"a":"es/f937da06f056"},"s.s24":{"k":"s","t":"Sí, me siento mucho mejor.","g":{"en":"Yes, I feel much better.","fr":"Oui, je me sens beaucoup mieux.","es":"Sí, me siento mucho mejor.","ar":"نعم، أشعر أنني أفضل بكثير."},"a":"es/d00f42cd8d65"},"s.s10":{"k":"s","t":"Deberías descansar en casa.","g":{"en":"You should rest at home.","fr":"Tu devrais te reposer à la maison.","es":"Deberías descansar en casa.","ar":"يجب أن ترتاح في البيت."},"a":"es/3bb6325b2373"},"s.s01":{"k":"s","t":"Me duele la cabeza.","g":{"en":"My head hurts.","fr":"J'ai mal à la tête.","es":"Me duele la cabeza.","ar":"يؤلمني رأسي."},"a":"es/607b2edf1cb3"}},"ex":[{"id":"b3-u07-l9-e01","type":"order_dialogue","items":["s.s16","s.s03","s.s12","s.s11","s.s28"]},{"id":"b3-u07-l9-e02","type":"true_false","item":"s.s05","shown":"s.s17","answer":false},{"id":"b3-u07-l9-e03","type":"true_false","item":"s.s26","shown":"s.s17","answer":false},{"id":"b3-u07-l9-e04","type":"listen_pick","item":"s.n04","opts":["s.s15","s.n04","s.s14","s.s05"]},{"id":"b3-u07-l9-e05","type":"word_bank","item":"s.s17","extra":["Toma","esta"]},{"id":"b3-u07-l9-e06","type":"word_bank","item":"s.s07","extra":["te","sientes"]},{"id":"b3-u07-l9-e07","type":"word_bank","item":"s.s11","extra":["brazo","mejor","fiebre"]},{"id":"b3-u07-l9-e08","type":"pick_translation","item":"s.s27","opts":["s.s22","s.s23","s.s27","s.n02"]},{"id":"b3-u07-l9-e09","type":"pick_translation","item":"s.s05","opts":["s.s15","s.s24","s.s05","s.s10"]},{"id":"b3-u07-l9-e10","type":"speak","item":"s.s01"}]}
