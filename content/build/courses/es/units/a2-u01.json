{"id":"a2-u01","level":"a2","order":1,"title":{"en":"Business meetings","fr":"Les réunions d'affaires","es":"Reuniones de negocios","ar":"اجتماعات العمل"},"tip":{"en":"Meetings follow a clear order: agenda, discussion, decision, minutes. Use polite formulas such as \"Could you summarize...?\" and \"I would like to propose...\".","fr":"Une réunion suit un ordre précis : ordre du jour, discussion, décision, procès-verbal. Utilisez des formules polies comme « Pourriez-vous résumer... ? » et « Je voudrais proposer... ».","es":"Una reunión sigue un orden claro: orden del día, debate, decisión y acta. Usa fórmulas corteses como «¿Podría resumir...?» y «Querría proponer...».","ar":"يسير الاجتماع وفق ترتيب واضح: جدول أعمال ثم نقاش ثم قرار ثم محضر. استخدم صيغا مهذبة مثل «هل يمكنك تلخيص...؟» و«أود أن أقترح...»."},"words":48,"lessons":[{"id":"a2-u01-l1","type":"learn","order":1,"title":{"en":"agenda, minutes, proposal","fr":"ordre du jour, procès-verbal, proposition","es":"orden del día, acta, propuesta","ar":"جدول الأعمال، محضر الاجتماع، اقتراح"},"count":11},{"id":"a2-u01-l2","type":"learn","order":2,"title":{"en":"attendee, item, deadline","fr":"participant, point, échéance","es":"asistente, punto, plazo","ar":"حاضر، بند، موعد نهائي"},"count":10},{"id":"a2-u01-l3","type":"learn","order":3,"title":{"en":"action point, follow-up, quorum","fr":"point d'action, suivi, quorum","es":"punto de acción, seguimiento, quórum","ar":"إجراء مطلوب، متابعة، نصاب قانوني"},"count":11},{"id":"a2-u01-l4","type":"learn","order":4,"title":{"en":"schedule, update, presentation","fr":"calendrier, mise à jour, présentation","es":"calendario, actualización, presentación","ar":"جدول زمني، تحديث، عرض تقديمي"},"count":10},{"id":"a2-u01-l5","type":"learn","order":5,"title":{"en":"vote, outcome, milestone","fr":"vote, résultat, jalon","es":"votación, resultado, hito","ar":"تصويت، نتيجة، مرحلة رئيسية"},"count":11},{"id":"a2-u01-l6","type":"learn","order":6,"title":{"en":"to adjourn, to approve, to postpone","fr":"lever la séance, approuver, reporter","es":"levantar la sesión, aprobar, aplazar","ar":"رفع الجلسة، يوافق على، يؤجل"},"count":10},{"id":"a2-u01-l7","type":"learn","order":7,"title":{"en":"to propose, to schedule, to summarize","fr":"proposer, programmer, résumer","es":"proponer, programar, resumir","ar":"يقترح، يحدد موعدا، يلخص"},"count":11},{"id":"a2-u01-l8","type":"learn","order":8,"title":{"en":"to raise a point, any other business, on behalf of","fr":"soulever un point, questions diverses, au nom de","es":"plantear un punto, asuntos varios, en nombre de","ar":"يثير نقطة، أمور أخرى، نيابة عن"},"count":10},{"id":"a2-u01-l9","type":"learn","order":9,"title":{"en":"abstention, board, quarterly","fr":"abstention, conseil d'administration, trimestriel","es":"abstención, consejo de administración, trimestral","ar":"امتناع عن التصويت، مجلس الإدارة، ربع سنوي"},"count":10},{"id":"a2-u01-l10","type":"learn","order":10,"title":{"en":"punctual, confidential, attachment","fr":"ponctuel, confidentiel, pièce jointe","es":"puntual, confidencial, archivo adjunto","ar":"دقيق في المواعيد، سري، مرفق"},"count":9},{"id":"a2-u01-l11","type":"story","order":11,"title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"count":10},{"id":"a2-u01-l12","type":"review","order":12,"title":{"en":"Unit review","fr":"Révision de l'unité","es":"Repaso de la unidad","ar":"مراجعة الوحدة"},"count":10}]}
