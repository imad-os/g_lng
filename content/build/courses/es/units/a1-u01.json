{"id":"a1-u01","level":"a1","order":1,"title":{"en":"Debate","fr":"Le débat","es":"El debate","ar":"النقاش"},"tip":{"en":"Use 'although' and 'even so' to concede a point before you answer it: 'Although you are right about the cost, I still disagree.'","fr":"Utilisez « bien que » et « malgré tout » pour concéder un point avant de répondre : « Bien que vous ayez raison sur le coût, je ne suis toujours pas d'accord. »","es":"Usa «aunque» y «aun así» para conceder un punto antes de responder: «Aunque tienes razón en cuanto al coste, sigo sin estar de acuerdo.»","ar":"استعمل «رغم أن» و«مع ذلك» لتسلّم بنقطة قبل أن ترد عليها: «رغم أنك محق في التكلفة، ما زلت أخالفك الرأي.»"},"words":48,"lessons":[{"id":"a1-u01-l1","type":"learn","order":1,"title":{"en":"argument, contre-argument, opinion","fr":"argumento, contraargumento, opinión","es":"حجة, حجة مضادة, رأي","ar":"ḥujja، ḥujja muḍādda، raʾy"},"count":11},{"id":"a1-u01-l2","type":"learn","order":2,"title":{"en":"démonstration, prémisse, conclusion","fr":"demostración, premisa, conclusión","es":"برهان, مقدمة, استنتاج","ar":"burhān، muqaddima، istintāj"},"count":10},{"id":"a1-u01-l3","type":"learn","order":3,"title":{"en":"débat, polémique, dilemme","fr":"debate, polémica, dilema","es":"مناظرة, جدل, معضلة","ar":"munāẓara، jadal، muʿḍila"},"count":11},{"id":"a1-u01-l4","type":"learn","order":4,"title":{"en":"compromis, concession, objection","fr":"compromiso, concesión, objeción","es":"حل وسط, تنازل, اعتراض","ar":"ḥall wasaṭ، tanāzul، iʿtirāḍ"},"count":10},{"id":"a1-u01-l5","type":"learn","order":5,"title":{"en":"parti pris, présupposé, critique","fr":"sesgo, suposición, crítica","es":"تحيز, افتراض, نقد","ar":"taḥayyuz، iftirāḍ، naqd"},"count":11},{"id":"a1-u01-l6","type":"learn","order":6,"title":{"en":"prétendre, défendre, réfuter","fr":"alegar, defender, refutar","es":"يزعم, يدافع عن, يفنّد","ar":"yazʿum، yudāfiʿ ʿan، yufannid"},"count":10},{"id":"a1-u01-l7","type":"learn","order":7,"title":{"en":"concéder, s'opposer, contester","fr":"conceder, objetar, cuestionar","es":"يسلّم بـ, يعترض, يطعن في","ar":"yusallim bi، yaʿtariḍ، yaṭʿan fī"},"count":11},{"id":"a1-u01-l8","type":"learn","order":8,"title":{"en":"peser, clarifier, interrompre","fr":"sopesar, aclarar, interrumpir","es":"يوازن, يوضّح, يقاطع","ar":"yuwāzin، yuwaḍḍiḥ، yuqāṭiʿ"},"count":10},{"id":"a1-u01-l9","type":"learn","order":9,"title":{"en":"partial, boiteux, controversé","fr":"parcial, endeble, controvertido","es":"متحيز, معيب, مثير للجدل","ar":"mutaḥayyiz، maʿīb، muthīr lil-jadal"},"count":10},{"id":"a1-u01-l10","type":"learn","order":10,"title":{"en":"d'autre part, néanmoins, en revanche","fr":"por otro lado, sin embargo, en cambio","es":"من جهة أخرى, مع ذلك, في المقابل","ar":"min jiha ukhrā، maʿa dhālik، fī l-muqābil"},"count":9},{"id":"a1-u01-l11","type":"story","order":11,"title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"count":10},{"id":"a1-u01-l12","type":"review","order":12,"title":{"en":"Unit review","fr":"Révision de l'unité","es":"Repaso de la unidad","ar":"مراجعة الوحدة"},"count":10}]}
