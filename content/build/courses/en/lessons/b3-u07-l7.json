{"id":"b3-u07-l7","unit":"b3-u07","level":"b3","order":7,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s16":{"k":"s","t":"Where does it hurt?","g":{"en":"Where does it hurt?","fr":"Où as-tu mal ?","es":"¿Dónde te duele?","ar":"أين يؤلمك؟"},"a":"en/b3-u07/s-s16"},"s.s03":{"k":"s","t":"My throat hurts and I cough.","g":{"en":"My throat hurts and I cough.","fr":"J'ai mal à la gorge et je tousse.","es":"Me duele la garganta y toso.","ar":"يؤلمني حلقي وأسعل."},"a":"en/b3-u07/s-s03"},"s.s12":{"k":"s","t":"Take this medicine twice a day.","g":{"en":"Take this medicine twice a day.","fr":"Prends ce médicament deux fois par jour.","es":"Toma esta medicina dos veces al día.","ar":"تناول هذا الدواء مرتين في اليوم."},"a":"en/b3-u07/s-s12"},"s.s11":{"k":"s","t":"Drink a lot of water.","g":{"en":"Drink a lot of water.","fr":"Bois beaucoup d'eau.","es":"Bebe mucha agua.","ar":"اشرب كثيرا من الماء."},"a":"en/b3-u07/s-s11"},"s.s28":{"k":"s","t":"Get well soon!","g":{"en":"Get well soon!","fr":"Bon rétablissement !","es":"¡Que te mejores pronto!","ar":"أتمنى لك الشفاء العاجل!"},"a":"en/b3-u07/s-s28"},"s.s21":{"k":"s","t":"Open your mouth, please.","g":{"en":"Open your mouth, please.","fr":"Ouvrez la bouche, s'il vous plaît.","es":"Abra la boca, por favor.","ar":"افتح فمك من فضلك."},"a":"en/b3-u07/s-s21"},"s.s13":{"k":"s","t":"Take one pill before breakfast.","g":{"en":"Take one pill before breakfast.","fr":"Prends un comprimé avant le petit-déjeuner.","es":"Toma una pastilla antes del desayuno.","ar":"تناول حبة دواء قبل الفطور."},"a":"en/b3-u07/s-s13"},"s.s07":{"k":"s","t":"He has pain in his foot.","g":{"en":"He has pain in his foot.","fr":"Il a mal au pied.","es":"Le duele el pie.","ar":"يشعر بألم في قدمه."},"a":"en/b3-u07/s-s07"},"s.s02":{"k":"s","t":"I have a headache and a fever.","g":{"en":"I have a headache and a fever.","fr":"J'ai mal à la tête et de la fièvre.","es":"Tengo dolor de cabeza y fiebre