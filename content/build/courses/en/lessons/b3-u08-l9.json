{"id":"b3-u08-l9","unit":"b3-u08","level":"b3","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s23":{"k":"s","t":"Can I help you?","g":{"en":"Can I help you?","fr":"Puis-je vous aider ?","es":"¿Puedo ayudarle?","ar":"هل يمكنني مساعدتك؟"},"a":"en/a9e5aa3c5301"},"s.s02":{"k":"s","t":"I would like to buy these trousers.","g":{"en":"I would like to buy these trousers.","fr":"Je voudrais acheter ce pantalon.","es":"Quisiera comprar este pantalón.","ar":"أود أن أشتري هذا البنطال."},"a":"en/baa828f3ad8d"},"s.s03":{"k":"s","t":"How much does it cost?","g":{"en":"How much does it cost?","fr":"Combien ça coûte ?","es":"¿Cuánto cuesta?","ar":"بكم هذا؟"},"a":"en/937807866f02"},"s.s11":{"k":"s","t":"Can I pay by card?","g":{"en":"Can I pay by card?","fr":"Puis-je payer par carte ?","es":"¿Puedo pagar con tarjeta?","ar":"هل يمكنني الدفع بالبطاقة؟"},"a":"en/164caa75f64e"},"s.s28":{"k":"s","t":"Thank you, have a nice day!","g":{"en":"Thank you, have a nice day!","fr":"Merci, bonne journée !","es":"¡Gracias, que tenga un buen día!","ar":"شكرا، أتمنى لك يوما سعيدا!"},"a":"en/ed7dda126d83"},"s.s22":{"k":"s","t":"Thank you, you are very kind.","g":{"en":"Thank you, you are very kind.","fr":"Merci, vous êtes très aimable.","es":"Gracias, es usted muy amable.","ar":"شكرا، أنت لطيف جدا."},"a":"en/dc799a098e85"},"s.s05":{"k":"s","t":"Is there a discount?","g":{"en":"Is there a discount?","fr":"Y a-t-il une réduction ?","es":"¿Hay algún descuento?","ar":"هل يوجد خصم؟"},"a":"en/1a351b8f2577"},"s.n01":{"k":"s","t":"What is the price, please?","g":{"en":"What is the price, please?","fr":"Quel est le prix, s'il vous plaît ?","es":"¿Cuál es el precio, por favor?","ar":"ما السعر من فضلك؟"},"a":"en/4e701d546512"},"s.s07":{"k":"s","t":"Can I try it on?","g":{"en":"Can I try it on?","fr":"Puis-je l'essayer ?","es":"¿Puedo probármelo?","ar":"هل يمكنني أن أجربه؟"},"a":"en/4daffa60a919"},"s.s17":{"k":"s","t":"Could y