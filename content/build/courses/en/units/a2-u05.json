{"id":"a2-u05","level":"a2","order":5,"title":{"en":"Economy","fr":"L'économie","es":"La economía","ar":"الاقتصاد"},"tip":{"en":"To describe a graph, combine a verb with an adverb: \"rose sharply\", \"fell gradually\", \"remained steady\". Say what happened, how fast, and how much.","fr":"Pour décrire un graphique, associez un verbe et un adverbe : « a fortement augmenté », « a progressivement baissé », « est resté stable ». Dites ce qui s'est passé, à quelle vitesse et de combien.","es":"Para describir un gráfico, combina un verbo con un adverbio: «subió bruscamente», «bajó gradualmente», «se mantuvo constante». Indica qué ocurrió, con qué rapidez y en qué medida.","ar":"لوصف رسم بياني اجمع بين فعل وظرف: «ارتفع بشكل حاد» و«انخفض تدريجيا» و«ظل مطردا». اذكر ما حدث وسرعته ومقداره."},"words":48,"lessons":[{"id":"a2-u05-l1","type":"learn","order":1,"title":{"en":"economy, growth, inflation","fr":"économie, croissance, inflation","es":"economía, crecimiento, inflación","ar":"اقتصاد، نمو، تضخم"},"count":11},{"id":"a2-u05-l2","type":"learn","order":2,"title":{"en":"interest rate, exchange rate, supply","fr":"taux d'intérêt, taux de change, offre","es":"tipo de interés, tipo de cambio, oferta","ar":"سعر الفائدة، سعر الصرف، العرض"},"count":10},{"id":"a2-u05-l3","type":"learn","order":3,"title":{"en":"GDP, deficit, surplus","fr":"PIB, déficit, excédent","es":"PIB, déficit, superávit","ar":"الناتج المحلي الإجمالي، عجز، فائض"},"count":11},{"id":"a2-u05-l4","type":"learn","order":4,"title":{"en":"tax, subsidy, trade","fr":"impôt, subvention, commerce","es":"impuesto, subvención, comercio","ar":"ضريبة، إعانة، تجارة"},"count":10},{"id":"a2-u05-l5","type":"learn","order":5,"title":{"en":"consumer, productivity, forecast","fr":"consommateur, productivité, prévision","es":"consumidor, productividad, previsión","ar":"مستهلك، إنتاجية، توقع"},"count":11},{"id":"a2-u05-l6","type":"learn","order":6,"title":{"en":"peak, decline, fluctuation","fr":"pic, baisse, fluctuation","es":"pico, descenso, fluctuación","ar":"ذروة، تراجع، تقلب"},"count":10},{"id":"a2-u05-l7","type":"learn","order":7,"title":{"en":"to increase, to decrease, to stabilize","fr":"augmenter, diminuer, se stabiliser","es":"aumentar, disminuir, estabilizarse","ar":"يزداد، يتناقص، يستقر"},"count":11},{"id":"a2-u05-l8","type":"learn","order":8,"title":{"en":"gradually, steady, volatile","fr":"progressivement, stable, volatil","es":"gradualmente, constante, volátil","ar":"تدريجيا، مطرد، متقلب"},"count":10},{"id":"a2-u05-l9","type":"learn","order":9,"title":{"en":"monopoly, competition, wage","fr":"monopole, concurrence, salaire","es":"monopolio, competencia, salario","ar":"احتكار، منافسة، أجر"},"count":10},{"id":"a2-u05-l10","type":"learn","order":10,"title":{"en":"central bank, currency, crisis","fr":"banque centrale, monnaie, crise","es":"banco central, moneda, crisis","ar":"بنك مركزي، عملة، أزمة"},"count":9},{"id":"a2-u05-l11","type":"story","order":11,"title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"count":10},{"id":"a2-u05-l12","type":"review","order":12,"title":{"en":"Unit review","fr":"Révision de l'unité","es":"Repaso de la unidad","ar":"مراجعة الوحدة"},"count":10}]}
