ḍ"},"a":"fr/a1-u01/w-rebuttal"},"w.claim":{"k":"w","t":"afirmación","g":{"en":"affirmation","fr":"afirmación","es":"ادعاء","ar":"idiʿāʾ"},"a":"fr/a1-u01/w-claim"},"w.stance":{"k":"w","t":"postura firme","g":{"en":"prise de position","fr":"postura firme","es":"توجه","ar":"tawajjuh"},"a":"fr/a1-u01/w-stance"},"w.valid":{"k":"w","t":"válido","g":{"en":"valable","fr":"válido","es":"وجيه","ar":"wajīh"},"a":"fr/a1-u01/w-valid"},"w.concession":{"k":"w","t":"concesión","g":{"en":"concession","fr":"concesión","es":"تنازل","ar":"tanāzul"},"a":"fr/a1-u01/w-concession"},"w.dilemma":{"k":"w","t":"dilema","g":{"en":"dilemme","fr":"dilema","es":"معضلة","ar":"muʿḍila"},"a":"fr/a1-u01/w-dilemma"},"w.proof":{"k":"w","t":"demostración","g":{"en":"démonstration","fr":"demostración","es":"برهان","ar":"burhān"},"a":"fr/a1-u01/w-proof"},"w.in contrast":{"k":"w","t":"en cambio","g":{"en":"en revanche","fr":"en cambio","es":"في المقابل","ar":"fī l-muqābil"},"a":"fr/a1-u01/w-in contrast"},"w.biased":{"k":"w","t":"parcial","g":{"en":"partial","fr":"parcial","es":"متحيز","ar":"mutaḥayyiz"},"a":"fr/a1-u01/w-biased"},"w.position":{"k":"w","t":"postura","g":{"en":"position","fr":"postura","es":"موقف","ar":"mawqif"},"a":"fr/a1-u01/w-position"},"w.moreover":{"k":"w","t":"además","g":{"en":"de plus","fr":"además","es":"علاوة على ذلك","ar":"ʿilāwatan ʿalā dhālik"},"a":"fr/a1-u01/w-moreover"},"w.fallacy":{"k":"w","t":"falacia","g":{"en":"sophisme","fr":"falacia","es":"مغالطة","ar":"mughālaṭa"},"a":"fr/a1-u01/w-fallacy"},"w.to interrupt":{"k":"w","t":"interrumpir","g":{"en":"interrompre","fr":"interrumpir","es":"يقاطع","ar":"yuqāṭiʿ"},"a":"fr/a1-u01/w-to interrupt"},"w.conclusion":{"k":"w","t":"conclusión","g":{"en":"conclusion","fr":"conclusión","es":"استنتاج","ar":"istintāj"},"a":"fr/a1-u01/w-conclusion"},"w.flawed":{"k":"w","t":"endeble","g":{"en":"boiteux","fr":"endeble","es":"معيب","ar":"maʿīb"},"a":"fr/a1-u01/w-flawed"},"w.controversy":{"k":"w","t":"polémica","g":{"en":"polémique","fr":"polémica"