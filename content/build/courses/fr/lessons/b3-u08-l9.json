{"id":"b3-u08-l9","unit":"b3-u08","level":"b3","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s23":{"k":"s","t":"Puis-je vous aider ?","g":{"en":"Can I help you?","fr":"Puis-je vous aider ?","es":"¿Puedo ayudarle?","ar":"هل يمكنني مساعدتك؟"},"a":"fr/b3-u08/s-s23"},"s.s02":{"k":"s","t":"Je voudrais acheter ce pantalon.","g":{"en":"I would like to buy these trousers.","fr":"Je voudrais acheter ce pantalon.","es":"Quisiera comprar este pantalón.","ar":"أود أن أشتري هذا البنطال."},"a":"fr/b3-u08/s-s02"},"s.s03":{"k":"s","t":"Combien ça coûte ?","g":{"en":"How much does it cost?","fr":"Combien ça coûte ?","es":"¿Cuánto cuesta?","ar":"بكم هذا؟"},"a":"fr/b3-u08/s-s03"},"s.s11":{"k":"s","t":"Puis-je payer par carte ?","g":{"en":"Can I pay by card?","fr":"Puis-je payer par carte ?","es":"¿Puedo pagar con tarjeta?","ar":"هل يمكنني الدفع بالبطاقة؟"},"a":"fr/b3-u08/s-s11"},"s.s28":{"k":"s","t":"Merci, bonne journée !","g":{"en":"Thank you, have a nice day!","fr":"Merci, bonne journée !","es":"¡Gracias, que tenga un buen día!","ar":"شكرا، أتمنى لك يوما سعيدا!"},"a":"fr/b3-u08/s-s28"},"s.s12":{"k":"s","t":"Désolé, nous n'acceptons que les espèces.","g":{"en":"Sorry, we only take cash.","fr":"Désolé, nous n'acceptons que les espèces.","es":"Lo siento, solo aceptamos efectivo.","ar":"آسف، نقبل الدفع نقدا فقط."},"a":"fr/b3-u08/s-s12"},"s.s16":{"k":"s","t":"Le magasin ferme à sept heures du soir.","g":{"en":"The shop closes at seven in the evening.","fr":"Le magasin ferme à sept heures du soir.","es":"La tienda cierra a las siete de la tarde.","ar":"يغلق المتجر في الساعة السابعة مساء."},"a":"fr/b3-u08/s-s16"},"s.s17":{"k":"s","t":"Pourriez-vous me le livrer chez moi ?","g":{"en":"Could you bring it to my house?","fr":"Pourriez-vous me le livrer chez moi ?","es":"¿Podría traerlo a mi casa?","ar":"هل يمكنك أن تحضره إلى بيتي؟"},"a":"fr/b3-u08/s-s17"},"s.s18":{"k":"s","t":"Y a-t-il un supermarché près d'ici ?","g":{"en":"Is there a supermarket near here?","fr":"Y a-t-il un supermarché près d'ici ?","es":"¿Hay un supermercado cerca de aquí?","ar":"هل يوجد سوبرماركت قريب من هنا؟"},"a":"fr/b3-u08/s-s18"},"s.s06":{"k":"s","t":"Pourriez-vous m'en montrer un autre, s'il vous plaît ?","g":{"en":"Could you show me another one, please?","fr":"Pourriez-vous m'en montrer un autre, s'il vous plaît ?","es":"¿Podría enseñarme otro, por favor?","ar":"هل يمكنك أن تريني واحدا آخر من فضلك؟"},"a":"fr/b3-u08/s-s06"},"s.s21":{"k":"s","t":"Ils vendent du bon pain ici.","g":{"en":"They sell good bread here.","fr":"Ils vendent du bon pain ici.","es":"Aquí venden buen pan.","ar":"يبيعون هنا خبزا جيدا."},"a":"fr/b3-u08/s-s21"},"s.s22":{"k":"s","t":"Merci, vous êtes très aimable.","g":{"en":"Thank you, you are very kind.","fr":"Merci, vous êtes très aimable.","es":"Gracias, es usted muy amable.","ar":"شكرا، أنت لطيف جدا."},"a":"fr/b3-u08/s-s22"},"s.s14":{"k":"s","t":"Pourriez-vous me donner le reçu, s'il vous plaît ?","g":{"en":"Could you give me the receipt, please?","fr":"Pourriez-vous me donner le reçu, s'il vous plaît ?","es":"¿Podría darme el recibo, por favor?","ar":"هل يمكنك أن تعطيني الإيصال من فضلك؟"},"a":"fr/b3-u08/s-s14"},"s.s05":{"k":"s","t":"Y a-t-il une réduction ?","g":{"en":"Is there a discount?","fr":"Y a-t-il une réduction ?","es":"¿Hay algún descuento?","ar":"هل يوجد خصم؟"},"a":"fr/b3-u08/s-s05"},"s.s07":{"k":"s","t":"Puis-je l'essayer ?","g":{"en":"Can I try it on?","fr":"Puis-je l'essayer ?","es":"¿Puedo probármelo?","ar":"هل يمكنني أن أجربه؟"},"a":"fr/b3-u08/s-s07"}},"ex":[{"id":"b3-u08-l9-e01","type":"order_dialogue","items":["s.s23","s.s02","s.s03","s.s11","s.s28"]},{"id":"b3-u08-l9-e02","type":"true_false","item":"s.s23","shown":"s.s23","answer":true},{"id":"b3-u08-l9-e03","type":"true_false","item":"s.s12","shown":"s.s16","answer":false},{"id":"b3-u08-l9-e04","type":"listen_pick","item":"s.s17","opts":["s.s17","s.s18","s.s06","s.s28"]},{"id":"b3-u08-l9-e05","type