{"id":"b3-u04-l9","unit":"b3-u04","level":"b3","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s13":{"k":"s","t":"Peux-tu m'aider, s'il te plaît ?","g":{"en":"Can you help me, please?","fr":"Peux-tu m'aider, s'il te plaît ?","es":"¿Puedes ayudarme, por favor?","ar":"هل تستطيع أن تساعدني من فضلك؟"},"a":"fr/b3-u04/s-s13"},"s.s14":{"k":"s","t":"Bien sûr. De quoi as-tu besoin ?","g":{"en":"Of course. What do you need?","fr":"Bien sûr. De quoi as-tu besoin ?","es":"Claro. ¿Qué necesitas?","ar":"طبعا. ماذا تحتاج؟"},"a":"fr/b3-u04/s-s14"},"s.s15":{"k":"s","t":"Je ne comprends pas ce mot.","g":{"en":"I do not understand this word.","fr":"Je ne comprends pas ce mot.","es":"No entiendo esta palabra.","ar":"لا أفهم هذه الكلمة."},"a":"fr/b3-u04/s-s15"},"s.s16":{"k":"s","t":"Que veut dire ce mot ?","g":{"en":"What does this word mean?","fr":"Que veut dire ce mot ?","es":"¿Qué significa esta palabra?","ar":"ماذا تعني هذه الكلمة؟"},"a":"fr/b3-u04/s-s16"},"s.s21":{"k":"s","t":"Sais-tu la réponse ?","g":{"en":"Do you know the answer?","fr":"Sais-tu la réponse ?","es":"¿Sabes la respuesta?","ar":"هل تعرف الجواب؟"},"a":"fr/b3-u04/s-s21"},"s.s02":{"k":"s","t":"Qui est cet homme ?","g":{"en":"Who is that man?","fr":"Qui est cet homme ?","es":"¿Quién es ese hombre?","ar":"من هذا الرجل؟"},"a":"fr/b3-u04/s-s02"},"s.s25":{"k":"s","t":"Désolé, je ne sais pas.","g":{"en":"Sorry, I do not know.","fr":"Désolé, je ne sais pas.","es":"Lo siento, no lo sé.","ar":"آسف، لا أعرف."},"a":"fr/b3-u04/s-s25"},"s.s17":{"k":"s","t":"Pouvez-vous répéter, s'il vous plaît ?","g":{"en":"Can you repeat that, please?","fr":"Pouvez-vous répéter, s'il vous plaît ?","es":"¿Puede repetir, por favor?","ar":"هل يمكنك أن تكرر من فضلك؟"},"a":"fr/b3-u04/s-s17"},"s.s20":{"k":"s","t":"Oui, un peu. Cette langue n'est pas facile.","g":{"en":"Yes, a little. This language is not easy.","fr":"Oui, un peu. Cette langue n'est pas facile.","es":"