{"id":"b1-u03-l5","unit":"b1-u03","level":"b1","order":5,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s03":{"k":"s","t":"Wie viele Brüder hast du?","g":{"en":"How many brothers do you have?","fr":"Combien de frères as-tu ?","es":"¿Cuántos hermanos tienes?","ar":"كم أخا عندك؟"},"a":"de/b1-u03/s-s03"},"s.s01":{"k":"s","t":"Ich habe drei Brüder.","g":{"en":"I have three brothers.","fr":"J'ai trois frères.","es":"Tengo tres hermanos.","ar":"عندي ثلاثة إخوة."},"a":"de/b1-u03/s-s01"},"s.s12":{"k":"s","t":"Und du?","g":{"en":"And you?","fr":"Et toi ?","es":"¿Y tú?","ar":"وأنت؟"},"a":"de/b1-u03/s-s12"},"s.s02":{"k":"s","t":"Ich habe eine Schwester.","g":{"en":"I have one sister.","fr":"J'ai une sœur.","es":"Tengo una hermana.","ar":"عندي أخت واحدة."},"a":"de/b1-u03/s-s02"},"s.s05":{"k":"s","t":"Vier Brüder und eine Schwester.","g":{"en":"Four brothers and one sister.","fr":"Quatre frères et une sœur.","es":"Cuatro hermanos y una hermana.","ar":"أربعة إخوة وأخت واحدة."},"a":"de/b1-u03/s-s05"},"s.s10":{"k":"s","t":"Wie viele Schwestern? Zwei.","g":{"en":"How many sisters? Two.","fr":"Combien de sœurs ? Deux.","es":"¿Cuántas hermanas? Dos.","ar":"كم أختا؟ اثنتان."},"a":"de/b1-u03/s-s10"},"s.s09":{"k":"s","t":"Neun und eins sind zehn.","g":{"en":"Nine and one are ten.","fr":"Neuf et un font dix.","es":"Nueve y uno son diez.","ar":"تسعة وواحد عشرة."},"a":"de/b1-u03/s-s09"},"s.s06":{"k":"s","t":"Zwei, bitte.","g":{"en":"Two, please.","fr":"Deux, s'il vous plaît.","es":"Dos, por favor.","ar":"اثنان من فضلك."},"a":"de/b1-u03/s-s06"},"s.s07":{"k":"s","t":"Fünf und fünf sind zehn.","g":{"en":"Five and five are ten.","fr":"Cinq et cinq font dix.","es":"Cinco y cinco son diez.","ar":"خمسة وخمسة عشرة."},"a":"de/b1-u03/s-s07"},"s.s08":{"k":"s","t":"Null ist nicht eins.","g":{"en":"Zero is not one.","fr":"Zéro n'est pas un.","es":"Cero no es uno.","ar":"الصفر ليس واحدا."},"a":"de/b1-u03/s-s08"},"s.s13":{"k":"s