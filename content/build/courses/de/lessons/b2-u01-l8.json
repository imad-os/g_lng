{"id":"b2-u01-l8","unit":"b2-u01","level":"b2","order":8,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s01":{"k":"s","t":"Wie heißt du?","g":{"en":"What is your name?","fr":"Comment tu t'appelles ?","es":"¿Cómo te llamas?","ar":"ما اسمك؟"},"a":"de/b2-u01/s-s01"},"s.s02":{"k":"s","t":"Ich heiße Sara.","g":{"en":"My name is Sara.","fr":"Je m'appelle Sara.","es":"Me llamo Sara.","ar":"اسمي سارة."},"a":"de/b2-u01/s-s02"},"s.s05":{"k":"s","t":"Woher kommst du?","g":{"en":"Where are you from?","fr":"D'où viens-tu ?","es":"¿De dónde eres?","ar":"من أين أنت؟"},"a":"de/b2-u01/s-s05"},"s.s06":{"k":"s","t":"Ich komme aus Marokko.","g":{"en":"I am from Morocco.","fr":"Je viens du Maroc.","es":"Soy de Marruecos.","ar":"أنا من المغرب."},"a":"de/b2-u01/s-s06"},"s.s09":{"k":"s","t":"Was machst du beruflich?","g":{"en":"What is your job?","fr":"Quel est ton métier ?","es":"¿A qué te dedicas?","ar":"ماذا تعمل؟"},"a":"de/b2-u01/s-s09"},"s.s10":{"k":"s","t":"Ich bin Lehrer.","g":{"en":"I am a teacher.","fr":"Je suis professeur.","es":"Soy profesor.","ar":"أنا مدرس."},"a":"de/b2-u01/s-s10"},"s.s23":{"k":"s","t":"Wie ist dein Nachname?","g":{"en":"What is your surname?","fr":"Quel est ton nom de famille ?","es":"¿Cuál es tu apellido?","ar":"ما اسم عائلتك؟"},"a":"de/b2-u01/s-s23"},"s.s27":{"k":"s","t":"Sie ist Studentin und spricht drei Sprachen.","g":{"en":"She is a student and she speaks three languages.","fr":"Elle est étudiante et elle parle trois langues.","es":"Ella es estudiante y habla tres idiomas.","ar":"هي طالبة وتتكلم ثلاث لغات."},"a":"de/b2-u01/s-s27"},"s.s28":{"k":"s","t":"Ich bin Ingenieur, ich arbeite in Casablanca und wohne bei meiner Familie.","g":{"en":"I am an engineer, I work in Casablanca and I live with my family.","fr":"Je suis ingénieur, je travaille à Casablanca et j'habite avec ma famille.","es":"Soy ingeniero, trabajo en Casablanca y vivo con mi familia.","ar":"أنا مهندس، أعمل في الدار البيضاء وأسكن مع عائلتي."},"a":"de/b2-u01/s-s28"},"s.s13":{"k":"s","t":"Ich studiere Englisch an der Universität.","g":{"en":"I study English at the university.","fr":"J'étudie l'anglais à l'université.","es":"Estudio inglés en la universidad.","ar":"أدرس الإنجليزية في الجامعة."},"a":"de/b2-u01/s-s13"},"s.s14":{"k":"s","t":"Sprichst du Französisch?","g":{"en":"Do you speak French?","fr":"Parles-tu français ?","es":"¿Hablas francés?","ar":"هل تتكلم الفرنسية؟"},"a":"de/b2-u01/s-s14"},"s.s25":{"k":"s","t":"Meine Mutter ist Köchin in einem kleinen Restaurant.","g":{"en":"My mother is a cook in a small restaurant.","fr":"Ma mère est cuisinière dans un petit restaurant.","es":"Mi madre es cocinera en un restaurante pequeño.","ar":"أمي طباخة في مطعم صغير."},"a":"de/b2-u01/s-s25"},"s.s08":{"k":"s","t":"Ich wohne in einer großen Stadt.","g":{"en":"I live in a big city.","fr":"J'habite dans une grande ville.","es":"Vivo en una ciudad grande.","ar":"أسكن في مدينة كبيرة."},"a":"de/b2-u01/s-s08"},"s.s03":{"k":"s","t":"Wie alt bist du?","g":{"en":"How old are you?","fr":"Quel âge as-tu ?","es":"¿Cuántos años tienes?","ar":"كم عمرك؟"},"a":"de/b2-u01/s-s03"},"s.s22":{"k":"s","t":"Freut mich, ich heiße Karim.","g":{"en":"Nice to meet you, my name is Karim.","fr":"Enchanté, je m'appelle Karim.","es":"Encantado, me llamo Karim.","ar":"تشرفت بمعرفتك، اسمي كريم."},"a":"de/b2-u01/s-s22"},"s.s15":{"k":"s","t":"Ja, ich spreche Arabisch und ein bisschen Französisch.","g":{"en":"Yes, I speak Arabic and a little French.","fr":"Oui, je parle arabe et un peu de français.","es":"Sí, hablo árabe y un poco de francés.","ar":"نعم، أتكلم العربية وقليلا من الفرنسية."},"a":"de/b2-u01/s-s15"},"s.s19":{"k":"s","t":"Meine Adresse ist in der Innenstadt.","g":{"en":"My address is in the city centre.","fr":"Mon adresse est dans le centre-ville.","es":"Mi dirección está en el centro de la ciudad.","ar":"عنواني في وسط المدينة."},"a":"de/b2-u01/s-s19"},"s.s21":{"k":"s","t":"Meine beste Freundin ist Krankenschwester.","g":{"en":"My best friend is a nurse.","fr":"Ma meilleure amie est infirmière.","es":"Mi mejor amiga es enfermera.","ar":"صديقتي المقربة ممرضة."},"a":"de/b2-u01/s-s21"},"s.s11":{"k":"s","t":"Mein Bruder ist Arzt.","g":{"en":"My brother is a doctor.","fr":"Mon frère est médecin.","es":"Mi hermano es médico.","ar":"أخي طبيب."},"a":"de/b2-u01/s-s11"},"s.s16":{"k":"s","t":"Bist du verheiratet oder ledig?","g":{"en":"Are you married or single?","fr":"Es-tu marié ou célibataire ?","es":"¿Estás casado o soltero?","ar":"هل أنت متزوج أم أعزب؟"},"a":"de/b2-u01/s-s16"}},"ex":[{"id":"b2-u01-l8-e01","type":"order_dialogue","items":["s.s01","s.s02","s.s05","s.s06","s.s09","s.s10"]},{"id":"b2-u01-l8-e02","type":"true_false","item":"s.s02","shown":"s.s02","answer":true},{"id":"b2-u01-l8-e03","type":"true_false","item":"s.s23","shown":"s.s23","answer":true},{"id":"b2-u01-l8-e04","type":"true_false","item":"s.s27","shown":"s.s27","answer":true},{"id":"b2-u01-l8-e05","type":"listen_pick","item":"s.s28","opts":["s.s28","s.s13","s.s14","s.s25"]},{"id":"b2-u01-l8-e06","type":"listen_pick","item":"s.s01","opts":["s.s08","s.s01","s.s03","s.s10"]},{"id":"b2-u01-l8-e07","type":"word_bank","item":"s.s22","extra":["sprechen","der"]},{"id":"b2-u01-l8-e08","type":"word_bank","item":"s.s15","extra":["die","Telefonnummer"]},{"id":"b2-u01-l8-e09","type":"word_bank","item":"s.s19","extra":["Frankreich","Wie"]},{"id":"b2-u01-l8-e10","type":"pick_translation","item":"s.s19","opts":["s.s21","s.s19","s.s09","s.s11"]},{"id":"b2-u01-l8-e11","type":"pick_translation","item":"s.s22","opts":["s.s16","s.s22","s.s09","s.s27"]}]}
