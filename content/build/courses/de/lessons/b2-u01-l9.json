{"id":"b2-u01-l9","unit":"b2-u01","level":"b2","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s01":{"k":"s","t":"Wie heißt du?","g":{"en":"What is your name?","fr":"Comment tu t'appelles ?","es":"¿Cómo te llamas?","ar":"ما اسمك؟"},"a":"de/a3f0ca3f2b5d"},"s.s02":{"k":"s","t":"Ich heiße Sara.","g":{"en":"My name is Sara.","fr":"Je m'appelle Sara.","es":"Me llamo Sara.","ar":"اسمي سارة."},"a":"de/1ceb81ae8ed1"},"s.s05":{"k":"s","t":"Woher kommst du?","g":{"en":"Where are you from?","fr":"D'où viens-tu ?","es":"¿De dónde eres?","ar":"من أين أنت؟"},"a":"de/84072b16bad9"},"s.s06":{"k":"s","t":"Ich komme aus Marokko.","g":{"en":"I am from Morocco.","fr":"Je viens du Maroc.","es":"Soy de Marruecos.","ar":"أنا من المغرب."},"a":"de/2bcac3c893d1"},"s.s09":{"k":"s","t":"Was machst du beruflich?","g":{"en":"What is your job?","fr":"Quel est ton métier ?","es":"¿A qué te dedicas?","ar":"ماذا تعمل؟"},"a":"de/e3d28a332420"},"s.s10":{"k":"s","t":"Ich bin Lehrer.","g":{"en":"I am a teacher.","fr":"Je suis professeur.","es":"Soy profesor.","ar":"أنا مدرس."},"a":"de/d866eb0fdca1"},"s.s13":{"k":"s","t":"Ich studiere Englisch an der Universität.","g":{"en":"I study English at the university.","fr":"J'étudie l'anglais à l'université.","es":"Estudio inglés en la universidad.","ar":"أدرس الإنجليزية في الجامعة."},"a":"de/1f46d94a87e7"},"s.s14":{"k":"s","t":"Sprichst du Französisch?","g":{"en":"Do you speak French?","fr":"Parles-tu français ?","es":"¿Hablas francés?","ar":"هل تتكلم الفرنسية؟"},"a":"de/a5d40284395a"},"s.s08":{"k":"s","t":"Ich wohne in einer großen Stadt.","g":{"en":"I live in a big city.","fr":"J'habite dans une grande ville.","es":"Vivo en una ciudad grande.","ar":"أسكن في مدينة كبيرة."},"a":"de/a8b718c5b8cb"},"s.s11":{"k":"s","t":"Mein Bruder ist Arzt.","g":{"en":"My brother is a doctor.","fr":"Mon frère est médecin.","es":"Mi hermano es médico.","ar":"أخي طبيب."},"a":"de/4c2904cec873"},"