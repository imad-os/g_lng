{"id":"b1-u03-l4","unit":"b1-u03","level":"b1","order":4,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s03":{"k":"s","t":"Wie viele Brüder hast du?","g":{"en":"How many brothers do you have?","fr":"Combien de frères as-tu ?","es":"¿Cuántos hermanos tienes?","ar":"كم أخا عندك؟"},"a":"de/449a6907f2c2"},"s.s01":{"k":"s","t":"Ich habe drei Brüder.","g":{"en":"I have three brothers.","fr":"J'ai trois frères.","es":"Tengo tres hermanos.","ar":"عندي ثلاثة إخوة."},"a":"de/285a06a9e265"},"s.s12":{"k":"s","t":"Und du?","g":{"en":"And you?","fr":"Et toi ?","es":"¿Y tú?","ar":"وأنت؟"},"a":"de/7bc214697d22"},"s.s02":{"k":"s","t":"Ich habe eine Schwester.","g":{"en":"I have one sister.","fr":"J'ai une sœur.","es":"Tengo una hermana.","ar":"عندي أخت واحدة."},"a":"de/bdf39fbced68"},"s.s08":{"k":"s","t":"Null ist nicht eins.","g":{"en":"Zero is not one.","fr":"Zéro n'est pas un.","es":"Cero no es uno.","ar":"الصفر ليس واحدا."},"a":"de/8ad4fbc9442d"},"s.s13":{"k":"s","t":"Eins, zwei, drei!","g":{"en":"One, two, three!","fr":"Un, deux, trois !","es":"¡Uno, dos, tres!","ar":"واحد، اثنان، ثلاثة!"},"a":"de/cb62f8918ad4"},"s.s05":{"k":"s","t":"Vier Brüder und eine Schwester.","g":{"en":"Four brothers and one sister.","fr":"Quatre frères et une sœur.","es":"Cuatro hermanos y una hermana.","ar":"أربعة إخوة وأخت واحدة."},"a":"de/4b47a3819ef6"},"s.s07":{"k":"s","t":"Fünf und fünf sind zehn.","g":{"en":"Five and five are ten.","fr":"Cinq et cinq font dix.","es":"Cinco y cinco son diez.","ar":"خمسة وخمسة عشرة."},"a":"de/79b4f81ef116"},"s.s04":{"k":"s","t":"Zwei und drei sind fünf.","g":{"en":"Two and three are five.","fr":"Deux et trois font cinq.","es":"Dos y tres son cinco.","ar":"اثنان وثلاثة خمسة."},"a":"de/202c9555210a"},"s.s11":{"k":"s","t":"Sechs, sieben, acht.","g":{"en":"Six, seven, eight.","fr":"Six, sept, huit.","es":"Seis, siete, ocho.","ar":"ستة، سبعة، ثمانية."},"a":"de/bab52bc27990"},"s.s06":{"k":"s","t