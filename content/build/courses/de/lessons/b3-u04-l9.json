{"id":"b3-u04-l9","unit":"b3-u04","level":"b3","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s13":{"k":"s","t":"Kannst du mir bitte helfen?","g":{"en":"Can you help me, please?","fr":"Peux-tu m'aider, s'il te plaît ?","es":"¿Puedes ayudarme, por favor?","ar":"هل تستطيع أن تساعدني من فضلك؟"},"a":"de/a849987068c7"},"s.s14":{"k":"s","t":"Natürlich. Was brauchst du?","g":{"en":"Of course. What do you need?","fr":"Bien sûr. De quoi as-tu besoin ?","es":"Claro. ¿Qué necesitas?","ar":"طبعا. ماذا تحتاج؟"},"a":"de/cd49f0958ec2"},"s.s15":{"k":"s","t":"Ich verstehe dieses Wort nicht.","g":{"en":"I do not understand this word.","fr":"Je ne comprends pas ce mot.","es":"No entiendo esta palabra.","ar":"لا أفهم هذه الكلمة."},"a":"de/7ba2ea579a2b"},"s.s16":{"k":"s","t":"Was bedeutet dieses Wort?","g":{"en":"What does this word mean?","fr":"Que veut dire ce mot ?","es":"¿Qué significa esta palabra?","ar":"ماذا تعني هذه الكلمة؟"},"a":"de/6f3333f18025"},"s.s17":{"k":"s","t":"Können Sie das bitte wiederholen?","g":{"en":"Can you repeat that, please?","fr":"Pouvez-vous répéter, s'il vous plaît ?","es":"¿Puede repetir, por favor?","ar":"هل يمكنك أن تكرر من فضلك؟"},"a":"de/0e4933b71d3c"},"s.s04":{"k":"s","t":"Wann ist der Unterricht?","g":{"en":"When is the lesson?","fr":"Quand est le cours ?","es":"¿Cuándo es la clase?","ar":"متى الدرس؟"},"a":"de/a06174c4617f"},"s.s03":{"k":"s","t":"Wo wohnst du?","g":{"en":"Where do you live?","fr":"Où habites-tu ?","es":"¿Dónde vives?","ar":"أين تسكن؟"},"a":"de/1f212b77e420"},"s.s22":{"k":"s","t":"Nein, vielleicht weiß es der Lehrer.","g":{"en":"No, perhaps the teacher knows.","fr":"Non, le professeur la sait peut-être.","es":"No, quizás lo sepa el profesor.","ar":"لا، ربما يعرف المعلم."},"a":"de/5005763f94b2"},"s.s07":{"k":"s","t":"Wie geht es dir heute?","g":{"en":"How are you today?","fr":"Comment vas-tu aujourd'hui ?","es":"¿Cómo estás hoy?","ar":"كيف حالك اليوم؟"},"a":"de/4da24d98c684"},"s.s11":{"k":"s","t":"Wie ist deine Telefonnummer?","g":{"en":"What is your phone number?","fr":"Quel est ton numéro de téléphone ?","es":"¿Cuál es tu número de teléfono?","ar":"ما رقم هاتفك؟"},"a":"de/5712c2e72308"},"s.s27":{"k":"s","t":"Ich frage, weil ich deine Hilfe brauche.","g":{"en":"I ask because I need your help.","fr":"Je demande parce que j'ai besoin de ton aide.","es":"Pregunto porque necesito tu ayuda.","ar":"أسأل لأنني أحتاج إلى مساعدتك."},"a":"de/1ddfc1de909f"},"s.s18":{"k":"s","t":"Sprechen Sie bitte langsam.","g":{"en":"Please speak slowly.","fr":"Parlez lentement, s'il vous plaît.","es":"Hable despacio, por favor.","ar":"تكلم ببطء من فضلك."},"a":"de/ca4016f9fa56"},"s.s25":{"k":"s","t":"Es tut mir leid, ich weiß es nicht.","g":{"en":"Sorry, I do not know.","fr":"Désolé, je ne sais pas.","es":"Lo siento, no lo sé.","ar":"آسف، لا أعرف."},"a":"de/7905b79c78dd"},"s.s01":{"k":"s","t":"Wie heißt du?","g":{"en":"What is your name?","fr":"Comment t'appelles-tu ?","es":"¿Cómo te llamas?","ar":"ما اسمك؟"},"a":"de/a3f0ca3f2b5d"},"s.s28":{"k":"s","t":"Ist die Übung einfach oder schwierig?","g":{"en":"Is the exercise easy or difficult?","fr":"Est-ce que l'exercice est facile ou difficile ?","es":"¿El ejercicio es fácil o difícil?","ar":"هل التمرين سهل أم صعب؟"},"a":"de/91d3ffd777cb"},"s.s19":{"k":"s","t":"Sprechen Sie Englisch?","g":{"en":"Do you speak English?","fr":"Parlez-vous anglais ?","es":"¿Habla inglés?","ar":"هل تتكلم الإنجليزية؟"},"a":"de/8a4c1182c425"}},"ex":[{"id":"b3-u04-l9-e01","type":"order_dialogue","items":["s.s13","s.s14","s.s15","s.s16"]},{"id":"b3-u04-l9-e02","type":"true_false","item":"s.s17","shown":"s.s17","answer":true},{"id":"b3-u04-l9-e03","type":"true_false","item":"s.s04","shown":"s.s03","answer":false},{"id":"b3-u04-l9-e04","type":"listen_pick","item":"s.s22","opts":["s.s17","s.s22","s.s07","s.s13"]},{"id":"b3-u04-l9-e05","type":"word_bank","item":"s.s11","extra":["heißt","du"]},{"id":"b3-u04-l9-e06","type