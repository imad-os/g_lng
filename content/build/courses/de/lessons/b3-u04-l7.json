{"id":"b3-u04-l7","unit":"b3-u04","level":"b3","order":7,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s13":{"k":"s","t":"Kannst du mir bitte helfen?","g":{"en":"Can you help me, please?","fr":"Peux-tu m'aider, s'il te plaît ?","es":"¿Puedes ayudarme, por favor?","ar":"هل تستطيع أن تساعدني من فضلك؟"},"a":"de/b3-u04/s-s13"},"s.s14":{"k":"s","t":"Natürlich. Was brauchst du?","g":{"en":"Of course. What do you need?","fr":"Bien sûr. De quoi as-tu besoin ?","es":"Claro. ¿Qué necesitas?","ar":"طبعا. ماذا تحتاج؟"},"a":"de/b3-u04/s-s14"},"s.s15":{"k":"s","t":"Ich verstehe dieses Wort nicht.","g":{"en":"I do not understand this word.","fr":"Je ne comprends pas ce mot.","es":"No entiendo esta palabra.","ar":"لا أفهم هذه الكلمة."},"a":"de/b3-u04/s-s15"},"s.s16":{"k":"s","t":"Was bedeutet dieses Wort?","g":{"en":"What does this word mean?","fr":"Que veut dire ce mot ?","es":"¿Qué significa esta palabra?","ar":"ماذا تعني هذه الكلمة؟"},"a":"de/b3-u04/s-s16"},"s.s08":{"k":"s","t":"Wie viele Brüder hast du?","g":{"en":"How many brothers do you have?","fr":"Combien de frères as-tu ?","es":"¿Cuántos hermanos tienes?","ar":"كم أخا لديك؟"},"a":"de/b3-u04/s-s08"},"s.s19":{"k":"s","t":"Sprechen Sie Englisch?","g":{"en":"Do you speak English?","fr":"Parlez-vous anglais ?","es":"¿Habla inglés?","ar":"هل تتكلم الإنجليزية؟"},"a":"de/b3-u04/s-s19"},"s.s17":{"k":"s","t":"Können Sie das bitte wiederholen?","g":{"en":"Can you repeat that, please?","fr":"Pouvez-vous répéter, s'il vous plaît ?","es":"¿Puede repetir, por favor?","ar":"هل يمكنك أن تكرر من فضلك؟"},"a":"de/b3-u04/s-s17"},"s.s09":{"k":"s","t":"Welches Buch möchtest du?","g":{"en":"Which book do you want?","fr":"Quel livre veux-tu ?","es":"¿Qué libro quieres?","ar":"أي كتاب تريد؟"},"a":"de/b3-u04/s-s09"},"s.s24":{"k":"s","t":"Sag es bitte noch einmal.","g":{"en":"Say it again, please.","fr":"Dis-le encore, s'il te plaît.","es":"Dilo otra vez, por favor.","ar":"قلها مرة أخرى من فضلك."},"a":"de/b3-u04/s-s24"},"s.s04":{"k":"s","t":"Wann ist der Unterricht?","g":{"en":"When is the lesson?","fr":"Quand est le cours ?","es":"¿Cuándo es la clase?","ar":"متى الدرس؟"},"a":"de/b3-u04/s-s04"},"s.s20":{"k":"s","t":"Ja, ein bisschen. Diese Sprache ist nicht einfach.","g":{"en":"Yes, a little. This language is not easy.","fr":"Oui, un peu. Cette langue n'est pas facile.","es":"Sí, un poco. Este idioma no es fácil.","ar":"نعم، قليلا. هذه اللغة ليست سهلة."},"a":"de/b3-u04/s-s20"},"s.s25":{"k":"s","t":"Es tut mir leid, ich weiß es nicht.","g":{"en":"Sorry, I do not know.","fr":"Désolé, je ne sais pas.","es":"Lo siento, no lo sé.","ar":"آسف، لا أعرف."},"a":"de/b3-u04/s-s25"},"s.s10":{"k":"s","t":"Wie spät ist es?","g":{"en":"What time is it?","fr":"Quelle heure est-il ?","es":"¿Qué hora es?","ar":"كم الساعة؟"},"a":"de/b3-u04/s-s10"},"s.s11":{"k":"s","t":"Wie ist deine Telefonnummer?","g":{"en":"What is your phone number?","fr":"Quel est ton numéro de téléphone ?","es":"¿Cuál es tu número de teléfono?","ar":"ما رقم هاتفك؟"},"a":"de/b3-u04/s-s11"},"s.s12":{"k":"s","t":"Wie lautet deine Adresse?","g":{"en":"What is your address?","fr":"Quelle est ton adresse ?","es":"¿Cuál es tu dirección?","ar":"ما عنوانك؟"},"a":"de/b3-u04/s-s12"},"s.s28":{"k":"s","t":"Ist die Übung einfach oder schwierig?","g":{"en":"Is the exercise easy or difficult?","fr":"Est-ce que l'exercice est facile ou difficile ?","es":"¿El ejercicio es fácil o difícil?","ar":"هل التمرين سهل أم صعب؟"},"a":"de/b3-u04/s-s28"},"s.s21":{"k":"s","t":"Weißt du die Antwort?","g":{"en":"Do you know the answer?","fr":"Sais-tu la réponse ?","es":"¿Sabes la respuesta?","ar":"هل تعرف الجواب؟"},"a":"de/b3-u04/s-s21"},"s.s02":{"k":"s","t":"Wer ist dieser Mann?","g":{"en":"Who is that man?","fr":"Qui est cet homme ?","es":"¿Quién es ese hombre?","ar":"من هذا الرجل؟"},"a":"de/b3-u04/s-s02"},"s.s05":{"k":"s","t":"Warum bist du spät dran?","g":{"en":"Why are you late?","fr":"Pourquoi es-tu en reta