{"id":"b1-u06-l4","unit":"b1-u06","level":"b1","order":4,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s09":{"k":"s","t":"Ist morgen Freitag?","g":{"en":"Is tomorrow Friday?","fr":"Est-ce que demain, c'est vendredi ?","es":"¿Mañana es viernes?","ar":"هل غدا الجمعة؟"},"a":"de/171c30be98bc"},"s.s10":{"k":"s","t":"Ja, morgen ist Freitag.","g":{"en":"Yes, tomorrow is Friday.","fr":"Oui, demain, c'est vendredi.","es":"Sí, mañana es viernes.","ar":"نعم، غدا الجمعة."},"a":"de/0e20e7870df9"},"s.s11":{"k":"s","t":"Danke, bis morgen.","g":{"en":"Thank you, see you tomorrow.","fr":"Merci, à demain.","es":"Gracias, hasta mañana.","ar":"شكرا، إلى اللقاء غدا."},"a":"de/6fc2e3ddf698"},"s.s04":{"k":"s","t":"Ist heute Donnerstag?","g":{"en":"Is today Thursday?","fr":"Est-ce que c'est jeudi aujourd'hui ?","es":"¿Hoy es jueves?","ar":"هل اليوم الخميس؟"},"a":"de/68fe649217b1"},"s.s02":{"k":"s","t":"Morgen ist Dienstag.","g":{"en":"Tomorrow is Tuesday.","fr":"Demain, c'est mardi.","es":"Mañana es martes.","ar":"غدا الثلاثاء."},"a":"de/ae33e2f755a8"},"s.s08":{"k":"s","t":"Bis morgen!","g":{"en":"See you tomorrow!","fr":"À demain !","es":"¡Hasta mañana!","ar":"إلى اللقاء غدا!"},"a":"de/6f52f65f754a"},"s.s05":{"k":"s","t":"Nein, heute ist Mittwoch.","g":{"en":"No, today is Wednesday.","fr":"Non, aujourd'hui, c'est mercredi.","es":"No, hoy es miércoles.","ar":"لا، اليوم الأربعاء."},"a":"de/b560694d56c8"},"s.s03":{"k":"s","t":"Samstag und Sonntag.","g":{"en":"Saturday and Sunday.","fr":"Samedi et dimanche.","es":"Sábado y domingo.","ar":"السبت والأحد."},"a":"de/562f177ff534"},"s.n01":{"k":"s","t":"Morgen Abend essen wir zusammen.","g":{"en":"Tomorrow evening we eat together.","fr":"Demain soir, nous mangeons ensemble.","es":"Mañana por la tarde comemos juntos.","ar":"غدا مساء نأكل معا."},"a":"de/af32cee1ebd9"},"s.s07":{"k":"s","t":"Nacht und Tag.","g":{"en":"Night and day.","fr":"La nuit et le jour.","es":"La noch