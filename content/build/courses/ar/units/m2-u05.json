{"id":"m2-u05","level":"m2","order":5,"title":{"en":"Comparing","fr":"Comparer","es":"Comparar","ar":"المقارنة"},"tip":{"en":"Add \"-er than\" or \"more ... than\" to compare, and \"the -est\" or \"the most ...\" for the top of a group.","fr":"Utilisez « plus ... que » pour comparer et « le plus ... » pour le sommet d'un groupe.","es":"Usa «más ... que» para comparar y «el más ...» para destacar lo máximo de un grupo.","ar":"استخدم «أكثر ... من» للمقارنة و«الأكثر ...» للدلالة على الأعلى في المجموعة."},"words":40,"lessons":[{"id":"m2-u05-l1","type":"learn","order":1,"title":{"en":"bigger, smaller, taller","fr":"plus grand, plus petit, plus grand (en taille)","es":"más grande, más pequeño, más alto","ar":"أكبر، أصغر، أطول"},"count":11},{"id":"m2-u05-l2","type":"learn","order":2,"title":{"en":"slower, cheaper, more expensive","fr":"plus lent, moins cher, plus cher","es":"más lento, más barato, más caro","ar":"أبطأ، أرخص، أغلى"},"count":10},{"id":"m2-u05-l3","type":"learn","order":3,"title":{"en":"easier, harder, older","fr":"plus facile, plus difficile, plus âgé","es":"más fácil, más difícil, mayor","ar":"أسهل، أصعب، أكبر سنا"},"count":11},{"id":"m2-u05-l4","type":"learn","order":4,"title":{"en":"lighter, stronger, the best","fr":"plus léger, plus fort, le meilleur","es":"más ligero, más fuerte, el mejor","ar":"أخف، أقوى، الأفضل"},"count":10},{"id":"m2-u05-l5","type":"learn","order":5,"title":{"en":"the least, as ... as, than","fr":"le moins, aussi ... que, que","es":"el menos, tan ... como, que","ar":"الأقل، مثل، من"},"count":11},{"id":"m2-u05-l6","type":"learn","order":6,"title":{"en":"the same, both, compare","fr":"le même, les deux, comparer","es":"el mismo, ambos, comparar","ar":"نفسه، كلاهما، يقارن"},"count":10},{"id":"m2-u05-l7","type":"learn","order":7,"title":{"en":"quality, price, size","fr":"qualité, prix, taille","es":"calidad, precio, tamaño","ar":"جودة، سعر، حجم"},"count":11},{"id":"m2-u05-l8","type":"learn","order":8,"title":{"en":"comfortable, dangerous, popular","fr":"confortable, dangereux, populaire","es":"cómodo, peligroso, popular","ar":"مريح، خطير، شائع"},"count":10},{"id":"m2-u05-l9","type":"story","order":9,"title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"count":10},{"id":"m2-u05-l10","type":"review","order":10,"title":{"en":"Unit review","fr":"Révision de l'unité","es":"Repaso de la unidad","ar":"مراجعة الوحدة"},"count":9}]}
