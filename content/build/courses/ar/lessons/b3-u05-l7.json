{"id":"b3-u05-l7","unit":"b3-u05","level":"b3","order":7,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s11":{"k":"s","t":"ماذا فعلت أمس؟","g":{"en":"What did you do yesterday?","fr":"Qu'as-tu fait hier ?","es":"¿Qué hiciste ayer?","ar":"ماذا فعلت أمس؟"},"a":"ar/b3-u05/s-s11","tr":"mādhā faʿalta ams?"},"s.s01":{"k":"s","t":"ذهبت أمس إلى السوق.","g":{"en":"Yesterday I went to the market.","fr":"Hier, je suis allé au marché.","es":"Ayer fui al mercado.","ar":"ذهبت أمس إلى السوق."},"a":"ar/b3-u05/s-s01","tr":"dhahabtu ams ilā as-sūq."},"s.s04":{"k":"s","t":"رأيت أصدقائي هذا الصباح.","g":{"en":"I saw my friends this morning.","fr":"J'ai vu mes amis ce matin.","es":"Vi a mis amigos esta mañana.","ar":"رأيت أصدقائي هذا الصباح."},"a":"ar/b3-u05/s-s04","tr":"raʾaytu aṣdiqāʾī hādhā aṣ-ṣabāḥ."},"s.s05":{"k":"s","t":"اشترى هاتفا جديدا.","g":{"en":"He bought a new phone.","fr":"Il a acheté un nouveau téléphone.","es":"Compró un teléfono nuevo.","ar":"اشترى هاتفا جديدا."},"a":"ar/b3-u05/s-s05","tr":"ishtarā hātifan jadīdan."},"s.s23":{"k":"s","t":"قرأت هذا الكتاب في العام الماضي.","g":{"en":"I read this book last year.","fr":"J'ai lu ce livre l'année dernière.","es":"Leí este libro el año pasado.","ar":"قرأت هذا الكتاب في العام الماضي."},"a":"ar/b3-u05/s-s23","tr":"qaraʾtu hādhā al-kitāb fī al-ʿām al-māḍī."},"s.s20":{"k":"s","t":"غادروا البيت مبكرا.","g":{"en":"They left the house early.","fr":"Ils sont sortis de la maison tôt.","es":"Salieron de casa temprano.","ar":"غادروا البيت مبكرا."},"a":"ar/b3-u05/s-s20","tr":"ghādarū al-bayt mubakkiran."},"s.s03":{"k":"s","t":"شربنا الشاي في بيت جدتي.","g":{"en":"We drank tea at my grandmother's house.","fr":"Nous avons bu du thé chez ma grand-mère.","es":"Bebimos té en casa de mi abuela.","ar":"شربنا الشاي في بيت جدتي."},"a":"ar/b3-u05/s-s03","tr":"sharibnā ash-shāy fī bayt jaddatī."},"s.s19":{"k":"s","t":"وصل القطار متأخرا.","g":{"en":"The train arrived late.","fr":"Le train est arrivé en retard.","es":"El tren llegó tarde.","ar":"وصل القطار متأخرا."},"a":"ar/b3-u05/s-s19","tr":"waṣala al-qiṭār mutaʾakhkhiran."},"s.s17":{"k":"s","t":"قابلت معلمي في المحطة.","g":{"en":"I met my teacher at the station.","fr":"J'ai rencontré mon professeur à la gare.","es":"Me encontré con mi profesor en la estación.","ar":"قابلت معلمي في المحطة."},"a":"ar/b3-u05/s-s17","tr":"qābaltu muʿallimī fī al-maḥaṭṭa."},"s.s08":{"k":"s","t":"نام أخي حتى الساعة العاشرة.","g":{"en":"My brother slept until ten.","fr":"Mon frère a dormi jusqu'à dix heures.","es":"Mi hermano durmió hasta las diez.","ar":"نام أخي حتى الساعة العاشرة."},"a":"ar/b3-u05/s-s08","tr":"nāma akhī ḥattā as-sāʿa al-ʿāshira."},"s.s18":{"k":"s","t":"أنهيت واجباتي في الساعة التاسعة.","g":{"en":"I finished my homework at nine.","fr":"J'ai fini mes devoirs à neuf heures.","es":"Terminé mis deberes a las nueve.","ar":"أنهيت واجباتي في الساعة التاسعة."},"a":"ar/b3-u05/s-s18","tr":"anhaytu wājibātī fī as-sāʿa at-tāsiʿa."},"s.s14":{"k":"s","t":"كنت في البيت ليلة أمس.","g":{"en":"I was at home last night.","fr":"J'étais à la maison hier soir.","es":"Estaba en casa anoche.","ar":"كنت في البيت ليلة أمس."},"a":"ar/b3-u05/s-s14","tr":"kuntu fī al-bayt laylat ams."},"s.s10":{"k":"s","t":"قالت وداعا وغادرت.","g":{"en":"She said goodbye and left.","fr":"Elle a dit au revoir et elle est partie.","es":"Dijo adiós y salió.","ar":"قالت وداعا وغادرت."},"a":"ar/b3-u05/s-s10","tr":"qālat wadāʿan wa-ghādarat."},"s.s24":{"k":"s","t":"قضينا عطلة رائعة.","g":{"en":"We had a great holiday.","fr":"Nous avons passé de très bonnes vacances.","es":"Tuvimos unas vacaciones estupendas.","ar":"قضينا عطلة رائعة."},"a":"ar/b3-u05/s-s24","tr":"qaḍaynā ʿuṭla rāʾiʿa."},"s.s12":{"k":"s","t":"زرت جدي وجدتي في عطلة نهاية الأسبوع.","g":{"en":"I visited my grandparents on the weekend.","fr":"J'ai rendu visite à mes grands-parents pendant le week-end.","es":"Visité a mis abuelos el fin de semana.","ar":"زرت جدي وجدتي في عطلة نهاية الأسبوع."},"a":"ar/b3-u05/s-s12","tr":"zurtu jaddī wa-jaddatī fī ʿuṭlat nihāyat al-usbūʿ."},"s.s26":{"k":"s","t":"هل أكلت بالفعل؟","g":{"en":"Did you already eat?","fr":"As-tu déjà mangé ?","es":"¿Ya comiste?","ar":"هل أكلت بالفعل؟"},"a":"ar/b3-u05/s-s26","tr":"hal akalta bil-fiʿl?"},"s.s22":{"k":"s","t":"هي كتبت رسالة طويلة.","g":{"en":"She wrote a long letter.","fr":"Elle a écrit une longue lettre.","es":"Ella escribió una carta larga.","ar":"هي كتبت رسالة طويلة."},"a":"ar/b3-u05/s-s22","tr":"hiya katabat risāla ṭawīla."}},"ex":[{"id":"b3-u05-l7-e01","type":"order_dialogue","items":["s.s11","s.s01","s.s04"]},{"id":"b3-u05-l7-e02","type":"true_false","item":"s.s04","shown":"s.s04","answer":true},{"id":"b3-u05-l7-e03","type":"true_false","item":"s.s05","shown":"s.s23","answer":false},{"id":"b3-u05-l7-e04","type":"true_false","item":"s.s20","shown":"s.s20","answer":true},{"id":"b3-u05-l7-e05","type":"listen_pick","item":"s.s03","opts":["s.s03","s.s05","s.s01","s.s20"]},{"id":"b3-u05-l7-e06","type":"listen_pick","item":"s.s19","opts":["s.s03","s.s05","s.s17","s.s19"]},{"id":"b3-u05-l7-e07","type":"word_bank","item":"s.s08","extra":["كان","لديه"]},{"id":"b3-u05-l7-e08","type":"word_bank","item":"s.s18","extra":["عمل","ذهب"]},{"id":"b3-u05-l7-e09","type":"word_bank","item":"s.s14","extra":["أنهيت","واجباتي"]},{"id":"b3-u05-l7-e10","type":"pick_translation","item":"s.s10","opts":["s.s10","s.s08","s.s24","s.s12"]},{"id":"b3-u05-l7-e11","type":"pick_translation","item":"s.s26","opts":["s.s26","s.s14","s.s22","s.s10"]}]}
