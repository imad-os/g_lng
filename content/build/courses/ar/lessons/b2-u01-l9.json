ف واسم عائلتي العلوي."},"a":"ar/b2-u01/s-s24","tr":"ismī al-awwal Yūsuf wa-ism ʿāʾilatī al-ʿAlawī."},"s.s26":{"k":"s","t":"عمي تاجر ويسكن في فرنسا.","g":{"en":"My uncle is a shopkeeper and he lives in France.","fr":"Mon oncle est commerçant et il habite en France.","es":"Mi tío es comerciante y vive en Francia.","ar":"عمي تاجر ويسكن في فرنسا."},"a":"ar/b2-u01/s-s26","tr":"ʿammī tājir wa-yaskun fī faransā."},"s.s13":{"k":"s","t":"أدرس الإنجليزية في الجامعة.","g":{"en":"I study English at the university.","fr":"J'étudie l'anglais à l'université.","es":"Estudio inglés en la universidad.","ar":"أدرس الإنجليزية في الجامعة."},"a":"ar/b2-u01/s-s13","tr":"adrus al-injlīziyya fī al-jāmiʿa."}},"ex":[{"id":"b2-u01-l9-e01","type":"order_dialogue","items":["s.s01","s.s02","s.s05","s.s06","s.s09","s.s10"]},{"id":"b2-u01-l9-e02","type":"true_false","item":"s.s19","shown":"s.s19","answer":true},{"id":"b2-u01-l9-e03","type":"true_false","item":"s.s21","shown":"s.s21","answer":true},{"id":"b2-u01-l9-e04","type":"listen_pick","item":"s.s25","opts":["s.s05","s.s01","s.s04","s.s25"]},{"id":"b2-u01-l9-e05","type":"word_bank","item":"s.s04","extra":["تاجر","إسبانيا"]},{"id":"b2-u01-l9-e06","type":"word_bank","item":"s.s11","extra":["المغرب","كم","عمرك"]},{"id":"b2-u01-l9-e07","type":"word_bank","item":"s.s03","extra":["عمري","خمسة","وعشرون"]},{"id":"b2-u01-l9-e08","type":"pick_translation","item":"s.s20","opts":["s.s20","s.s12","s.s15","s.s25"]},{"id":"b2-u01-l9-e09","type":"pick_translation","item":"s.s15","opts":["s.s08","s.s24","s.s26","s.s15"]},{"id":"b2-u01-l9-e10","type":"speak","item":"s.s13"}]}
