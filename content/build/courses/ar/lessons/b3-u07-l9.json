{"id":"b3-u07-l9","unit":"b3-u07","level":"b3","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s16":{"k":"s","t":"أين يؤلمك؟","g":{"en":"Where does it hurt?","fr":"Où as-tu mal ?","es":"¿Dónde te duele?","ar":"أين يؤلمك؟"},"a":"ar/1e09b7e00896","tr":"ayna yuʾlimuk?"},"s.s03":{"k":"s","t":"يؤلمني حلقي وأسعل.","g":{"en":"My throat hurts and I cough.","fr":"J'ai mal à la gorge et je tousse.","es":"Me duele la garganta y toso.","ar":"يؤلمني حلقي وأسعل."},"a":"ar/df8986bbe232","tr":"yuʾlimunī ḥalqī wa-asʿul."},"s.s12":{"k":"s","t":"تناول هذا الدواء مرتين في اليوم.","g":{"en":"Take this medicine twice a day.","fr":"Prends ce médicament deux fois par jour.","es":"Toma esta medicina dos veces al día.","ar":"تناول هذا الدواء مرتين في اليوم."},"a":"ar/394e5be29ce8","tr":"tanāwal hādhā ad-dawāʾ marratayn fī al-yawm."},"s.s11":{"k":"s","t":"اشرب كثيرا من الماء.","g":{"en":"Drink a lot of water.","fr":"Bois beaucoup d'eau.","es":"Bebe mucha agua.","ar":"اشرب كثيرا من الماء."},"a":"ar/89ee987dc1a8","tr":"ishrab kathīran min al-māʾ."},"s.s28":{"k":"s","t":"أتمنى لك الشفاء العاجل!","g":{"en":"Get well soon!","fr":"Bon rétablissement !","es":"¡Que te mejores pronto!","ar":"أتمنى لك الشفاء العاجل!"},"a":"ar/bb7d584b7e4a","tr":"atamannā laka ash-shifāʾ al-ʿājil!"},"s.s07":{"k":"s","t":"يشعر بألم في قدمه.","g":{"en":"He has pain in his foot.","fr":"Il a mal au pied.","es":"Le duele el pie.","ar":"يشعر بألم في قدمه."},"a":"ar/d1a82686deb5","tr":"yashʿur bi-alam fī qadamih."},"s.s01":{"k":"s","t":"يؤلمني رأسي.","g":{"en":"My head hurts.","fr":"J'ai mal à la tête.","es":"Me duele la cabeza.","ar":"يؤلمني رأسي."},"a":"ar/d19e51eac2c7","tr":"yuʾlimunī raʾsī."},"s.s14":{"k":"s","t":"أين الصيدلية؟","g":{"en":"Where is the pharmacy?","fr":"Où est la pharmacie ?","es":"¿Dónde está la farmacia?","ar":"أين الصيدلية؟"},"a":"ar/578b40685c34","tr":"ayna aṣ-ṣaydaliyya?"},"s.s08":{"k":"s","t":"أنا مريض. أظن أنني مصاب بزكام.","g":{"en":"I am sick. I think I have a cold.","fr":"Je suis malade. Je crois que j'ai un rhume.","es":"Estoy enfermo. Creo que tengo un resfriado.","ar":"أنا مريض. أظن أنني مصاب بزكام."},"a":"ar/30e5915d77e0","tr":"anā marīḍ. aẓunnu annanī muṣāb bi-zukām."},"s.s05":{"k":"s","t":"يؤلمني ظهري كثيرا.","g":{"en":"My back hurts a lot.","fr":"J'ai très mal au dos.","es":"Me duele mucho la espalda.","ar":"يؤلمني ظهري كثيرا."},"a":"ar/848fede664a7","tr":"yuʾlimunī ẓahrī kathīran."},"s.s25":{"k":"s","t":"يجب أن يذهب إلى المستشفى.","g":{"en":"He should go to the hospital.","fr":"Il devrait aller à l'hôpital.","es":"Debería ir al hospital.","ar":"يجب أن يذهب إلى المستشفى."},"a":"ar/f47f072aaa2d","tr":"yajib an yadhhab ilā al-mustashfā."},"s.s04":{"k":"s","t":"تؤلمني معدتي.","g":{"en":"My stomach hurts.","fr":"J'ai mal au ventre.","es":"Me duele el estómago.","ar":"تؤلمني معدتي."},"a":"ar/f67006b1a657","tr":"tuʾlimunī miʿdatī."},"s.s15":{"k":"s","t":"أحتاج إلى طبيب من فضلك.","g":{"en":"I need a doctor, please.","fr":"J'ai besoin d'un médecin, s'il vous plaît.","es":"Necesito un médico, por favor.","ar":"أحتاج إلى طبيب من فضلك."},"a":"ar/0c84d0cd08b6","tr":"aḥtāj ilā ṭabīb min faḍlik."},"s.s10":{"k":"s","t":"يجب أن ترتاح في البيت.","g":{"en":"You should rest at home.","fr":"Tu devrais te reposer à la maison.","es":"Deberías descansar en casa.","ar":"يجب أن ترتاح في البيت."},"a":"ar/97b62778de00","tr":"yajib an tartāḥ fī al-bayt."},"s.s21":{"k":"s","t":"افتح فمك من فضلك.","g":{"en":"Open your mouth, please.","fr":"Ouvrez la bouche, s'il vous plaît.","es":"Abra la boca, por favor.","ar":"افتح فمك من فضلك."},"a":"ar/cefe2090ac73","tr":"iftaḥ famak min faḍlik."},"s.s18":{"k":"s","t":"يؤلمني سني. لا أستطيع أن آكل.","g":{"en":"My tooth hurts. I cannot eat.","fr":"J'ai mal à une dent. Je ne peux pas manger.","es":"Me duele un diente. No puedo comer.","ar":"يؤلمني سني. لا أستطيع أن آكل."},"a":"ar/33ffbbc1166f","tr":"yuʾlimunī sinnī. lā astaṭīʿ an ākul."},"s.s23":{"k":"s","t":"هل تشعر أنك أفضل اليوم؟","g":{"en":"Do you feel better today?","fr":"Tu te sens mieux aujourd'hui ?","es":"¿Te sientes mejor hoy?","ar":"هل تشعر أنك أفضل اليوم؟"},"a":"ar/7e371afd496f","tr":"hal tashʿur annaka afḍal al-yawm?"},"s.s06":{"k":"s","t":"تؤلمني ركبتاي عندما أمشي.","g":{"en":"My knees hurt when I walk.","fr":"J'ai mal aux genoux quand je marche.","es":"Me duelen las rodillas cuando camino.","ar":"تؤلمني ركبتاي عندما أمشي."},"a":"ar/fb6d879d5a34","tr":"tuʾlimunī rukbatāya ʿindamā amshī."},"s.s09":{"k":"s","t":"يجب أن ترى طبيبا.","g":{"en":"You should see a doctor.","fr":"Tu devrais voir un médecin.","es":"Deberías ver a un médico.","ar":"يجب أن ترى طبيبا."},"a":"ar/7ff97b2b6fbc","tr":"yajib an tarā ṭabīban."},"s.s27":{"k":"s","t":"لتكون بصحة جيدة، كل جيدا ونم جيدا.","g":{"en":"To stay healthy, eat well and sleep well.","fr":"Pour rester en bonne santé, mange bien et dors bien.","es":"Para estar sano, come bien y duerme bien.","ar":"لتكون بصحة جيدة، كل جيدا ونم جيدا."},"a":"ar/f4b8f36626aa","tr":"li-takūn biṣiḥḥa jayyida, kul jayyidan wa-nam jayyidan."}},"ex":[{"id":"b3-u07-l9-e01","type":"order_dialogue","items":["s.s16","s.s03","s.s12","s.s11","s.s28"]},{"id":"b3-u07-l9-e02","type":"true_false","item":"s.s07","shown":"s.s07","answer":true},{"id":"b3-u07-l9-e03","type":"true_false","item":"s.s01","shown":"s.s14","answer":false},{"id":"b3-u07-l9-e04","type":"listen_pick","item":"s.s08","opts":["s.s08","s.s05","s.s25","s.s04"]},{"id":"b3-u07-l9-e05","type":"word_bank","item":"s.s08","extra":["كتف","يجب"]},{"id":"b3-u07-l9-e06","type":"word_bank","item":"s.s15","extra":["أعاني","صداع"]},{"id":"b3-u07-l9-e07","type":"word_bank","item":"s.s04","extra":["رأس","يؤلمني","رأسي"]},{"id":"b3-u07-l9-e08","type":"pick_translation","item":"s.s10","opts":["s.s16","s.s21","s.s18","s.s10"]},{"id":"b3-u07-l9-e09","type":"pick_translation","item":"s.s23","opts":["s.s06","s.s23","s.s04","s.s09"]},{"id":"b3-u07-l9-e10","type":"speak","item":"s.s27"}]}
