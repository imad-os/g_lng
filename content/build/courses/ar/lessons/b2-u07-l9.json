{"id":"b2-u07-l9","unit":"b2-u07","level":"b2","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s04":{"k":"s","t":"هل يمكنني تجربة هذا الجينز؟","g":{"en":"Can I try on these jeans?","fr":"Je peux essayer ces jeans ?","es":"¿Puedo probarme estos vaqueros?","ar":"هل يمكنني تجربة هذا الجينز؟"},"a":"ar/b06eb8eae58c","tr":"hal yumkinunī tajribat hādhā al-jīnz?"},"s.s05":{"k":"s","t":"أين غرفة القياس؟","g":{"en":"Where is the fitting room?","fr":"Où est la cabine d'essayage ?","es":"¿Dónde está el probador?","ar":"أين غرفة القياس؟"},"a":"ar/d60de0b39ae1","tr":"ayna ghurfat al-qiyās?"},"s.s07":{"k":"s","t":"إنه صغير جدا، أحتاج إلى مقاس أكبر.","g":{"en":"It is too small, I need a bigger one.","fr":"C'est trop petit, il me faut plus grand.","es":"Es demasiado pequeño, necesito uno más grande.","ar":"إنه صغير جدا، أحتاج إلى مقاس أكبر."},"a":"ar/727267ae9c73","tr":"innahu ṣaghīr jiddan, aḥtāj ilā maqās akbar."},"s.s03":{"k":"s","t":"هل عندك هذا القميص بمقاس أكبر؟","g":{"en":"Do you have this shirt in a bigger size?","fr":"Vous avez cette chemise dans une taille au-dessus ?","es":"¿Tiene esta camisa en una talla más grande?","ar":"هل عندك هذا القميص بمقاس أكبر؟"},"a":"ar/5aa495bfdcde","tr":"hal ʿindak hādhā al-qamīṣ bi-maqās akbar?"},"s.s06":{"k":"s","t":"إنه يناسبك.","g":{"en":"It fits you well.","fr":"Ça vous va bien.","es":"Le queda bien.","ar":"إنه يناسبك."},"a":"ar/39b4236646a6","tr":"innahu yunāsibuk."},"s.s10":{"k":"s","t":"تلبس تنورة زرقاء وقميصا أبيض.","g":{"en":"She wears a blue skirt and a white shirt.","fr":"Elle porte une jupe bleue et une chemise blanche.","es":"Ella lleva una falda azul y una camisa blanca.","ar":"تلبس تنورة زرقاء وقميصا أبيض."},"a":"ar/445881db3547","tr":"talbas tannūra zarqāʾ wa-qamīṣan abyaḍ."},"s.s09":{"k":"s","t":"يعجبني الفستان الأحمر.","g":{"en":"I like the red dress.","fr":"J'aime la robe rouge.","es":"Me gusta el vestido rojo.","ar":"يعجبني الفستان الأحمر."},"a":"ar/52186b4ed733","tr":"yuʿjibunī al-fustān al-aḥmar."},"s.s02":{"k":"s","t":"مقاسي صغير.","g":{"en":"I wear a small size.","fr":"Je fais une petite taille.","es":"Uso una talla pequeña.","ar":"مقاسي صغير."},"a":"ar/ee08ed0c7159","tr":"maqāsī ṣaghīr."},"s.s21":{"k":"s","t":"هل عندك هذا باللون الأسود؟","g":{"en":"Do you have this in black?","fr":"Vous l'avez en noir ?","es":"¿Lo tiene en negro?","ar":"هل عندك هذا باللون الأسود؟"},"a":"ar/dde485736b0c","tr":"hal ʿindak hādhā bi-l-lawn al-aswad?"},"s.s16":{"k":"s","t":"هل في السترة جيب؟","g":{"en":"Does the jacket have a pocket?","fr":"Est-ce que la veste a une poche ?","es":"¿La chaqueta tiene bolsillo?","ar":"هل في السترة جيب؟"},"a":"ar/fb2d79980b6d","tr":"hal fī as-sutra jayb?"},"s.s08":{"k":"s","t":"هذا البنطلون طويل جدا.","g":{"en":"These trousers are too long.","fr":"Ce pantalon est trop long.","es":"Estos pantalones son demasiado largos.","ar":"هذا البنطلون طويل جدا."},"a":"ar/d0321bee219e","tr":"hādhā al-banṭalūn ṭawīl jiddan."},"s.s22":{"k":"s","t":"الأزرق والأخضر ينسجمان معا.","g":{"en":"Blue and green go well together.","fr":"Le bleu et le vert vont bien ensemble.","es":"El azul y el verde combinan bien.","ar":"الأزرق والأخضر ينسجمان معا."},"a":"ar/60c07d5c42f9","tr":"al-azraq wa-l-akhḍar yansajimān maʿan."},"s.s11":{"k":"s","t":"يلبس سترة سوداء ووشاحا أخضر.","g":{"en":"He wears a black jacket and a green scarf.","fr":"Il porte une veste noire et une écharpe verte.","es":"Él lleva una chaqueta negra y una bufanda verde.","ar":"يلبس سترة سوداء ووشاحا أخضر."},"a":"ar/cf3437535718","tr":"yalbas sutra sawdāʾ wa-wishāḥan akhḍar."},"s.s13":{"k":"s","t":"أحتاج إلى جوارب وحزام.","g":{"en":"I need socks and a belt.","fr":"J'ai besoin de chaussettes et d'une ceinture.","es":"Necesito calcetines y un cinturón.","ar":"أحتاج إلى جوارب وحزام."},"a":"ar/0e31be3186d2","tr":"aḥtāj ilā jawārib wa-ḥizām."},"s.s01":{"k":"s","t":"ما مقاسك؟","g":{"en":"What size are you?","fr":"Quelle taille faites-vous ?","es":"¿Qué talla usa?","ar":"ما مقاسك؟"},"a":"ar/496d8a99937d","tr":"mā maqāsuk?"},"s.s19":{"k":"s","t":"أفضل التنانير الطويلة.","g":{"en":"I prefer long skirts.","fr":"Je préfère les jupes longues.","es":"Prefiero las faldas largas.","ar":"أفضل التنانير الطويلة."},"a":"ar/059fddf6b561","tr":"ufaḍḍil at-tanānīr aṭ-ṭawīla."},"s.s27":{"k":"s","t":"سآخذ هذه الملابس، كم المجموع؟","g":{"en":"I will take these clothes, how much is the total?","fr":"Je prends ces vêtements, combien ça fait au total ?","es":"Me llevo esta ropa, ¿cuánto es en total?","ar":"سآخذ هذه الملابس، كم المجموع؟"},"a":"ar/a86a65511d72","tr":"sa-ākhudh hādhihi al-malābis, kam al-majmūʿ?"}},"ex":[{"id":"b2-u07-l9-e01","type":"order_dialogue","items":["s.s04","s.s05","s.s07","s.s03"]},{"id":"b2-u07-l9-e02","type":"true_false","item":"s.s06","shown":"s.s06","answer":true},{"id":"b2-u07-l9-e03","type":"true_false","item":"s.s10","shown":"s.s09","answer":false},{"id":"b2-u07-l9-e04","type":"listen_pick","item":"s.s02","opts":["s.s21","s.s16","s.s02","s.s07"]},{"id":"b2-u07-l9-e05","type":"word_bank","item":"s.s08","extra":["هي","تلبس"]},{"id":"b2-u07-l9-e06","type":"word_bank","item":"s.s22","extra":["سآخذ","هذه"]},{"id":"b2-u07-l9-e07","type":"word_bank","item":"s.s11","extra":["هل","عندك"]},{"id":"b2-u07-l9-e08","type":"pick_translation","item":"s.s13","opts":["s.s10","s.s03","s.s01","s.s13"]},{"id":"b2-u07-l9-e09","type":"pick_translation","item":"s.s22","opts":["s.s04","s.s11","s.s19","s.s22"]},{"id":"b2-u07-l9-e10","type":"speak","item":"s.s27"}]}
