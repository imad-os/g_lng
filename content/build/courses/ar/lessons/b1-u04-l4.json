{"id":"b1-u04-l4","unit":"b1-u04","level":"b1","order":4,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s11":{"k":"s","t":"هل تريد شايا؟","g":{"en":"Do you want tea?","fr":"Tu veux du thé ?","es":"¿Quieres té?","ar":"هل تريد شايا؟"},"a":"ar/91ad9dc6c61e","tr":"hal turīdu shāyan?"},"s.s09":{"k":"s","t":"نعم، أريد شايا.","g":{"en":"Yes, I want tea.","fr":"Oui, je veux du thé.","es":"Sí, quiero té.","ar":"نعم، أريد شايا."},"a":"ar/953071dcd64e","tr":"naʿam, urīdu shāyan."},"s.s13":{"k":"s","t":"بالحليب من فضلك.","g":{"en":"With milk, please.","fr":"Avec du lait, s'il vous plaît.","es":"Con leche, por favor.","ar":"بالحليب من فضلك."},"a":"ar/d825b1acc0b4","tr":"bil-ḥalīb min faḍlik."},"s.s12":{"k":"s","t":"حليب مع قهوة.","g":{"en":"Milk with coffee.","fr":"Du lait avec du café.","es":"Leche con café.","ar":"حليب مع قهوة."},"a":"ar/becce76c0eaa","tr":"ḥalīb maʿa qahwa."},"s.s07":{"k":"s","t":"التفاحة كبيرة.","g":{"en":"The apple is big.","fr":"La pomme est grosse.","es":"La manzana es grande.","ar":"التفاحة كبيرة."},"a":"ar/d46e65eb7f34","tr":"at-tuffāḥa kabīra."},"s.s05":{"k":"s","t":"آكل سمكا وأرزا.","g":{"en":"I eat fish and rice.","fr":"Je mange du poisson et du riz.","es":"Como pescado y arroz.","ar":"آكل سمكا وأرزا."},"a":"ar/e6c53511e4dc","tr":"ākulu samakan wa-aruzzan."},"s.s03":{"k":"s","t":"أريد حليبا وخبزا.","g":{"en":"I want milk and bread.","fr":"Je veux du lait et du pain.","es":"Quiero leche y pan.","ar":"أريد حليبا وخبزا."},"a":"ar/aed7b3a0f3ae","tr":"urīdu ḥalīban wa-khubzan."},"s.s02":{"k":"s","t":"أريد قهوة.","g":{"en":"I want coffee.","fr":"Je veux du café.","es":"Quiero café.","ar":"أريد قهوة."},"a":"ar/94fde7e34f7b","tr":"urīdu qahwa."},"s.s06":{"k":"s","t":"كسكس باللحم.","g":{"en":"Couscous with meat.","fr":"Du couscous avec de la viande.","es":"Cuscús con carne.","ar":"كسكس باللحم."},"a":"ar/b9bcd3d19a94","tr":"kuskus bil-laḥm."},"s.s10":{"k":"s","t":"لا، شكرا. ماء من فض