{"id":"b3-u08-l7","unit":"b3-u08","level":"b3","order":7,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s23":{"k":"s","t":"هل يمكنني مساعدتك؟","g":{"en":"Can I help you?","fr":"Puis-je vous aider ?","es":"¿Puedo ayudarle?","ar":"هل يمكنني مساعدتك؟"},"a":"ar/b3-u08/s-s23","tr":"hal yumkinunī musāʿadatuk?"},"s.s02":{"k":"s","t":"أود أن أشتري هذا البنطال.","g":{"en":"I would like to buy these trousers.","fr":"Je voudrais acheter ce pantalon.","es":"Quisiera comprar este pantalón.","ar":"أود أن أشتري هذا البنطال."},"a":"ar/b3-u08/s-s02","tr":"awadd an ashtarī hādhā al-banṭāl."},"s.s03":{"k":"s","t":"بكم هذا؟","g":{"en":"How much does it cost?","fr":"Combien ça coûte ?","es":"¿Cuánto cuesta?","ar":"بكم هذا؟"},"a":"ar/b3-u08/s-s03","tr":"bikam hādhā?"},"s.s11":{"k":"s","t":"هل يمكنني الدفع بالبطاقة؟","g":{"en":"Can I pay by card?","fr":"Puis-je payer par carte ?","es":"¿Puedo pagar con tarjeta?","ar":"هل يمكنني الدفع بالبطاقة؟"},"a":"ar/b3-u08/s-s11","tr":"hal yumkinunī ad-dafʿ bil-biṭāqa?"},"s.s28":{"k":"s","t":"شكرا، أتمنى لك يوما سعيدا!","g":{"en":"Thank you, have a nice day!","fr":"Merci, bonne journée !","es":"¡Gracias, que tenga un buen día!","ar":"شكرا، أتمنى لك يوما سعيدا!"},"a":"ar/b3-u08/s-s28","tr":"shukran, atamannā laka yawman saʿīdan!"},"s.s20":{"k":"s","t":"محفظتي في الكيس.","g":{"en":"My wallet is in the bag.","fr":"Mon portefeuille est dans le sac.","es":"Mi cartera está en la bolsa.","ar":"محفظتي في الكيس."},"a":"ar/b3-u08/s-s20","tr":"miḥfaẓatī fī al-kīs."},"s.s16":{"k":"s","t":"يغلق المتجر في الساعة السابعة مساء.","g":{"en":"The shop closes at seven in the evening.","fr":"Le magasin ferme à sept heures du soir.","es":"La tienda cierra a las siete de la tarde.","ar":"يغلق المتجر في الساعة السابعة مساء."},"a":"ar/b3-u08/s-s16","tr":"yughliq al-matjar fī as-sāʿa as-sābiʿa masāʾan."},"s.s13":{"k":"s","t":"تفضل، هذا هو الباقي.","g":{"en":"Here is your change.","fr":"Voici votre monnaie.","es":"Aquí tiene su cambio.","ar":"تفضل، هذا هو الباقي."},"a":"ar/b3-u08/s-s13","tr":"tafaḍḍal, hādhā huwa al-bāqī."},"s.s06":{"k":"s","t":"هل يمكنك أن تريني واحدا آخر من فضلك؟","g":{"en":"Could you show me another one, please?","fr":"Pourriez-vous m'en montrer un autre, s'il vous plaît ?","es":"¿Podría enseñarme otro, por favor?","ar":"هل يمكنك أن تريني واحدا آخر من فضلك؟"},"a":"ar/b3-u08/s-s06","tr":"hal yumkinuka an turiyanī wāḥidan ākhar min faḍlik?"},"s.s04":{"k":"s","t":"إنه غال جدا بالنسبة لي.","g":{"en":"It is very expensive for me.","fr":"C'est très cher pour moi.","es":"Es muy caro para mí.","ar":"إنه غال جدا بالنسبة لي."},"a":"ar/b3-u08/s-s04","tr":"innahu ghālin jiddan bin-nisba lī."},"s.s08":{"k":"s","t":"هل لديك مقاس أكبر؟","g":{"en":"Do you have a bigger size?","fr":"Avez-vous une taille plus grande ?","es":"¿Tiene una talla más grande?","ar":"هل لديك مقاس أكبر؟"},"a":"ar/b3-u08/s-s08","tr":"hal ladayka maqās akbar?"},"s.s25":{"k":"s","t":"هل يمكنك أن تفتح الباب من فضلك؟ يداي مشغولتان.","g":{"en":"Could you open the door, please? My hands are full.","fr":"Pourriez-vous ouvrir la porte, s'il vous plaît ? J'ai les mains pleines.","es":"¿Podría abrir la puerta, por favor? Tengo las manos ocupadas.","ar":"هل يمكنك أن تفتح الباب من فضلك؟ يداي مشغولتان."},"a":"ar/b3-u08/s-s25","tr":"hal yumkinuka an taftaḥa al-bāb min faḍlik? yadāya mashghūlatān."},"s.s19":{"k":"s","t":"أمينة الصندوق لطيفة جدا.","g":{"en":"The cashier is very nice.","fr":"La caissière est très gentille.","es":"La cajera es muy amable.","ar":"أمينة الصندوق لطيفة جدا."},"a":"ar/b3-u08/s-s19","tr":"amīnat aṣ-ṣundūq laṭīfa jiddan."},"s.s07":{"k":"s","t":"هل يمكنني أن أجربه؟","g":{"en":"Can I try it on?","fr":"Puis-je l'essayer ?","es":"¿Puedo probármelo?","ar":"هل يمكنني أن أجربه؟"},"a":"ar/b3-u08/s-s07","tr":"hal yumkinunī an ujarribah?"},"s.s18":{"k":"s","t":"هل يوجد سوبرماركت قريب من هنا؟","g":{"en":"Is there a supermarket near here?","fr":"Y a-t-il un supermarché près d'ici ?","es":"¿Hay un supermercado cerca de aquí?","ar":"هل يوجد سوبرماركت قريب من هنا؟"},"a":"ar/b3-u08/s-s18","tr":"hal yūjad sūbirmārkit qarīb min hunā?"},"s.s09":{"k":"s","t":"هذا كبير جدا. أحتاج إلى مقاس أصغر.","g":{"en":"This one is too big. I need a smaller size.","fr":"Celui-ci est trop grand. Il me faut une taille plus petite.","es":"Este es demasiado grande. Necesito una talla más pequeña.","ar":"هذا كبير جدا. أحتاج إلى مقاس أصغر."},"a":"ar/b3-u08/s-s09","tr":"hādhā kabīr jiddan. aḥtāj ilā maqās aṣghar."},"s.s05":{"k":"s","t":"هل يوجد خصم؟","g":{"en":"Is there a discount?","fr":"Y a-t-il une réduction ?","es":"¿Hay algún descuento?","ar":"هل يوجد خصم؟"},"a":"ar/b3-u08/s-s05","tr":"hal yūjad khaṣm?"},"s.s21":{"k":"s","t":"يبيعون هنا خبزا جيدا.","g":{"en":"They sell good bread here.","fr":"Ils vendent du bon pain ici.","es":"Aquí venden buen pan.","ar":"يبيعون هنا خبزا جيدا."},"a":"ar/b3-u08/s-s21","tr":"yabīʿūna hunā khubzan jayyidan."}},"ex":[{"id":"b3-u08-l7-e01","type":"order_dialogue","items":["s.s23","s.s02","s.s03","s.s11","s.s28"]},{"id":"b3-u08-l7-e02","type":"true_false","item":"s.s20","shown":"s.s16","answer":false},{"id":"b3-u08-l7-e03","type":"true_false","item":"s.s13","shown":"s.s13","answer":true},{"id":"b3-u08-l7-e04","type":"true_false","item":"s.s06","shown":"s.s06","answer":true},{"id":"b3-u08-l7-e05","type":"listen_pick","item":"s.s20","opts":["s.s04","s.s20","s.s08","s.s25"]},{"id":"b3-u08-l7-e06","type":"listen_pick","item":"s.s03","opts":["s.s19","s.s13","s.s11","s.s03"]},{"id":"b3-u08-l7-e07","type":"word_bank","item":"s.s07","extra":["شكرا","أتمنى"]},{"id":"b3-u08-l7-e08","type":"word_bank","item":"s.s13","extra":["آخر","كبير"]},{"id":"b3-u08-l7-e09","type":"word_bank","item":"s.s18","extra":["إنه","غال"]},{"id":"b3-u08-l7-e10","type":"pick_translation","item":"s.s09","opts":["s.s09","s.s18","s.s07","s.s11"]},{"id":"b3-u08-l7-e11","type":"pick_translation","item":"s.s08","opts":["s.s08","s.s20","s.s05","s.s21"]}]}
