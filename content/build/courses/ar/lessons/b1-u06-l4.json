{"id":"b1-u06-l4","unit":"b1-u06","level":"b1","order":4,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s09":{"k":"s","t":"هل غدا الجمعة؟","g":{"en":"Is tomorrow Friday?","fr":"Est-ce que demain, c'est vendredi ?","es":"¿Mañana es viernes?","ar":"هل غدا الجمعة؟"},"a":"ar/b1-u06/s-s09","tr":"hal ghadan al-jumuʿa?"},"s.s10":{"k":"s","t":"نعم، غدا الجمعة.","g":{"en":"Yes, tomorrow is Friday.","fr":"Oui, demain, c'est vendredi.","es":"Sí, mañana es viernes.","ar":"نعم، غدا الجمعة."},"a":"ar/b1-u06/s-s10","tr":"naʿam, ghadan al-jumuʿa."},"s.s11":{"k":"s","t":"شكرا، إلى اللقاء غدا.","g":{"en":"Thank you, see you tomorrow.","fr":"Merci, à demain.","es":"Gracias, hasta mañana.","ar":"شكرا، إلى اللقاء غدا."},"a":"ar/b1-u06/s-s11","tr":"shukran, ilā al-liqāʾ ghadan."},"s.s06":{"k":"s","t":"صباح الاثنين.","g":{"en":"Monday morning.","fr":"Lundi matin.","es":"Lunes por la mañana.","ar":"صباح الاثنين."},"a":"ar/b1-u06/s-s06","tr":"ṣabāḥ al-ithnayn."},"s.s03":{"k":"s","t":"السبت والأحد.","g":{"en":"Saturday and Sunday.","fr":"Samedi et dimanche.","es":"Sábado y domingo.","ar":"السبت والأحد."},"a":"ar/b1-u06/s-s03","tr":"as-sabt wa-l-aḥad."},"s.s07":{"k":"s","t":"الليل والنهار.","g":{"en":"Night and day.","fr":"La nuit et le jour.","es":"La noche y el día.","ar":"الليل والنهار."},"a":"ar/b1-u06/s-s07","tr":"al-layl wa-n-nahār."},"s.s04":{"k":"s","t":"هل اليوم الخميس؟","g":{"en":"Is today Thursday?","fr":"Est-ce que c'est jeudi aujourd'hui ?","es":"¿Hoy es jueves?","ar":"هل اليوم الخميس؟"},"a":"ar/b1-u06/s-s04","tr":"hal al-yawm al-khamīs?"},"s.s08":{"k":"s","t":"إلى اللقاء غدا!","g":{"en":"See you tomorrow!","fr":"À demain !","es":"¡Hasta mañana!","ar":"إلى اللقاء غدا!"},"a":"ar/b1-u06/s-s08","tr":"ilā al-liqāʾ ghadan!"},"s.s05":{"k":"s","t":"لا، اليوم الأربعاء.","g":{"en":"No, today is Wednesday.","fr":"Non, aujourd'hui, c'est mercredi.","es":"No, hoy es miércoles.","ar":"لا، اليوم الأربعاء."},"a":"ar/b