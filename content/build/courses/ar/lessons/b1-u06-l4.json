{"id":"b1-u06-l4","unit":"b1-u06","level":"b1","order":4,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s09":{"k":"s","t":"هل غدا الجمعة؟","g":{"en":"Is tomorrow Friday?","fr":"Est-ce que demain, c'est vendredi ?","es":"¿Mañana es viernes?","ar":"هل غدا الجمعة؟"},"a":"ar/1c140b416d37","tr":"hal ghadan al-jumuʿa?"},"s.s10":{"k":"s","t":"نعم، غدا الجمعة.","g":{"en":"Yes, tomorrow is Friday.","fr":"Oui, demain, c'est vendredi.","es":"Sí, mañana es viernes.","ar":"نعم، غدا الجمعة."},"a":"ar/2a9d572d6676","tr":"naʿam, ghadan al-jumuʿa."},"s.s11":{"k":"s","t":"شكرا، إلى اللقاء غدا.","g":{"en":"Thank you, see you tomorrow.","fr":"Merci, à demain.","es":"Gracias, hasta mañana.","ar":"شكرا، إلى اللقاء غدا."},"a":"ar/49e2e4667d3a","tr":"shukran, ilā al-liqāʾ ghadan."},"s.s03":{"k":"s","t":"السبت والأحد.","g":{"en":"Saturday and Sunday.","fr":"Samedi et dimanche.","es":"Sábado y domingo.","ar":"السبت والأحد."},"a":"ar/7985594b7f25","tr":"as-sabt wa-l-aḥad."},"s.s07":{"k":"s","t":"الليل والنهار.","g":{"en":"Night and day.","fr":"La nuit et le jour.","es":"La noche y el día.","ar":"الليل والنهار."},"a":"ar/f0c6a825bcc3","tr":"al-layl wa-n-nahār."},"s.s08":{"k":"s","t":"إلى اللقاء غدا!","g":{"en":"See you tomorrow!","fr":"À demain !","es":"¡Hasta mañana!","ar":"إلى اللقاء غدا!"},"a":"ar/15ffccdf013e","tr":"ilā al-liqāʾ ghadan!"},"s.s05":{"k":"s","t":"لا، اليوم الأربعاء.","g":{"en":"No, today is Wednesday.","fr":"Non, aujourd'hui, c'est mercredi.","es":"No, hoy es miércoles.","ar":"لا، اليوم الأربعاء."},"a":"ar/017eb118b878","tr":"lā, al-yawm al-arbiʿāʾ."},"s.n01":{"k":"s","t":"غدا مساء نأكل معا.","g":{"en":"Tomorrow evening we eat together.","fr":"Demain soir, nous mangeons ensemble.","es":"Mañana por la tarde comemos juntos.","ar":"غدا مساء نأكل معا."},"a":"ar/fb3a5d58dcca","tr":"ghadan masāʾ naʾkul maʿan."},"s.s01":{"k":"s","t":"اليوم الاثنين.","g":{"en":"Today is Monday.","fr":"Aujourd'hui, c'est lun