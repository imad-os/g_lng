{"id":"b2-u02-l9","unit":"b2-u02","level":"b2","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s01":{"k":"s","t":"بكم هذا؟","g":{"en":"How much is this?","fr":"C'est combien ?","es":"¿Cuánto cuesta esto?","ar":"بكم هذا؟"},"a":"ar/7cd0155be08d","tr":"bikam hādhā?"},"s.s02":{"k":"s","t":"يكلف عشرين درهما.","g":{"en":"It costs twenty dirhams.","fr":"Ça coûte vingt dirhams.","es":"Cuesta veinte dírhams.","ar":"يكلف عشرين درهما."},"a":"ar/68dc01c6fbea","tr":"yukallif ʿishrīn dirhaman."},"s.s08":{"k":"s","t":"هل تدفع نقدا أم بالبطاقة؟","g":{"en":"Do you pay in cash or by card?","fr":"Vous payez en espèces ou par carte ?","es":"¿Paga en efectivo o con tarjeta?","ar":"هل تدفع نقدا أم بالبطاقة؟"},"a":"ar/1f08725d7caa","tr":"hal tadfaʿ naqdan am bi-l-biṭāqa?"},"s.s09":{"k":"s","t":"أدفع نقدا.","g":{"en":"I pay in cash.","fr":"Je paie en espèces.","es":"Pago en efectivo.","ar":"أدفع نقدا."},"a":"ar/9669b739bcfe","tr":"adfaʿ naqdan."},"s.s10":{"k":"s","t":"تفضل، هذا هو الباقي.","g":{"en":"Here is your change.","fr":"Voici votre monnaie.","es":"Aquí tiene su cambio.","ar":"تفضل، هذا هو الباقي."},"a":"ar/3bba7784ad9a","tr":"tafaḍḍal, hādhā huwa al-bāqī."},"s.s20":{"k":"s","t":"مئة درهم لاثنين سعر جيد.","g":{"en":"A hundred dirhams for two is a good price.","fr":"Cent dirhams pour deux, c'est un bon prix.","es":"Cien dírhams por dos es un buen precio.","ar":"مئة درهم لاثنين سعر جيد."},"a":"ar/908e42fab735","tr":"miʾat dirham li-ithnayn siʿr jayyid."},"s.s16":{"k":"s","t":"أريد أن أشتري هدية لصديقي.","g":{"en":"I want to buy a gift for my friend.","fr":"Je veux acheter un cadeau pour mon ami.","es":"Quiero comprar un regalo para mi amigo.","ar":"أريد أن أشتري هدية لصديقي."},"a":"ar/f7cabf116229","tr":"urīdu an ashtarī hadiyya li-ṣadīqī."},"s.s22":{"k":"s","t":"إنه مجاني للأطفال.","g":{"en":"It is free for children.","fr":"C'est gratuit pour les enfants.","es":"Es gratis para los niños.","ar":"إنه مجاني للأطفال."},"a":"ar/ab74bb4d7be7","tr":"innahu majjānī li-l-aṭfāl."},"s.s21":{"k":"s","t":"الواحد يكلف خمسة عشر يورو.","g":{"en":"Each one costs fifteen euros.","fr":"Chacun coûte quinze euros.","es":"Cada uno cuesta quince euros.","ar":"الواحد يكلف خمسة عشر يورو."},"a":"ar/984a5db5ffa4","tr":"al-wāḥid yukallif khamsat ʿashar yūrū."},"s.s07":{"k":"s","t":"الكتاب يكلف خمسة وأربعين درهما.","g":{"en":"The book costs forty-five dirhams.","fr":"Le livre coûte quarante-cinq dirhams.","es":"El libro cuesta cuarenta y cinco dírhams.","ar":"الكتاب يكلف خمسة وأربعين درهما."},"a":"ar/aa83823cafff","tr":"al-kitāb yukallif khamsa wa-arbaʿīn dirhaman."},"s.s19":{"k":"s","t":"أذهب إلى البنك لأسحب المال.","g":{"en":"I go to the bank to take out money.","fr":"Je vais à la banque pour retirer de l'argent.","es":"Voy al banco a sacar dinero.","ar":"أذهب إلى البنك لأسحب المال."},"a":"ar/f8048c2d733d","tr":"adhhab ilā al-bank li-asḥab al-māl."},"s.s17":{"k":"s","t":"محفظتي فارغة.","g":{"en":"My wallet is empty.","fr":"Mon portefeuille est vide.","es":"Mi cartera está vacía.","ar":"محفظتي فارغة."},"a":"ar/cd93899831ba","tr":"miḥfaẓatī fārigha."},"s.s24":{"k":"s","t":"الهاتف يكلف ثمانين يورو لكن معي ستون فقط.","g":{"en":"The phone costs eighty euros, but I only have sixty.","fr":"Le téléphone coûte quatre-vingts euros, mais je n'ai que soixante.","es":"El teléfono cuesta ochenta euros, pero solo tengo sesenta.","ar":"الهاتف يكلف ثمانين يورو لكن معي ستون فقط."},"a":"ar/a40325069150","tr":"al-hātif yukallif thamānīn yūrū lākin maʿī sittūn faqaṭ."},"s.s26":{"k":"s","t":"كم من المال تحتاج؟","g":{"en":"How much money do you need?","fr":"De combien d'argent as-tu besoin ?","es":"¿Cuánto dinero necesitas?","ar":"كم من المال تحتاج؟"},"a":"ar/073bd938bf38","tr":"kam min al-māl taḥtāj?"},"s.s06":{"k":"s","t":"معي ثلاثون يورو.","g":{"en":"I have thirty euros.","fr":"J'ai trente euros.","es":"Tengo treinta euros.","ar":"معي ثلاثون يورو."},"a":"ar/9edac55f65aa","tr":"maʿī thalāthūn yūrū."},"s.s1