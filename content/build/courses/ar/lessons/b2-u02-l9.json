{"id":"b2-u02-l9","unit":"b2-u02","level":"b2","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s01":{"k":"s","t":"بكم هذا؟","g":{"en":"How much is this?","fr":"C'est combien ?","es":"¿Cuánto cuesta esto?","ar":"بكم هذا؟"},"a":"ar/7cd0155be08d","tr":"bikam hādhā?"},"s.s02":{"k":"s","t":"يكلف عشرين درهما.","g":{"en":"It costs twenty dirhams.","fr":"Ça coûte vingt dirhams.","es":"Cuesta veinte dírhams.","ar":"يكلف عشرين درهما."},"a":"ar/68dc01c6fbea","tr":"yukallif ʿishrīn dirhaman."},"s.s08":{"k":"s","t":"هل تدفع نقدا أم بالبطاقة؟","g":{"en":"Do you pay in cash or by card?","fr":"Vous payez en espèces ou par carte ?","es":"¿Paga en efectivo o con tarjeta?","ar":"هل تدفع نقدا أم بالبطاقة؟"},"a":"ar/1f08725d7caa","tr":"hal tadfaʿ naqdan am bi-l-biṭāqa?"},"s.s09":{"k":"s","t":"أدفع نقدا.","g":{"en":"I pay in cash.","fr":"Je paie en espèces.","es":"Pago en efectivo.","ar":"أدفع نقدا."},"a":"ar/9669b739bcfe","tr":"adfaʿ naqdan."},"s.s10":{"k":"s","t":"تفضل، هذا هو الباقي.","g":{"en":"Here is your change.","fr":"Voici votre monnaie.","es":"Aquí tiene su cambio.","ar":"تفضل، هذا هو الباقي."},"a":"ar/3bba7784ad9a","tr":"tafaḍḍal, hādhā huwa al-bāqī."},"s.s22":{"k":"s","t":"إنه مجاني للأطفال.","g":{"en":"It is free for children.","fr":"C'est gratuit pour les enfants.","es":"Es gratis para los niños.","ar":"إنه مجاني للأطفال."},"a":"ar/ab74bb4d7be7","tr":"innahu majjānī li-l-aṭfāl."},"s.s28":{"k":"s","t":"ثمانون، تسعون، مئة: أستطيع الآن أن أعد حتى المئة!","g":{"en":"Eighty, ninety, a hundred: now I can count to a hundred!","fr":"Quatre-vingts, quatre-vingt-dix, cent : je sais compter jusqu'à cent !","es":"Ochenta, noventa, cien: ¡ya sé contar hasta cien!","ar":"ثمانون، تسعون، مئة: أستطيع الآن أن أعد حتى المئة!"},"a":"ar/0a244da97a0c","tr":"thamānūn, tisʿūn, miʾa: astaṭīʿ al-ān an aʿudda ḥattā al-miʾa!"},"s.n01":{"k":"s","t":"عندي أحد عشر يورو.","g":{"en":"I have eleven euros.","fr":"J'ai onze euros.","es":"Tengo once euros.","ar":"عندي أحد عشر يورو."},"a":"ar/31812427b2d2","tr":"ʿindī aḥad ʿashar yūrū."},"s.s07":{"k":"s","t":"الكتاب يكلف خمسة وأربعين درهما.","g":{"en":"The book costs forty-five dirhams.","fr":"Le livre coûte quarante-cinq dirhams.","es":"El libro cuesta cuarenta y cinco dírhams.","ar":"الكتاب يكلف خمسة وأربعين درهما."},"a":"ar/aa83823cafff","tr":"al-kitāb yukallif khamsa wa-arbaʿīn dirhaman."},"s.s25":{"k":"s","t":"هل يمكنني أن أدفع النصف الآن والنصف غدا؟","g":{"en":"Can I pay half now and half tomorrow?","fr":"Je peux payer la moitié maintenant et la moitié demain ?","es":"¿Puedo pagar la mitad ahora y la mitad mañana?","ar":"هل يمكنني أن أدفع النصف الآن والنصف غدا؟"},"a":"ar/fde087cea677","tr":"hal yumkinunī an adfaʿa an-niṣf al-ān wa-an-niṣf ghadan?"},"s.s14":{"k":"s","t":"كل شيء اليوم بنصف الثمن.","g":{"en":"Everything is half price today.","fr":"Tout est à moitié prix aujourd'hui.","es":"Hoy todo está a mitad de precio.","ar":"كل شيء اليوم بنصف الثمن."},"a":"ar/28e4ab68c5cf","tr":"kull shayʾ al-yawm bi-niṣf ath-thaman."},"s.s16":{"k":"s","t":"أريد أن أشتري هدية لصديقي.","g":{"en":"I want to buy a gift for my friend.","fr":"Je veux acheter un cadeau pour mon ami.","es":"Quiero comprar un regalo para mi amigo.","ar":"أريد أن أشتري هدية لصديقي."},"a":"ar/f7cabf116229","tr":"urīdu an ashtarī hadiyya li-ṣadīqī."},"s.s17":{"k":"s","t":"محفظتي فارغة.","g":{"en":"My wallet is empty.","fr":"Mon portefeuille est vide.","es":"Mi cartera está vacía.","ar":"محفظتي فارغة."},"a":"ar/cd93899831ba","tr":"miḥfaẓatī fārigha."},"s.s11":{"k":"s","t":"أريد إيصالا من فضلك.","g":{"en":"Can I have a receipt, please?","fr":"Je peux avoir un reçu, s'il vous plaît ?","es":"¿Me da un recibo, por favor?","ar":"أريد إيصالا من فضلك."},"a":"ar/b35abf9d0ba6","tr":"urīdu īṣālan min faḍlik."},"s.s18":{"k":"s","t":"ليس معي مال اليوم.","g":{"en":"I have no money today.","fr":"Je n'ai pas d'argent aujourd'hui.","es":"Hoy no tengo dinero.","ar":"ليس معي مال اليوم."},"a":