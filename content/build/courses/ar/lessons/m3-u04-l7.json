les están notablemente más limpias.","ar":"منعت المدينة الأكياس البلاستيكية، فأصبحت الشوارع أنظف بشكل ملحوظ."},"a":"ar/m3-u04/s-s27","tr":"manaʿat al-madīna al-akyās al-blāstīkiyya, fa-aṣbaḥat ash-shawāriʿ anẓaf bi-shakl malḥūẓ."}},"ex":[{"id":"m3-u04-l7-e01","type":"pick_translation","item":"w.disappear_verb","opts":["w.cause","w.disappear_verb","w.emission","w.rise"]},{"id":"m3-u04-l7-e02","type":"pick_translation","item":"w.sustainable","opts":["w.flood","w.global","w.urgent","w.sustainable"]},{"id":"m3-u04-l7-e03","type":"pick_translation","item":"w.renewable","opts":["w.species","w.rise","w.renewable","w.drought"]},{"id":"m3-u04-l7-e04","type":"pick_translation","item":"w.harmful","opts":["w.renewable","w.harmful","w.flood","w.environment"]},{"id":"m3-u04-l7-e05","type":"pick_translation","item":"w.endangered","opts":["w.due_to","w.damage","w.species","w.endangered"]},{"id":"m3-u04-l7-e06","type":"pick_translation","item":"w.urgent","opts":["w.urgent","w.solar_panel","w.sustainable","w.fossil_fuel"]},{"id":"m3-u04-l7-e07","type":"listen_pick","item":"w.sustainable","opts":["w.ocean","w.flood","w.sustainable","w.disappear_verb"]},{"id":"m3-u04-l7-e08","type":"listen_pick","item":"w.urgent","opts":["w.lead_to","w.urgent","w.protect","w.emission"]},{"id":"m3-u04-l7-e09","type":"listen_pick","item":"w.disappear_verb","opts":["w.disappear_verb","w.glacier","w.sustainable","w.damage"]},{"id":"m3-u04-l7-e10","type":"match_pairs","items":["w.harmful","w.sustainable","w.endangered","w.disappear_verb","w.renewable"]},{"id":"m3-u04-l7-e11","type":"pick_target","item":"w.sustainable","opts":["w.sustainable","w.global","w.fossil_fuel","w.melt"]},{"id":"m3-u04-l7-e12","type":"pick_target","item":"w.disappear_verb","opts":["w.flood","w.melt","w.disappear_verb","w.therefore"]},{"id":"m3-u04-l7-e13","type":"pick_target","item":"w.harmful","opts":["w.recycle","w.effect","w.harmful","w.because_of"]},{"id":"m3-u04-l7-e14","type":"word_bank","item":"s.s25","extra":["يرتفع","مستوى"]