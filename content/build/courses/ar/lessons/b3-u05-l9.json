{"id":"b3-u05-l9","unit":"b3-u05","level":"b3","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s11":{"k":"s","t":"ماذا فعلت أمس؟","g":{"en":"What did you do yesterday?","fr":"Qu'as-tu fait hier ?","es":"¿Qué hiciste ayer?","ar":"ماذا فعلت أمس؟"},"a":"ar/ae9e4ef3bf25","tr":"mādhā faʿalta ams?"},"s.s01":{"k":"s","t":"ذهبت أمس إلى السوق.","g":{"en":"Yesterday I went to the market.","fr":"Hier, je suis allé au marché.","es":"Ayer fui al mercado.","ar":"ذهبت أمس إلى السوق."},"a":"ar/e9031f42a6b3","tr":"dhahabtu ams ilā as-sūq."},"s.s04":{"k":"s","t":"رأيت أصدقائي هذا الصباح.","g":{"en":"I saw my friends this morning.","fr":"J'ai vu mes amis ce matin.","es":"Vi a mis amigos esta mañana.","ar":"رأيت أصدقائي هذا الصباح."},"a":"ar/57394f79053b","tr":"raʾaytu aṣdiqāʾī hādhā aṣ-ṣabāḥ."},"s.s20":{"k":"s","t":"غادروا البيت مبكرا.","g":{"en":"They left the house early.","fr":"Ils sont sortis de la maison tôt.","es":"Salieron de casa temprano.","ar":"غادروا البيت مبكرا."},"a":"ar/21efb044b369","tr":"ghādarū al-bayt mubakkiran."},"s.s19":{"k":"s","t":"وصل القطار متأخرا.","g":{"en":"The train arrived late.","fr":"Le train est arrivé en retard.","es":"El tren llegó tarde.","ar":"وصل القطار متأخرا."},"a":"ar/db26f35ed5e4","tr":"waṣala al-qiṭār mutaʾakhkhiran."},"s.s15":{"k":"s","t":"شاهدنا فيلما على التلفاز.","g":{"en":"We watched a film on TV.","fr":"Nous avons regardé un film à la télé.","es":"Miramos una película en la tele.","ar":"شاهدنا فيلما على التلفاز."},"a":"ar/65063f3d38b9","tr":"shāhadnā filman ʿalā at-tilfāz."},"s.s16":{"k":"s","t":"نظفت المطبخ وطبخت العشاء.","g":{"en":"I cleaned the kitchen and cooked dinner.","fr":"J'ai nettoyé la cuisine et préparé le dîner.","es":"Limpié la cocina y cociné la cena.","ar":"نظفت المطبخ وطبخت العشاء."},"a":"ar/2f77b9347bf7","tr":"naẓẓaftu al-maṭbakh wa-ṭabakhtu al-ʿashāʾ."},"s.s08":{"k":"s","t":"نام أخي حتى الساعة العاشرة.","g":{"en":"My brother slept u