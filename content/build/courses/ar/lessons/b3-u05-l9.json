{"id":"b3-u05-l9","unit":"b3-u05","level":"b3","order":9,"type":"story","title":{"en":"Conversation","fr":"Conversation","es":"Conversación","ar":"محادثة"},"newWords":[],"vocab":{"s.s11":{"k":"s","t":"ماذا فعلت أمس؟","g":{"en":"What did you do yesterday?","fr":"Qu'as-tu fait hier ?","es":"¿Qué hiciste ayer?","ar":"ماذا فعلت أمس؟"},"a":"ar/ae9e4ef3bf25","tr":"mādhā faʿalta ams?"},"s.s01":{"k":"s","t":"ذهبت أمس إلى السوق.","g":{"en":"Yesterday I went to the market.","fr":"Hier, je suis allé au marché.","es":"Ayer fui al mercado.","ar":"ذهبت أمس إلى السوق."},"a":"ar/e9031f42a6b3","tr":"dhahabtu ams ilā as-sūq."},"s.s04":{"k":"s","t":"رأيت أصدقائي هذا الصباح.","g":{"en":"I saw my friends this morning.","fr":"J'ai vu mes amis ce matin.","es":"Vi a mis amigos esta mañana.","ar":"رأيت أصدقائي هذا الصباح."},"a":"ar/57394f79053b","tr":"raʾaytu aṣdiqāʾī hādhā aṣ-ṣabāḥ."},"s.s14":{"k":"s","t":"كنت في البيت ليلة أمس.","g":{"en":"I was at home last night.","fr":"J'étais à la maison hier soir.","es":"Estaba en casa anoche.","ar":"كنت في البيت ليلة أمس."},"a":"ar/d514464043c1","tr":"kuntu fī al-bayt laylat ams."},"s.s15":{"k":"s","t":"شاهدنا فيلما على التلفاز.","g":{"en":"We watched a film on TV.","fr":"Nous avons regardé un film à la télé.","es":"Miramos una película en la tele.","ar":"شاهدنا فيلما على التلفاز."},"a":"ar/65063f3d38b9","tr":"shāhadnā filman ʿalā at-tilfāz."},"s.s02":{"k":"s","t":"هي أكلت السمك ليلة أمس.","g":{"en":"She ate fish last night.","fr":"Elle a mangé du poisson hier soir.","es":"Anoche ella comió pescado.","ar":"هي أكلت السمك ليلة أمس."},"a":"ar/e9104d343cdc","tr":"hiya akalat as-samak laylat ams."},"s.s10":{"k":"s","t":"قالت وداعا وغادرت.","g":{"en":"She said goodbye and left.","fr":"Elle a dit au revoir et elle est partie.","es":"Dijo adiós y salió.","ar":"قالت وداعا وغادرت."},"a":"ar/c6ece21d51c5","tr":"qālat wadāʿan wa-ghādarat."},"s.s24":{"k":"s","t":"قضينا عطلة رائعة.","g":{"en":"We had a great holiday.","fr":"Nous avons passé de très bonnes vacance