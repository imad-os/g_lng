rules_version = '2';
// Dualingo: Firestore holds read-only course content (anyone may read, no client may write) plus the weekly league.
// Content is written only by tools/seed-firestore.mjs with a service account (which bypasses these rules).
// Learner progress is never stored here: it goes through MyPC.save.
service cloud.firestore {
  match /databases/{database}/documents {
    match /meta/{doc} { allow read: if true; allow write: if false; }
    match /courses/{path=**} { allow read: if true; allow write: if false; }
    // Weekly league: everyone may read; a player may only create/update their own document (id = their install id),
    // with a short name and an XP that never goes down and cannot jump by more than 1500 per write.
    match /league/{week}/players/{pid} {
      allow read: if true;
      allow create: if pid.matches('[a-z0-9]{16,32}') && week.matches('w[0-9]{1,5}')
        && request.resource.data.keys().hasOnly(['name', 'xp'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 1500;
      allow update: if request.resource.data.keys().hasOnly(['name', 'xp'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.xp is int && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp <= resource.data.xp + 1500 && request.resource.data.xp <= 20000;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
